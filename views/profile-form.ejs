<%- include('partials/header') %>
<form method="post" action="/profile">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<div class="card"><h2>🏢 Identitas SPPG</h2><p class="sub">Data identitas utama yang digunakan di seluruh aplikasi.</p><div class="form-grid">
<div class="field"><label>Nama SPPG</label><input class="input" name="name" value="<%= profile.name||'' %>" placeholder="Nama resmi SPPG"></div>
<div class="field"><label>ID SPPG</label><input class="input" name="sppg_id" value="<%= profile.sppg_id||'' %>"></div>
<div class="field full"><label>Alamat SPPG</label><textarea class="textarea" name="address"><%= profile.address||'' %></textarea></div>
<div class="field"><label>Status</label><select class="select" name="status"><option value="OPERASIONAL" <%= profile.status==='OPERASIONAL'?'selected':'' %>>Operasional</option><option value="NONOPERASIONAL" <%= profile.status==='NONOPERASIONAL'?'selected':'' %>>Nonoperasional</option></select></div>
<div class="field"><label>Nama Bank</label><input class="input" name="bank_name" value="<%= profile.bank_name||'' %>"></div><div class="field"><label>No. VA</label><input class="input" name="va_number" value="<%= profile.va_number||'' %>"></div><div class="field"><label>Nama VA</label><input class="input" name="va_name" value="<%= profile.va_name||'' %>"></div>
</div></div>
<div class="card" style="margin-top:16px"><h2>🏛️ Yayasan</h2><div class="form-grid">
<div class="field"><label>Nama Yayasan</label><input class="input" name="foundation_name" value="<%= profile.foundation_name||'' %>"></div><div class="field"><label>ID Yayasan</label><input class="input" name="foundation_id" value="<%= profile.foundation_id||'' %>"></div>
<div class="field full"><label>Alamat Yayasan</label><textarea class="textarea" name="foundation_address"><%= profile.foundation_address||'' %></textarea></div>
<div class="field"><label>Ketua Yayasan — Nama Lengkap</label><input class="input" name="foundation_chair_name" value="<%= profile.foundation_chair_name||'' %>"></div><div class="field"><label>Ketua Yayasan — NIK</label><input class="input" name="foundation_chair_nik" value="<%= profile.foundation_chair_nik||'' %>"></div><div class="field"><label>Ketua Yayasan — HP/WhatsApp</label><input class="input" name="foundation_chair_phone" value="<%= profile.foundation_chair_phone||'' %>"></div>
<div class="field"><label>Perwakilan Yayasan — Nama Lengkap</label><input class="input" name="foundation_rep_name" value="<%= profile.foundation_rep_name||'' %>"></div><div class="field"><label>Perwakilan Yayasan — NIK</label><input class="input" name="foundation_rep_nik" value="<%= profile.foundation_rep_nik||'' %>"></div><div class="field"><label>Perwakilan Yayasan — HP/WhatsApp</label><input class="input" name="foundation_rep_phone" value="<%= profile.foundation_rep_phone||'' %>"></div>
</div></div>
<div class="card" style="margin-top:16px"><h2>👤 Kepala SPPG</h2><p class="sub">Data penanggung jawab SPPG.</p><div class="form-grid">
<div class="field"><label>Nama KaSPPG</label><input class="input" name="kasp_name" value="<%= profile.kasp_name||'' %>"></div><div class="field"><label>NIK</label><input class="input" name="kasp_nik" value="<%= profile.kasp_nik||'' %>"></div><div class="field"><label>NIP</label><input class="input" name="kasp_nip" value="<%= profile.kasp_nip||'' %>"></div><div class="field"><label>No. HP/WhatsApp</label><input class="input" name="kasp_phone" value="<%= profile.kasp_phone||'' %>"></div>
<div class="field"><label>SKEP Penempatan — Nomor</label><input class="input" name="kasp_skep_number" value="<%= profile.kasp_skep_number||'' %>"></div><div class="field"><label>SKEP Penempatan — Tanggal</label><input class="input" type="date" name="kasp_skep_date" value="<%= profile.kasp_skep_date?new Date(profile.kasp_skep_date).toISOString().slice(0,10):'' %>"></div>
<div class="field"><label>Latitude</label><input id="profile-lat" class="input" name="latitude" value="<%= profile.latitude||'' %>" placeholder="-6.xxxxxxx"></div><div class="field"><label>Longitude</label><input id="profile-lng" class="input" name="longitude" value="<%= profile.longitude||'' %>" placeholder="107.xxxxxxx"></div>
<div class="field full"><label>Lokasi SPPG</label><div id="profile-map" class="map-picker" data-lat-input="profile-lat" data-lng-input="profile-lng" data-link-id="profile-map-link" data-locate-id="profile-map-locate"></div><div class="map-actions"><button type="button" class="btn gray" id="profile-map-locate"><i data-lucide="crosshair"></i> Gunakan lokasi perangkat</button><a id="profile-map-link" class="btn secondary" href="#" target="_blank" rel="noopener"><i data-lucide="map"></i> Buka Google Maps</a></div><div class="map-help">Klik peta untuk menentukan titik. Marker dapat digeser. Koordinat akan terisi otomatis.</div></div>
</div></div><button class="btn" style="margin-top:16px">💾 Simpan Profil</button></form>
<div class="card" style="margin-top:16px"><h2>📄 Dokumen Profil</h2><p class="sub">Dokumen disimpan di area upload internal dan hanya dapat diakses pengguna yang sudah login.</p><div class="form-grid">
<div class="field"><label>BA Verval</label><% if(profile.ba_verval_path){ %><div class="help"><a href="/profile/document/BA_VERVAL" target="_blank" rel="noopener"><%= profile.ba_verval_name || 'Lihat dokumen' %></a></div><% } %><form method="post" action="/profile/document" enctype="multipart/form-data" style="margin-top:8px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="doc_type" value="BA_VERVAL"><input type="file" name="file" accept="image/jpeg,image/png,application/pdf" required class="input"><button class="btn secondary" style="margin-top:8px">Upload BA Verval</button></form></div>
<div class="field"><label>SKEP Penempatan</label><% if(profile.kasp_skep_path){ %><div class="help"><a href="/profile/document/SKEP" target="_blank" rel="noopener"><%= profile.kasp_skep_name || 'Lihat dokumen' %></a></div><% } %><form method="post" action="/profile/document" enctype="multipart/form-data" style="margin-top:8px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="doc_type" value="SKEP"><input type="file" name="file" accept="image/jpeg,image/png,application/pdf" required class="input"><button class="btn secondary" style="margin-top:8px">Upload SKEP</button></form></div>
</div></div><%- include('partials/footer') %>