  </div>

  <!-- Modal 4: Koreksi Identitas -->
  <div id="modalCorrectionPm" class="pm-modal-backdrop" role="dialog" aria-modal="true">
    <div class="pm-modal-card">
      <div class="pm-modal-head">
        <div class="pm-modal-icon-wrap" style="background:#f5f3ff;color:#6d28d9">✏️</div>
        <div>
          <h3 style="margin:0;font-size:16px">Koreksi Data Identitas</h3>
          <p style="margin:3px 0 0;font-size:12.5px;color:#64748b">Pilih nama penerima yang datanya ingin diperbaiki.</p>
        </div>
        <button type="button" class="pm-modal-close" onclick="closeModal('modalCorrectionPm')">&times;</button>
      </div>
      <div class="pm-modal-body">
        <div class="pm-form-field">
          <label>Cari Nama / NIK yang Ingin Dikoreksi</label>
