<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Perbaikan Data KPM · SPPG Monitoring</title><link rel="stylesheet" href="/public/style.css?v=1.8.36.4"><style>.wrap{max-width:1200px;margin:0 auto;padding:28px 16px}.card{background:#fff;border:1px solid #dfe7ee;border-radius:16px;padding:20px;margin-top:16px;box-shadow:0 8px 28px rgba(15,35,55,.06)}.table-wrap{overflow:auto}.table{width:100%;border-collapse:collapse}.table th,.table td{padding:11px;border-bottom:1px solid #edf1f5;text-align:left;vertical-align:top}.actions{display:flex;gap:8px;flex-wrap:wrap}.actions form{display:flex;gap:8px;align-items:flex-start}.input{min-width:220px}.badge{display:inline-block;padding:5px 9px;border-radius:999px;background:#eef3f7;font-size:12px;font-weight:700}</style></head><body><main class="wrap"><div class="page-head"><div><div class="eyebrow">KPM PORTAL</div><h1>Perbaikan Data KPM</h1><p class="sub">Pengajuan perubahan identitas KPM yang dikirim melalui Dashboard KPM.</p></div><a class="outline-btn" href="/kpm/portal-dashboard">Kembali</a></div><div class="card"><div class="table-wrap"><table class="table"><thead><tr><th>KPM</th><th>Jenis</th><th>Status</th><th>Diajukan</th><th>Catatan</th><th>Aksi</th></tr></thead><tbody><% rows.forEach(r=>{ %><tr><td><strong><%= r.kpm_name %></strong><br><small><%= r.kpm_code %></small></td><td><%= r.kpm_type==='POSYANDU'?'Posyandu':'Satuan Pendidikan' %></td><td><span class="badge"><%= r.status %></span></td><td><%= r.submitted_at %></td><td><%= r.review_note||'-' %></td><td><div class="actions"><% if(['DIAJUKAN','DITINJAU'].includes(r.status)){ %><form method="post" action="/kpm/portal-profile-submissions/<%= r.id %>/review"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input class="input" name="note" placeholder="Catatan review"><button class="primary-btn" name="decision" value="DISETUJUI">Setujui</button><button class="outline-btn" name="decision" value="DITOLAK">Tolak</button></form><% } %><% if(r.status==='DISETUJUI'){ %><form method="post" action="/kpm/portal-profile-submissions/<%= r.id %>/apply"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="primary-btn" type="submit">Terapkan ke Master KPM</button></form><% } %></div></td></tr><% }) %><% if(!rows.length){ %><tr><td colspan="6" class="empty">Belum ada pengajuan perbaikan data KPM.</td></tr><% } %></tbody></table></div></div></main></body></html>
