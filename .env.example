NODE_ENV=production
PORT=3000
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_64_CHARACTERS
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD
DB_NAME=YOUR_DB_NAME
# IMPORTANT: persistent storage must be OUTSIDE the application/release folder.
# Example for Hostinger:
# DATA_DIR=/home/USERNAME/sppg-monitoring-data
DATA_DIR=/home/USERNAME/sppg-monitoring-data
# Relative UPLOAD_DIR is resolved inside DATA_DIR.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
