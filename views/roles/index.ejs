<%- include('../partials/header') %>
<section class="module-hero panel"><div><span class="panel-kicker">SISTEM · AKSES</span><h2>Role & Pengguna</h2><p>Kelola akun pengguna dan matriks permission. Perubahan akses dicatat pada Aktivitas Sistem.</p></div><a class="primary-btn" href="/roles/new"><i data-lucide="user-plus"></i>Tambah Pengguna</a></section>
<section class="panel"><div class="panel-head"><div><span class="panel-kicker">PENGGUNA</span><h3>Akun Sistem</h3></div></div><div class="table-wrap"><table class="table"><tr><th>Nama</th><th>Username</th><th>Role</th><th>Email</th><th>Dibuat</th><th>Aksi</th></tr><% users.forEach(u=>{ %><tr><td><strong><%= u.name %></strong></td><td><%= u.username %></td><td><span class="badge <%= u.role==='ADMIN'?'green':'yellow' %>"><%= u.role %></span></td><td><%= u.email||'-' %></td><td><%= u.created_at?new Date(u.created_at).toLocaleString('id-ID'): '-' %></td><td><details class="role-edit"><summary class="mini-action">Edit</summary><form method="post" action="/roles/user/<%= u.id %>" class="role-edit-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Nama<input class="input" name="name" value="<%= u.name %>" required></label><label>Username<input class="input" name="username" value="<%= u.username %>" required></label><label>Email<input class="input" type="email" name="email" value="<%= u.email||'' %>"></label><label>Role<select class="select" name="role"><% roles.forEach(r=>{ %><option value="<%= r %>" <%= u.role===r?'selected':'' %>><%= r %></option><% }) %></select></label><label>Password Baru <small>(kosongkan jika tidak diubah)</small><input class="input" type="password" name="password" minlength="12" autocomplete="new-password"></label><button class="btn">Simpan Perubahan</button></form></details></td></tr><% }) %></table></div></section>
<section class="panel"><div class="panel-head"><div><span class="panel-kicker">IDENTITAS KERJA</span><h3>Hubungkan Akun dengan Data Staf</h3><p class="muted">Satu akun dapat dikaitkan dengan satu data staf untuk menjaga identitas audit tetap jelas.</p></div></div><div class="table-wrap"><table class="table"><tr><th>Pengguna</th><th>Role</th><th>Data Staf</th><th>Status</th><th>Aksi</th></tr><% users.forEach(u=>{ %><tr><td><strong><%= u.name %></strong></td><td><span class="badge yellow"><%= u.role %></span></td><td><%= u.staff_name||'Belum dikaitkan' %></td><td><%= u.staff_id?'Terhubung':'Belum' %></td><td><form method="post" action="/roles/user/<%= u.id %>/staff" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select class="select" name="staff_id"><option value="">— Tidak dikaitkan —</option><% staffRows.forEach(st=>{ %><option value="<%= st.id %>" <%= Number(u.staff_id)===Number(st.id)?'selected':'' %>><%= st.name %> — <%= st.position %></option><% }) %></select><button class="outline-btn small">Simpan</button></form></td></tr><% }) %></table></div></section>
<section class="panel"><div class="panel-head"><div><span class="panel-kicker">TIM OPERASIONAL</span><h3>Keanggotaan Tim</h3><p class="muted">Satu role/tim dapat memiliki banyak pengguna. Role menentukan hak akses; keanggotaan tim menentukan siapa yang masuk ke kelompok kerja.</p></div></div><div class="table-wrap"><table class="table"><tr><th>Tim</th><th>Anggota Aktif</th><th>Tambah Anggota</th></tr><% teams.filter(t=>operationalTeams.includes(t.team_code)).forEach(t=>{ const members=teamMembers.filter(m=>Number(m.team_id)===Number(t.id)&&Number(m.is_active)===1); %><tr><td><strong><%= t.team_name %></strong><br><span class="badge yellow"><%= t.team_code %></span></td><td><% if(!members.length){ %><span class="muted">Belum ada anggota</span><% } else { members.forEach(m=>{ %><div class="team-member-row"><span><%= m.user_name %></span><form method="post" action="/roles/team-member/<%= m.id %>/remove" style="display:inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="mini-action" title="Keluarkan dari tim">Keluarkan</button></form></div><% }) } %></td><td><form method="post" action="/roles/user/0/team" onsubmit="this.action='/roles/user/'+this.user_id.value+'/team'" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select class="select" name="user_id" required><option value="">Pilih pengguna</option><% users.filter(u=>u.role===t.team_code).forEach(u=>{ %><option value="<%= u.id %>"><%= u.name %></option><% }) %></select><input type="hidden" name="team_id" value="<%= t.id %>"><button class="btn small">Tambah</button></form></td></tr><% }) %></table></div></section>
<section class="panel"><div class="panel-head"><div><span class="panel-kicker">MATRIX PERMISSION</span><h3>Hak Akses per Role</h3><p class="muted">ADMIN selalu memiliki seluruh permission. Untuk role lain, centang hanya kemampuan yang memang dibutuhkan.</p></div></div><div class="permission-matrix"><% roles.filter(r=>r!=='ADMIN').forEach(role=>{ %><form method="post" action="/roles/permissions" class="permission-card"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="role" value="<%= role %>"><div class="permission-head"><div><span class="badge yellow"><%= role %></span><strong>Hak akses <%= role %></strong></div><button class="outline-btn small">Simpan</button></div><div class="permission-grid"><% permissions.forEach(p=>{ %><label class="permission-item"><input type="checkbox" name="permissions" value="<%= p.permission_key %>" <%= matrix[role]?.has(Number(p.id))?'checked':'' %>><span><b><%= p.permission_key %></b><small><%= p.label %></small></span></label><% }) %></div></form><% }) %><div class="permission-admin-note"><i data-lucide="shield-check"></i><div><strong>ADMIN</strong><span>Memiliki seluruh permission dan digunakan untuk pengelolaan sistem tingkat penuh.</span></div></div></div></section>
<%- include('../partials/footer') %>
