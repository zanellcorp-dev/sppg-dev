                <option value="BUMIL">🤰 Bumil (Ibu Hamil)</option>
                <option value="BALITA">👶 Balita</option>
              </select>
            </div>
          </div>

          <div class="pm-form-field">
            <label>Sub-Kelompok Baru</label>
            <select id="catchange_target_subgroup" class="pm-modal-select">
              <option value="Bayi 0–6 Bulan (ASI Eksklusif)">Bayi 0–6 Bulan (ASI Eksklusif)</option>
              <option value="Bayi 7–12 Bulan">Bayi 7–12 Bulan</option>
              <option value="Bayi 13–24 Bulan">Bayi 13–24 Bulan</option>
            </select>
          </div>

          <div class="pm-form-field">
            <label>Alasan Perubahan Status <span style="color:#d92d20">*</span></label>
            <input type="text" id="catchange_reason" class="pm-modal-input" placeholder="Contoh: Ibu telah melahirkan dan memasuki masa menyusui" value="Ibu telah melahirkan dan memasuki masa menyusui" required>
          </div>

          <div class="pm-form-field">
            <label>Tanggal Efektif Alih Status <span style="color:#d92d20">*</span></label>
            <input type="date" id="catchange_effective" class="pm-modal-input" value="<%= new Date().toISOString().slice(0,10) %>" required>
          </div>
        </div>
      </div>
      <div class="pm-modal-foot">
        <button type="button" class="btn secondary" onclick="closeModal('modalCategoryChange')">Batal</button>
        <button type="submit" class="btn primary" id="btnSubmitCatChange" disabled>🔄 Tambahkan Alih Kategori</button>
      </div>
    </form>
  </div>
</div>

