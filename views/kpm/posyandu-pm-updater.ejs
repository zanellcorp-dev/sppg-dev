    <div class="pm-modal-foot" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px">
      <% if(previewMode){ %>
        <div id="detailExecutiveActions" style="display:none;align-items:center;gap:8px">
          <button type="button" class="btn success" id="btnDetailApprove" style="background:#059669;color:#fff;border:0;padding:7px 14px;font-size:12px;font-weight:700">
            ✅ Sahkan & Setujui
          </button>
          <button type="button" class="btn danger" id="btnDetailReject" style="background:#dc2626;color:#fff;border:0;padding:7px 14px;font-size:12px;font-weight:700">
            ⚠️ Minta Revisi
          </button>
        </div>
      <% } else { %>
        <div></div>
      <% } %>
      <button type="button" class="btn secondary" onclick="closeModal('modalPackageDetail')">Tutup</button>
    </div>
  </div>
</div>

<!-- ============================================================== -->
<!-- CSS SCOPED PM PACKAGE SECTION & MODALS                         -->
<!-- ============================================================== -->
<style>
.pm-package-section{margin-top:24px;border:1px solid #dbe5ee;box-shadow:0 6px 24px rgba(15,35,55,.05);border-radius:18px;background:#fff;overflow:hidden}
.pm-package-head{padding:20px 24px;border-bottom:1px solid #edf2f7;background:#fff}
.pm-package-eyebrow{display:flex;align-items:center;gap:8px;margin-bottom:4px;flex-wrap:wrap}
.pm-package-badge-tag{font-size:10.5px;font-weight:800;letter-spacing:.07em;color:#007a5e;text-transform:uppercase}
.pm-package-kpm-badge{display:inline-block;padding:2px 8px;border-radius:6px;background:#f1f5f9;color:#334155;font-size:11px;font-weight:700}

/* 4 Status Cards Grid */
.pm-status-cards-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;padding:16px 24px;background:#f8fafc;border-bottom:1px solid #edf2f7}
.pm-status-card{background:#fff;border:1px solid #e2e8f0;border-radius:14px;padding:14px 16px;display:flex;align-items:center;gap:12px;transition:all .15s ease}
.pm-status-card:hover{transform:translateY(-2px);box-shadow:0 6px 16px rgba(15,35,55,.06);border-color:#cbd5e1}
.pm-status-card-icon{width:40px;height:40px;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.pm-status-card-icon.draft{background:#f1f5f9;color:#475569}
.pm-status-card-icon.pending{background:#fffbeb;color:#b45309}
.pm-status-card-icon.revision{background:#fef2f2;color:#b91c1c}
.pm-status-card-icon.completed{background:#ecfdf5;color:#047857}
.pm-status-card-num{display:block;font-size:22px;color:#0f243d;line-height:1}
.pm-status-card-label{display:block;font-size:12.5px;font-weight:700;color:#334155;margin-top:3px}
.pm-status-card-sub{display:block;font-size:11px;color:#64748b}

/* Tab Switcher Bar */
.pm-package-tabs-bar{display:flex;align-items:center;gap:6px;padding:12px 24px 0;background:#fff;border-bottom:1px solid #e2e8f0}
.pm-pkg-tab-btn{display:inline-flex;align-items:center;gap:8px;padding:10px 18px;border:0;border-bottom:2px solid transparent;background:transparent;color:#64748b;font-size:13px;font-weight:700;cursor:pointer;transition:.15s}
.pm-pkg-tab-btn:hover{color:#0f172a}
.pm-pkg-tab-btn.active{color:#007a5e;border-bottom-color:#007a5e}
.pm-pkg-tab-badge{display:inline-flex;align-items:center;justify-content:center;padding:1px 7px;border-radius:999px;background:#f1f5f9;color:#475569;font-size:11px}
.pm-pkg-tab-btn.active .pm-pkg-tab-badge{background:#e8f7ef;color:#047857}

/* Tab Contents */
.pm-pkg-tab-content{display:none;padding:20px 24px}
.pm-pkg-tab-content.active{display:block}

/* Panel Header & Elements */
.pm-panel-top{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:16px;flex-wrap:wrap}
.pm-draft-status-pill{display:inline-block;padding:2px 8px;border-radius:999px;background:#f1f5f9;border:1px solid #e2e8f0;color:#475569;font-size:11px;font-weight:700}
.pm-draft-status-pill.has-items{background:#e8f7ef;border-color:#a7f3d0;color:#047857}

/* 4 Mutation Shortcut Cards */
.pm-mutation-shortcuts-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-bottom:16px}
.pm-mutation-shortcut{background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;padding:12px 14px;cursor:pointer;transition:all .15s ease;display:flex;flex-direction:column;justify-content:space-between;gap:12px}
.pm-mutation-shortcut:hover{background:#fff;border-color:#007a5e;box-shadow:0 4px 12px rgba(0,122,94,.08);transform:translateY(-1px)}
.pm-ms-head{display:flex;align-items:flex-start;gap:10px}
.pm-ms-icon{width:32px;height:32px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0}
