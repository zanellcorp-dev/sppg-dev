<%- include('../partials/header') %><div class="actions"><a class="btn secondary" href="/staff/<%= staff.id %>/edit">✏️ Edit</a><a class="btn gray" href="/staff">← Kembali</a></div><div class="grid-2" style="margin-top:16px"><div class="card"><h2>👤 <%= staff.name %></h2><span class="badge <%= staff.status==='AKTIF'?'green':staff.status==='MENINGGAL_DUNIA'?'red':'yellow' %>"><%= staff.status.replaceAll('_',' ') %></span><div class="stat-list" style="margin-top:15px"><div class="rowline"><span>NIK</span><strong><%= staff.nik %></strong></div><div class="rowline"><span>KPJ BPJSTK</span><strong><%= staff.kpj_bpjstk||'-' %></strong></div><div class="rowline"><span>Jabatan</span><strong><%= staff.position %></strong></div><div class="rowline"><span>Tanggal Masuk</span><strong><%= staff.tanggal_masuk_bekerja?new Date(staff.tanggal_masuk_bekerja).toLocaleDateString('id-ID'):'-' %></strong></div><div class="rowline"><span>HP/WhatsApp</span><strong><%= staff.phone||'-' %></strong></div><div class="rowline"><span>Email</span><strong><%= staff.email||'-' %></strong></div><div class="rowline"><span>Alamat Domisili</span><strong><%= staff.domicile_address||'-' %></strong></div></div></div><div class="card"><h2>📄 Dokumen</h2><% docTypes.forEach(d=>{const x=documents.find(z=>z.doc_type===d);%><div class="rowline"><span><%= d %></span><% if(x){ %><a class="btn gray" href="/uploads/<%= String(x.file_path).split(/[\\/]/).pop() %>" target="_blank">✓ Lihat</a><% }else{ %><span class="badge red">Belum ada</span><% } %></div><% }) %><form method="post" action="/staff/<%= staff.id %>/documents" enctype="multipart/form-data" style="margin-top:15px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select class="select" name="doc_type"><% docTypes.forEach(d=>{ %><option><%= d %></option><% }) %></select><input class="input" type="file" name="file" accept="image/jpeg,image/png,application/pdf" style="margin-top:7px"><button class="btn" style="margin-top:7px">📤 Upload Dokumen</button></form></div></div><div class="card" style="margin-top:16px"><h2>🎓 Pendidikan</h2><% education.forEach(e=>{ %><div class="rowline"><span><strong><%= e.level %></strong><br><small><%= e.major||'' %></small></span><span><%= e.institution||'-' %> · <%= e.graduation_year||'-' %></span></div><% }) %></div><div class="card" style="margin-top:16px"><h2>🕐 Riwayat</h2><% if(!history.length){ %><div class="empty">Belum ada riwayat perubahan.</div><% } history.forEach(h=>{ %><div class="rowline"><span><strong><%= h.action_type.replaceAll('_',' ') %></strong><br><small><%= h.description||'' %></small></span><span><%= new Date(h.created_at).toLocaleString('id-ID') %></span></div><% }) %></div><%- include('../partials/footer') %>
