<%- include('../partials/header') %>
<section class="module-hero panel"><div><span class="panel-kicker">KEPEGAWAIAN SPPG</span><h2>Jadwal Staf</h2><p>Susun jadwal kerja per tanggal, tim, shift, dan jam kerja. Jadwal menjadi dasar kehadiran harian.</p></div></section>
<section class="panel"><div class="panel-head"><div><span class="panel-kicker">TANGGAL</span><h3>Jadwal <%= new Date(date+'T00:00:00').toLocaleDateString('id-ID',{weekday:'long',day:'2-digit',month:'long',year:'numeric'}) %></h3></div><form class="filter-inline"><label>Tanggal<input type="date" name="date" value="<%= date %>"></label><button class="outline-btn">Tampilkan</button></form></div>
<% if(user && ['ADMIN','ASLAP','KASP'].includes(user.role)){ %><details class="panel-subsection"><summary class="mini-action">＋ Tambah Jadwal Staf</summary><form method="post" action="/staff/schedule" class="form-grid compact-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="schedule_date" value="<%= date %>"><label>Staf<select class="select" name="staff_id" required><option value="">Pilih staf aktif</option><% staffRows.forEach(s=>{ %><option value="<%= s.id %>"><%= s.name %> — <%= s.position %></option><% }) %></select></label><label>Tim<select class="select" name="team_id"><option value="">— Tidak ditentukan —</option><% teams.forEach(t=>{ %><option value="<%= t.id %>"><%= t.team_name %></option><% }) %></select></label><label>Shift<input class="input" name="shift_name" placeholder="Pagi / Siang / Full Day"></label><label>Mulai<input class="input" type="time" name="start_time"></label><label>Selesai<input class="input" type="time" name="end_time"></label><label>Keterangan<input class="input" name="notes" placeholder="Catatan jadwal"></label><div><button class="btn" type="submit">Simpan Jadwal</button></div></form></details><% } %>
<div class="table-wrap"><table class="table"><thead><tr><th>Staf</th><th>Tim</th><th>Jabatan</th><th>Shift</th><th>Mulai</th><th>Selesai</th><th>Keterangan</th><th></th></tr></thead><tbody><% rows.forEach(r=>{ %><tr><td><strong><%= r.name %></strong></td><td><%= r.team_name||'-' %></td><td><%= r.position %></td><td><%= r.shift_name||'-' %></td><td><%= r.start_time||'-' %></td><td><%= r.end_time||'-' %></td><td><%= r.notes||'-' %></td><td><% if(user && ['ADMIN','ASLAP','KASP'].includes(user.role)){ %><form method="post" action="/staff/schedule/<%= r.id %>/delete" onsubmit="return confirm('Batalkan jadwal staf ini?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input class="input" name="reason" placeholder="Alasan" required style="max-width:180px"><button class="mini-action" type="submit">Batalkan</button></form><% } %></td></tr><% }) %><% if(!rows.length){ %><tr><td colspan="8"><div class="empty-state compact"><i data-lucide="calendar-off"></i><strong>Belum ada jadwal</strong><span>Jadwal staf untuk tanggal ini belum diinput.</span></div></td></tr><% } %></tbody></table></div></section>
<section class="panel"><div class="panel-head"><div><span class="panel-kicker">KEHADIRAN</span><h3>Siap untuk Absensi</h3><p class="muted">Setelah jadwal dibuat, pengisian kehadiran dilakukan dari menu Absensi Staf.</p></div><a class="primary-btn" href="/staff/attendance?date=<%= date %>">Buka Absensi</a></div></section>
<%- include('../partials/footer') %>
