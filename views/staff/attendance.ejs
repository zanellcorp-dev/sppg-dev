<%- include('../partials/header') %>
<section class="module-hero panel"><div><span class="panel-kicker">KEPEGAWAIAN SPPG</span><h2>Absensi Staf</h2><p>Catat kehadiran setiap staf pada tanggal operasional. Data ini menjadi sumber rekap untuk Pengawas Keuangan.</p></div><a class="outline-btn" href="/staff/attendance/recap">Rekap Bulanan</a></section>
<section class="grid"><% [['BELUM_DIISI','⚪'],['HADIR','🟢'],['IZIN','🟡'],['SAKIT','🟠'],['ALPA','🔴'],['CUTI','🔵'],['DINAS','🟣']].forEach(x=>{ %><div class="card"><div class="icon"><%= x[1] %></div><div class="metric"><%= summary[x[0]]||0 %></div><div class="label"><%= x[0] %></div></div><% }) %></section>
<section class="panel"><div class="panel-head"><div><span class="panel-kicker">TANGGAL OPERASIONAL</span><h3><%= new Date(date+'T00:00:00').toLocaleDateString('id-ID',{weekday:'long',day:'2-digit',month:'long',year:'numeric'}) %></h3></div><form class="filter-inline"><label>Tanggal<input type="date" name="date" value="<%= date %>"></label><label>Tim<select name="team_id"><option value="">Semua Tim</option><% teams.forEach(t=>{ %><option value="<%= t.id %>" <%= Number(teamId)===Number(t.id)?'selected':'' %>><%= t.team_name %></option><% }) %></select></label><button class="outline-btn">Tampilkan</button></form></div>
<form method="post" action="/staff/attendance/bulk" id="attendanceForm"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="attendance_date" value="<%= date %>"><input type="hidden" name="rows_json" id="rows_json"><div class="table-wrap"><table class="table"><thead><tr><th>Staf</th><th>Tim</th><th>Jabatan</th><th>Status</th><th>Masuk</th><th>Pulang</th><th>Catatan</th></tr></thead><tbody><% staffRows.forEach(r=>{ %><tr data-staff-id="<%= r.id %>"><td><strong><%= r.name %></strong></td><td><%= r.team_id ? (teams.find(t=>Number(t.id)===Number(r.team_id))?.team_name||'-') : '<span class="muted">Belum dijadwalkan</span>' %></td><td><%= r.position %></td><td><select class="select att-status"><% statuses.forEach(st=>{ %><option value="<%= st %>" <%= r.attendance_status===st?'selected':'' %>><%= st %></option><% }) %></select></td><td><input class="input att-in" type="time" value="<%= r.check_in||'' %>"></td><td><input class="input att-out" type="time" value="<%= r.check_out||'' %>"></td><td><input class="input att-note" value="<%= r.attendance_note||'' %>" placeholder="Opsional"></td></tr><% }) %></tbody></table></div><% if(user && ['ADMIN','ASLAP','KASP'].includes(user.role)){ %><div class="panel-actions"><button class="btn" type="submit">Simpan Semua Absensi</button></div><% } %></form></section>
<section class="panel"><div class="panel-head"><div><span class="panel-kicker">PENGGANTIAN PETUGAS</span><h3>Staf Tidak Hadir → Pengganti</h3><p class="muted">Pengganti hanya berlaku untuk tanggal/pekerjaan yang dicatat; tidak mengubah anggota tim permanen.</p></div></div>
<% if(user && ['ADMIN','ASLAP','KASP'].includes(user.role)){ %><form method="post" action="/staff/attendance/replacement" class="form-grid compact-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="replacement_date" value="<%= date %>"><label>Tim<select class="select" name="team_id"><option value="">— Pilih tim —</option><% teams.forEach(t=>{ %><option value="<%= t.id %>"><%= t.team_name %></option><% }) %></select></label><label>Staf Tidak Hadir<select class="select" name="absent_staff_id" required><option value="">Pilih staf</option><% staffRows.filter(s=>['IZIN','SAKIT','ALPA','CUTI'].includes(s.attendance_status)).forEach(s=>{ %><option value="<%= s.id %>"><%= s.name %></option><% }) %></select></label><label>Pengganti<select class="select" name="replacement_staff_id" required><option value="">Pilih staf aktif</option><% staffRows.filter(s=>s.attendance_status==='HADIR').forEach(s=>{ %><option value="<%= s.id %>"><%= s.name %></option><% }) %></select></label><label>Pekerjaan yang Digantikan<input class="input" name="task_scope" placeholder="Contoh: Pemorsian Kloter 2"></label><label>Alasan<input class="input" name="reason" placeholder="Alasan tidak hadir/penggantian"></label><label>Catatan<input class="input" name="note"></label><div><button class="btn" type="submit">Simpan Penggantian</button></div></form><% } %>
<div class="table-wrap"><table class="table"><thead><tr><th>Staf Asli</th><th>Pengganti</th><th>Tim</th><th>Pekerjaan</th><th>Alasan</th><th></th></tr></thead><tbody><% replacements.forEach(r=>{ %><tr><td><strong><%= r.absent_name %></strong></td><td><%= r.replacement_name %></td><td><%= r.team_name||'-' %></td><td><%= r.task_scope||'-' %></td><td><%= r.reason||'-' %></td><td><% if(user && ['ADMIN','ASLAP','KASP'].includes(user.role)){ %><form method="post" action="/staff/attendance/replacement/<%= r.id %>/cancel" onsubmit="return confirm('Batalkan catatan penggantian ini? Histori tetap disimpan.')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="mini-action">Batalkan</button></form><% } %></td></tr><% }) %><% if(!replacements.length){ %><tr><td colspan="6" class="muted">Belum ada penggantian petugas pada tanggal ini.</td></tr><% } %></tbody></table></div></section>
<script>
document.getElementById('attendanceForm')?.addEventListener('submit',function(){const rows=[...document.querySelectorAll('#attendanceForm tbody tr')].map(tr=>({staff_id:Number(tr.dataset.staffId),status:tr.querySelector('.att-status').value,check_in:tr.querySelector('.att-in').value,check_out:tr.querySelector('.att-out').value,note:tr.querySelector('.att-note').value}));document.getElementById('rows_json').value=JSON.stringify(rows);});
</script>
<%- include('../partials/footer') %>
