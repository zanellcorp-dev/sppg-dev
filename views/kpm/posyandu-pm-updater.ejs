<%
  const activeSubs = Array.isArray(subs) ? subs : [];
  const pendingCount = activeSubs.filter(s => ['DIAJUKAN', 'DITINJAU'].includes(s.status)).length;
  const revisionCount = activeSubs.filter(s => s.status === 'DITOLAK').length;
  const completedCount = activeSubs.filter(s => ['DISETUJUI', 'DITERAPKAN'].includes(s.status)).length;
  const activePmList = pm.filter(x => Number(x.active) === 1);
  const isPosyandu = (access.kpm_type || access.type) === 'POSYANDU';
  const postUrl = previewMode 
    ? `/portal/kpm/preview/${access.kpm_id || access.id}/package-submission` 
    : `/portal/kpm/${portalToken}/package-submission`;
%>

<section class="kpm-section pm-package-section" id="pm-package-section" aria-label="Paket Pembaruan Data PM">
  <!-- Header Bagian C -->
  <div class="kpm-section-head pm-package-head">
    <div>
      <div class="pm-package-eyebrow">
        <span class="pm-package-badge-tag">BAGIAN C · PEMBARUAN DATA PM</span>
        <span class="pm-package-kpm-badge"><%= access.kpm_name %> · <%= access.kpm_code %></span>
      </div>
      <h2 style="margin:6px 0 3px">C. Pengajuan Pembaruan Data PM <%= isPosyandu ? 'Posyandu' : '' %></h2>
      <p style="margin:0;color:#64748b;font-size:13px">
        Ajukan penambahan, pengeluaran, koreksi, atau perubahan kategori penerima manfaat dalam satu pengajuan paket ke Ka. SPPG.
      </p>
    </div>
  </div>

  <!-- Status Pengajuan 4 Metric Cards -->
  <div class="pm-status-cards-grid">
    <!-- 1. Draft Perubahan -->
    <div class="pm-status-card" id="cardDraftStatus" onclick="switchPackageTab('tab-paket')" style="cursor:pointer">
      <div class="pm-status-card-icon draft">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
      </div>
      <div class="pm-status-card-info">
        <strong class="pm-status-card-num" id="metricDraftCount">0</strong>
        <span class="pm-status-card-label">Draft perubahan</span>
        <small class="pm-status-card-sub" id="metricDraftDetail">0 item perubahan</small>
      </div>
    </div>

    <!-- 2. Menunggu Verifikasi -->
    <div class="pm-status-card" onclick="switchPackageTab('tab-riwayat')" style="cursor:pointer">
      <div class="pm-status-card-icon pending">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      </div>
      <div class="pm-status-card-info">
        <strong class="pm-status-card-num"><%= pendingCount %></strong>
        <span class="pm-status-card-label">Menunggu verifikasi</span>
        <small class="pm-status-card-sub">Dalam review Ka. SPPG</small>
      </div>
    </div>

    <!-- 3. Perlu Perbaikan -->
    <div class="pm-status-card" onclick="switchPackageTab('tab-riwayat')" style="cursor:pointer">
      <div class="pm-status-card-icon revision">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
      </div>
      <div class="pm-status-card-info">
        <strong class="pm-status-card-num"><%= revisionCount %></strong>
        <span class="pm-status-card-label">Perlu perbaikan</span>
        <small class="pm-status-card-sub">Catatan revisi tersedia</small>
      </div>
    </div>

    <!-- 4. Selesai -->
    <div class="pm-status-card" onclick="switchPackageTab('tab-riwayat')" style="cursor:pointer">
      <div class="pm-status-card-icon completed">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
      </div>
      <div class="pm-status-card-info">
        <strong class="pm-status-card-num"><%= completedCount %></strong>
        <span class="pm-status-card-label">Selesai</span>
        <small class="pm-status-card-sub">Disahkan & diterapkan</small>
      </div>
    </div>
  </div>

  <!-- Tab Switcher Nav -->
  <div class="pm-package-tabs-bar">
    <button type="button" class="pm-pkg-tab-btn active" id="tabBtnPaket" onclick="switchPackageTab('tab-paket')">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
      <span>Paket Pembaruan Data</span>
      <span class="pm-pkg-tab-badge" id="tabDraftBadge">0</span>
    </button>
    <button type="button" class="pm-pkg-tab-btn" id="tabBtnRiwayat" onclick="switchPackageTab('tab-riwayat')">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      <span>Riwayat Pengajuan</span>
      <span class="pm-pkg-tab-badge"><%= activeSubs.length %></span>
    </button>
  </div>

  <!-- TAB 1: KONTEN PAKET PEMBARUAN DATA (DRAFT / AKTIF) -->
  <div class="pm-pkg-tab-content active" id="tabContentPaket">
    <div class="pm-package-card-panel">
      <!-- Header Paket -->
      <div class="pm-panel-top">
        <div>
          <div style="display:flex;align-items:center;gap:8px">
            <h3 style="margin:0;font-size:16px;color:#0f243d">Pembaruan Data PM <%= isPosyandu ? 'Posyandu' : '' %></h3>
            <span class="pm-draft-status-pill" id="draftStatusPill">Draft</span>
          </div>
          <p style="margin:4px 0 0;font-size:12.5px;color:#64748b">
            Gabungkan semua perubahan dalam satu paket. Kader dapat mencampur PM baru, PM keluar, koreksi identitas, dan perubahan kategori.
          </p>
        </div>
        <div>
          <button type="button" class="btn primary" onclick="openMutationPickerModal()">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            <span>Tambah Perubahan ke Paket</span>
          </button>
        </div>
      </div>

      <!-- 4 Action Shortcut Cards -->
      <div class="pm-mutation-shortcuts-grid">
        <!-- 1. PM Baru -->
        <div class="pm-mutation-shortcut" onclick="openNewPmModal()">
          <div class="pm-ms-head">
            <span class="pm-ms-icon blue">👶</span>
            <div class="pm-ms-text">
              <strong>PM Baru</strong>
              <small>Isi identitas PM yang belum terdaftar</small>
            </div>
          </div>
          <button type="button" class="pm-ms-action-btn">＋ Tambah</button>
        </div>

        <!-- 2. PM Keluar -->
        <div class="pm-mutation-shortcut" onclick="openExitPmModal()">
          <div class="pm-ms-head">
            <span class="pm-ms-icon amber">🚪</span>
            <div class="pm-ms-text">
              <strong>PM Keluar</strong>
              <small>Pilih dari database resmi, tanpa ketik ulang</small>
            </div>
          </div>
          <button type="button" class="pm-ms-action-btn">🚪 Keluar</button>
        </div>

        <!-- 3. Koreksi Identitas -->
        <div class="pm-mutation-shortcut" onclick="openCorrectionPmModal()">
          <div class="pm-ms-head">
            <span class="pm-ms-icon purple">✏️</span>
            <div class="pm-ms-text">
              <strong>Koreksi Identitas</strong>
              <small>Pilih PM lama, ubah hanya data yang salah</small>
            </div>
          </div>
          <button type="button" class="pm-ms-action-btn">✏️ Koreksi</button>
        </div>

        <!-- 4. Perubahan Kategori -->
        <div class="pm-mutation-shortcut" onclick="openCategoryChangeModal()">
          <div class="pm-ms-head">
            <span class="pm-ms-icon green">🔄</span>
            <div class="pm-ms-text">
              <strong>Perubahan Kategori</strong>
              <small>Contoh: Bumil melahirkan menjadi Busui</small>
            </div>
          </div>
          <button type="button" class="pm-ms-action-btn">🔄 Alih Kategori</button>
        </div>
      </div>

      <!-- Mini Counter Mutasi Saat Ini -->
      <div class="pm-draft-counters-bar">
        <div class="pm-draft-count-item">
          <span>PM Baru:</span>
          <strong id="counterNewPm">0</strong>
        </div>
        <div class="pm-draft-count-item">
          <span>PM Keluar:</span>
          <strong id="counterExitPm">0</strong>
        </div>
        <div class="pm-draft-count-item">
          <span>Koreksi Identitas:</span>
          <strong id="counterCorrectionPm">0</strong>
        </div>
        <div class="pm-draft-count-item">
          <span>Perubahan Kategori:</span>
          <strong id="counterCategoryPm">0</strong>
        </div>
      </div>

      <!-- Tabel / Kontainer Isi Paket Saat Ini -->
      <div class="pm-package-items-section">
        <div class="pm-package-items-head">
          <strong style="font-size:13.5px;color:#1e293b">Daftar Perubahan dalam Paket Saat Ini</strong>
          <span style="font-size:12px;color:#64748b" id="pkgItemsCountNote">0 perubahan</span>
        </div>

        <!-- State Kosong (Belum ada perubahan) -->
        <div class="pm-package-empty-state" id="pkgEmptyState">
          <div class="pm-empty-icon-wrap">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="#94a3b8" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
          </div>
          <strong style="color:#1e293b;font-size:13.5px">Belum ada perubahan dalam paket</strong>
          <p style="margin:4px 0 14px;color:#64748b;font-size:12px;max-width:380px">
            Tekan salah satu jenis perubahan di atas atau tombol "Tambah Perubahan ke Paket" untuk menyusun paket pengajuan ke Ka. SPPG.
          </p>
          <button type="button" class="btn primary" onclick="openMutationPickerModal()">
            Mulai Tambah Perubahan
          </button>
        </div>

        <!-- Tabel Perubahan Terisi -->
        <div class="kpm-table-wrap" id="pkgItemsTableWrap" style="display:none;margin-top:10px">
          <table class="kpm-table pm-table">
            <thead>
              <tr>
                <th style="width:40px;text-align:center">No</th>
                <th style="width:140px">Jenis Perubahan</th>
                <th>Nama Lengkap & Identitas</th>
                <th>Kategori & Sub-Kelompok</th>
                <th>Rincian / Alasan</th>
                <th style="width:110px">Tanggal Efektif</th>
                <th style="width:70px;text-align:center">Aksi</th>
              </tr>
            </thead>
            <tbody id="pkgItemsTableBody">
              <!-- Baris dinamis via JS -->
            </tbody>
          </table>
        </div>

        <!-- Ringkasan Dampak Porsi & Form Pengiriman Paket -->
        <div class="pm-package-submission-panel" id="pkgSubmissionPanel" style="display:none">
          <div class="pm-impact-summary-box">
            <div class="pm-impact-head">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#007a5e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
              <strong>Proyeksi Rekapitulasi Perubahan Porsi</strong>
            </div>
            <div class="pm-impact-metrics">
              <div class="pm-im-item">
                <small>Total Item Perubahan</small>
                <strong id="impactTotalItems">0 Item</strong>
              </div>
              <div class="pm-im-item">
                <small>Balita (Porsi Kecil)</small>
                <strong id="impactSmallPortion">± 0</strong>
              </div>
              <div class="pm-im-item">
                <small>Bumil & Busui (Porsi Besar)</small>
                <strong id="impactLargePortion">± 0</strong>
              </div>
            </div>
          </div>

          <form id="pkgFinalSubmitForm" method="post" action="<%= postUrl %>" onsubmit="return validateFinalPackageSubmit(event)">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="items_json" id="pkgItemsJsonInput" value="[]">
            <input type="hidden" name="is_draft" id="pkgIsDraftInput" value="0">

            <div class="pm-submit-controls-row">
              <div class="field" style="margin:0;min-width:200px">
                <label style="font-size:12px;font-weight:700;color:#334155">Tanggal Efektif Paket Berlaku <span style="color:#d92d20">*</span></label>
                <input class="input" type="date" name="effective_from" id="pkgEffectiveFromInput" value="<%= new Date().toISOString().slice(0,10) %>" required>
              </div>
              <div class="field full" style="margin:0;flex:1;min-width:260px">
                <label style="font-size:12px;font-weight:700;color:#334155">Catatan Pengantar untuk Ka. SPPG (Opsional)</label>
                <input class="input" type="text" name="submission_note" placeholder="Contoh: Pembaruan data rutin Posyandu Cempaka 1 periode Oktober 2026...">
              </div>
            </div>

            <div class="pm-submit-actions-row">
              <button type="button" class="btn gray" onclick="clearPackageDraft()">
                🗑️ Bersihkan Draft
              </button>
              <div style="display:flex;gap:8px;flex-wrap:wrap">
                <button type="button" class="btn secondary" onclick="submitPackageDraft(true)">
                  💾 Simpan sebagai Draft
                </button>
                <button type="button" class="btn primary" onclick="submitPackageDraft(false)">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                  <span>Kirim Pengajuan ke Ka. SPPG</span>
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- TAB 2: RIWAYAT PENGAJUAN -->
  <div class="pm-pkg-tab-content" id="tabContentRiwayat">
    <div class="pm-history-panel">
      <div class="pm-panel-top">
        <div>
          <h3 style="margin:0;font-size:16px;color:#0f243d">Riwayat Pengajuan Pembaruan Data</h3>
          <p style="margin:4px 0 0;font-size:12.5px;color:#64748b">
            Paket yang pernah dikirim, nomor registrasi, status verifikasi Ka. SPPG, dan hasil persetujuan tercatat di sini.
          </p>
        </div>
      </div>

      <% if(activeSubs.length){ %>
        <div class="pm-history-list">
          <% activeSubs.forEach(s => { 
            const isPending = ['DIAJUKAN', 'DITINJAU'].includes(s.status);
            const isApproved = ['DISETUJUI', 'DITERAPKAN'].includes(s.status);
            const isRejected = s.status === 'DITOLAK';
            const statusLabel = isPending ? 'Menunggu Verifikasi Ka. SPPG' : isApproved ? 'Disetujui Ka. SPPG' : isRejected ? 'Perlu Perbaikan / Ditolak' : s.status;
            const statusClass = isPending ? 'pending' : isApproved ? 'approved' : isRejected ? 'rejected' : 'draft';
          %>
            <div class="pm-history-card">
              <div class="pm-hc-head">
                <div class="pm-hc-title-wrap">
                  <span class="pm-hc-code">#PKT-<%= String(s.id).padStart(4, '0') %></span>
                  <strong class="pm-hc-title">Paket Pembaruan Data PM · <%= access.kpm_name %></strong>
                  <span class="pm-hc-badge <%= statusClass %>"><%= statusLabel %></span>
                </div>
                <div class="pm-hc-dates">
                  <span>📅 Berlaku: <strong><%= s.effective_from %></strong></span>
                  <span style="color:#94a3b8">·</span>
                  <span>Diajukan: <%= new Date(s.created_at).toLocaleDateString('id-ID', {day:'numeric',month:'short',year:'numeric'}) %></span>
                </div>
              </div>

              <div class="pm-hc-body">
                <div class="pm-hc-note-box">
                  <% if(s.review_note){ %>
                    <div><strong>Catatan Review:</strong> <span><%= s.review_note %></span></div>
                  <% } else { %>
                    <span style="color:#64748b;font-style:italic">Belum ada catatan tambahan dari Ka. SPPG.</span>
                  <% } %>
                  <% if(s.reviewed_at){ %>
                    <small style="color:#94a3b8;margin-top:2px;display:block">Ditinjau pada: <%= new Date(s.reviewed_at).toLocaleDateString('id-ID', {day:'numeric',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'}) %></small>
                  <% } %>
                </div>

                <div class="pm-hc-actions">
                  <button type="button" class="btn secondary" onclick="viewPackageDetailModal(<%= s.id %>)">
                    👁️ Lihat Rincian Paket
                  </button>

                  <% if(previewMode && isPending){ %>
                    <!-- Otorisasi Pimpinan Langsung dari Preview -->
                    <button type="button" class="btn success" onclick="handleExecutiveReviewAction(<%= s.id %>, 'DISETUJUI')">
                      ✅ Sahkan & Setujui
                    </button>
                    <button type="button" class="btn danger" onclick="handleExecutiveReviewAction(<%= s.id %>, 'PERLU_PERBAIKAN')">
                      ⚠️ Minta Revisi
                    </button>
                  <% } %>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="pm-package-empty-state">
          <div class="pm-empty-icon-wrap">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="#94a3b8" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <strong style="color:#1e293b;font-size:13.5px">Belum ada riwayat pengajuan</strong>
          <p style="margin:4px 0 14px;color:#64748b;font-size:12px">
            Paket pembaruan yang dikirim ke Ka. SPPG beserta status verifikasinya akan tercatat rapi di sini.
          </p>
          <button type="button" class="btn secondary" onclick="switchPackageTab('tab-paket')">
            Buat Paket Pembaruan Sekarang
          </button>
        </div>
      <% } %>
    </div>
  </div>
</section>

<!-- ============================================================== -->
<!-- MODAL 1: PICKER JENIS MUTASI (MODAL PILIH MENU)                -->
<!-- ============================================================== -->
<div id="modalMutationPicker" class="pm-modal-backdrop" style="display:none" role="dialog" aria-modal="true">
  <div class="pm-modal-card">
    <div class="pm-modal-head neutral">
      <div class="pm-modal-icon-wrap neutral">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      </div>
      <div>
        <h3 style="margin:0;font-size:16px">Pilih Jenis Perubahan Data</h3>
        <p style="margin:3px 0 0;font-size:12.5px;color:#64748b">Pilih tindakan yang ingin ditambahkan ke dalam paket pembaruan saat ini.</p>
      </div>
      <button type="button" class="pm-modal-close" onclick="closeModal('modalMutationPicker')">&times;</button>
    </div>
    <div class="pm-modal-body" style="padding:16px 20px">
      <div class="pm-mutation-picker-list">
        <div class="pm-picker-opt" onclick="closeModal('modalMutationPicker'); openNewPmModal();">
          <div class="pm-picker-opt-icon blue">👶</div>
          <div>
            <strong>1. Tambah PM Baru</strong>
            <span>Pendaftaran penerima manfaat baru yang belum terdaftar di database.</span>
          </div>
          <span class="pm-picker-arrow">→</span>
        </div>

        <div class="pm-picker-opt" onclick="closeModal('modalMutationPicker'); openExitPmModal();">
          <div class="pm-picker-opt-icon amber">🚪</div>
          <div>
            <strong>2. PM Keluar (Pilih dari Data Resmi)</strong>
            <span>Pilih orang yang sudah ada tanpa mengetik ulang NIK/nama (pindah, lulus usia, dll).</span>
          </div>
          <span class="pm-picker-arrow">→</span>
        </div>

        <div class="pm-picker-opt" onclick="closeModal('modalMutationPicker'); openCorrectionPmModal();">
          <div class="pm-picker-opt-icon purple">✏️</div>
          <div>
            <strong>3. Koreksi Identitas</strong>
            <span>Perbaiki salah ketik nama, NIK, tanggal lahir, atau alamat penerima yang sudah ada.</span>
          </div>
          <span class="pm-picker-arrow">→</span>
        </div>

        <div class="pm-picker-opt" onclick="closeModal('modalMutationPicker'); openCategoryChangeModal();">
          <div class="pm-picker-opt-icon green">🔄</div>
          <div>
            <strong>4. Perubahan Kategori (Alih Status)</strong>
            <span>Alih status penerima manfaat (contoh: Bumil melahirkan beralih menjadi Busui).</span>
          </div>
          <span class="pm-picker-arrow">→</span>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ============================================================== -->
<!-- MODAL 2: FORM TAMBAH PM BARU                                   -->
<!-- ============================================================== -->
<div id="modalNewPm" class="pm-modal-backdrop" style="display:none" role="dialog" aria-modal="true">
  <div class="pm-modal-card">
    <div class="pm-modal-head neutral">
      <div class="pm-modal-icon-wrap neutral">👶</div>
      <div>
        <h3 style="margin:0;font-size:16px">Tambah PM Baru ke Paket</h3>
        <p style="margin:3px 0 0;font-size:12.5px;color:#64748b">Identitas penerima manfaat yang belum terdaftar di <%= access.kpm_name %>.</p>
      </div>
      <button type="button" class="pm-modal-close" onclick="closeModal('modalNewPm')">&times;</button>
    </div>
    <form onsubmit="handleAddNewPmSubmit(event)">
      <div class="pm-modal-body">
        <!-- Kategori PM -->
        <div class="pm-form-field">
          <label>Kategori PM <span style="color:#d92d20">*</span></label>
          <div class="pm-radio-pills">
            <label class="pm-radio-pill"><input type="radio" name="newpm_category" value="BALITA" checked onchange="updateNewPmSubgroupOptions()"> 👶 Balita</label>
            <label class="pm-radio-pill"><input type="radio" name="newpm_category" value="BUMIL" onchange="updateNewPmSubgroupOptions()"> 🤰 Bumil</label>
            <label class="pm-radio-pill"><input type="radio" name="newpm_category" value="BUSUI" onchange="updateNewPmSubgroupOptions()"> 🤱 Busui</label>
          </div>
        </div>

        <div class="pm-form-field">
          <label>Nama Lengkap <span style="color:#d92d20">*</span></label>
          <input type="text" id="newpm_name" class="pm-modal-input" placeholder="Nama lengkap sesuai dokumen KK/KTP" required>
        </div>

        <div class="pm-form-grid-2">
          <div class="pm-form-field">
            <label>NIK (16 Digit)</label>
            <input type="text" id="newpm_nik" class="pm-modal-input" placeholder="16 digit angka NIK" maxlength="16" pattern="[0-9]{16}">
          </div>
          <div class="pm-form-field">
            <label>Jenis Kelamin <span style="color:#d92d20">*</span></label>
            <select id="newpm_gender" class="pm-modal-select" required>
              <option value="L">Laki-laki (L)</option>
              <option value="P" selected>Perempuan (P)</option>
            </select>
          </div>
        </div>

        <div class="pm-form-grid-2">
          <div class="pm-form-field">
            <label>Tanggal Lahir</label>
            <input type="date" id="newpm_birth" class="pm-modal-input">
          </div>
          <div class="pm-form-field">
            <label>Sub-Kelompok / Porsi</label>
            <select id="newpm_subgroup" class="pm-modal-select">
              <option value="0-5 Bulan (Bayi)">0-5 Bulan (Bayi)</option>
              <option value="6-23 Bulan (Baduta)" selected>6-23 Bulan (Baduta)</option>
              <option value="24-59 Bulan (Balita)">24-59 Bulan (Balita)</option>
            </select>
          </div>
        </div>

        <div class="pm-form-field">
          <label>Alasan Penambahan <span style="color:#d92d20">*</span></label>
          <input type="text" id="newpm_reason" class="pm-modal-input" placeholder="Contoh: Penerima baru yang memenuhi kriteria program MBG" value="Penerima baru yang memenuhi kriteria" required>
        </div>

        <div class="pm-form-field">
          <label>Tanggal Efektif Mulai <span style="color:#d92d20">*</span></label>
          <input type="date" id="newpm_effective" class="pm-modal-input" value="<%= new Date().toISOString().slice(0,10) %>" required>
        </div>
      </div>
      <div class="pm-modal-foot">
        <button type="button" class="btn secondary" onclick="closeModal('modalNewPm')">Batal</button>
        <button type="submit" class="btn primary">＋ Tambahkan ke Paket</button>
      </div>
    </form>
  </div>
</div>

<!-- ============================================================== -->
<!-- MODAL 3: PM KELUAR (AMBIL DARI DATABASE RESMI)                  -->
<!-- ============================================================== -->
<div id="modalExitPm" class="pm-modal-backdrop" style="display:none" role="dialog" aria-modal="true">
  <div class="pm-modal-card pm-modal-card-lg">
    <div class="pm-modal-head neutral">
      <div class="pm-modal-icon-wrap neutral">🚪</div>
      <div>
        <h3 style="margin:0;font-size:16px">Pilih PM Keluar dari Data Resmi</h3>
        <p style="margin:3px 0 0;font-size:12.5px;color:#64748b">Data diambil langsung dari database <%= access.kpm_name %>. Kader tidak perlu mengetik ulang.</p>
      </div>
      <button type="button" class="pm-modal-close" onclick="closeModal('modalExitPm')">&times;</button>
    </div>
    <form onsubmit="handleAddExitPmSubmit(event)">
      <div class="pm-modal-body">
        <!-- 1. Filter Kategori PM -->
        <div class="pm-form-field">
          <label>1. Filter Kategori PM</label>
          <div class="pm-radio-pills" id="exitFilterPills">
            <label class="pm-radio-pill"><input type="radio" name="exit_cat_filter" value="ALL" checked onchange="filterExitPmList()"> Semua</label>
            <label class="pm-radio-pill"><input type="radio" name="exit_cat_filter" value="BALITA" onchange="filterExitPmList()"> 👶 Balita</label>
            <label class="pm-radio-pill"><input type="radio" name="exit_cat_filter" value="BUMIL" onchange="filterExitPmList()"> 🤰 Bumil</label>
            <label class="pm-radio-pill"><input type="radio" name="exit_cat_filter" value="BUSUI" onchange="filterExitPmList()"> 🤱 Busui</label>
          </div>
        </div>

        <!-- 2. Cari Nama / NIK -->
        <div class="pm-form-field">
          <label>2. Cari Nama atau NIK PM</label>
          <input type="search" id="exitSearchInput" class="pm-modal-input" placeholder="Ketik nama atau NIK penerima manfaat..." oninput="filterExitPmList()">
        </div>

        <!-- Daftar Penerima Manfaat yang Bisa Dipilih -->
        <div class="pm-db-picker-container" id="exitPmPickerContainer">
          <% activePmList.forEach(p => { %>
            <label class="pm-db-picker-row" data-id="<%= p.id %>" data-cat="<%= p.category %>" data-name="<%= p.full_name.toLowerCase() %>" data-nik="<%= (p.nik||'').toLowerCase() %>">
              <input type="radio" name="selected_exit_pm_id" value="<%= p.id %>" required onchange="onExitPmSelected(this)">
              <div class="pm-db-row-content">
                <strong><%= p.full_name %></strong>
                <small>NIK: <%= p.nik || '-' %> · <%= p.class_group || '-' %></small>
              </div>
              <span class="pm-cat-pill"><%= p.category %></span>
            </label>
          <% }) %>
        </div>

        <!-- Card Pratinjau Terpilih -->
        <div class="pm-selected-preview" id="exitSelectedPreview" style="display:none">
          <small>PENERIMA MANFAAT TERPILIH:</small>
          <strong id="exitSelectedName">-</strong>
          <span id="exitSelectedMeta" style="color:#64748b;font-size:12px">NIK: -</span>
        </div>

        <!-- 3. Alasan PM Keluar -->
        <div class="pm-form-field" style="margin-top:14px">
          <label>3. Alasan PM Keluar <span style="color:#d92d20">*</span></label>
          <select id="exit_reason" class="pm-modal-select" required>
            <option value="">— Pilih Alasan Keluar —</option>
            <option value="Pindah domisili ke luar wilayah">Pindah domisili ke luar wilayah</option>
            <option value="Melewati batas usia balita (> 2 tahun / > 5 tahun)">Melewati batas usia balita (> 2 tahun / > 5 tahun)</option>
            <option value="Lulus masa menyusui / Bayi genap 2 tahun">Lulus masa menyusui / Bayi genap 2 tahun</option>
            <option value="Mengundurkan diri secara sukarela">Mengundurkan diri secara sukarela</option>
            <option value="Meninggal dunia">Meninggal dunia</option>
            <option value="Koreksi data duplikat">Koreksi data duplikat</option>
            <option value="Lainnya">Lainnya</option>
          </select>
        </div>

        <div class="pm-form-grid-2">
          <div class="pm-form-field">
            <label>Tanggal Efektif Keluar <span style="color:#d92d20">*</span></label>
            <input type="date" id="exit_effective" class="pm-modal-input" value="<%= new Date().toISOString().slice(0,10) %>" required>
          </div>
          <div class="pm-form-field">
            <label>Catatan Tambahan (Opsional)</label>
            <input type="text" id="exit_custom_note" class="pm-modal-input" placeholder="Keterangan opsional petugas...">
          </div>
        </div>
      </div>
      <div class="pm-modal-foot">
        <button type="button" class="btn secondary" onclick="closeModal('modalExitPm')">Batal</button>
        <button type="submit" class="btn primary" id="btnSubmitExitPm">🚪 Tambahkan PM Keluar ke Paket</button>
      </div>
    </form>
  </div>
</div>

<!-- ============================================================== -->
<!-- MODAL 4: KOREKSI IDENTITAS (PILIH DARI DATA RESMI)              -->
<!-- ============================================================== -->
<div id="modalCorrectionPm" class="pm-modal-backdrop" style="display:none" role="dialog" aria-modal="true">
  <div class="pm-modal-card pm-modal-card-lg">
    <div class="pm-modal-head neutral">
      <div class="pm-modal-icon-wrap neutral">✏️</div>
      <div>
        <h3 style="margin:0;font-size:16px">Koreksi Identitas Penerima Manfaat</h3>
        <p style="margin:3px 0 0;font-size:12.5px;color:#64748b">Pilih PM lama, lalu ubah hanya kolom yang salah (e-KTP/KK baru).</p>
      </div>
      <button type="button" class="pm-modal-close" onclick="closeModal('modalCorrectionPm')">&times;</button>
    </div>
    <form onsubmit="handleAddCorrectionSubmit(event)">
      <div class="pm-modal-body">
        <div class="pm-form-field">
          <label>Cari PM yang Ingin Dikoreksi</label>
          <input type="search" id="corrSearchInput" class="pm-modal-input" placeholder="Ketik nama atau NIK..." oninput="filterCorrectionPmList()">
        </div>

        <div class="pm-db-picker-container" id="corrPmPickerContainer" style="max-height:160px">
          <% activePmList.forEach(p => { %>
            <label class="pm-db-picker-row" data-id="<%= p.id %>" data-name="<%= p.full_name.toLowerCase() %>" data-nik="<%= (p.nik||'').toLowerCase() %>">
              <input type="radio" name="selected_corr_pm_id" value="<%= p.id %>" required onchange="onCorrPmSelected(<%= JSON.stringify(p) %>)">
              <div class="pm-db-row-content">
                <strong><%= p.full_name %></strong>
                <small>NIK: <%= p.nik || '-' %> · <%= p.class_group || '-' %></small>
              </div>
              <span class="pm-cat-pill"><%= p.category %></span>
            </label>
          <% }) %>
        </div>

        <div id="corrFormFields" style="display:none;margin-top:14px;border-top:1px solid #e2e8f0;padding-top:14px">
          <input type="hidden" id="corr_pm_id">
          <div class="pm-form-field">
            <label>Nama Lengkap (Koreksi)</label>
            <input type="text" id="corr_name" class="pm-modal-input" required>
          </div>
          <div class="pm-form-grid-2">
            <div class="pm-form-field">
              <label>NIK (16 Digit)</label>
              <input type="text" id="corr_nik" class="pm-modal-input" maxlength="16">
            </div>
            <div class="pm-form-field">
              <label>Jenis Kelamin</label>
              <select id="corr_gender" class="pm-modal-select">
                <option value="L">Laki-laki (L)</option>
                <option value="P">Perempuan (P)</option>
              </select>
            </div>
          </div>
          <div class="pm-form-field">
            <label>Alasan Koreksi <span style="color:#d92d20">*</span></label>
            <input type="text" id="corr_reason" class="pm-modal-input" placeholder="Contoh: Perbaikan salah ketik NIK sesuai e-KTP baru" required>
          </div>
          <div class="pm-form-field">
            <label>Tanggal Efektif Koreksi <span style="color:#d92d20">*</span></label>
            <input type="date" id="corr_effective" class="pm-modal-input" value="<%= new Date().toISOString().slice(0,10) %>" required>
          </div>
        </div>
      </div>
      <div class="pm-modal-foot">
        <button type="button" class="btn secondary" onclick="closeModal('modalCorrectionPm')">Batal</button>
        <button type="submit" class="btn primary" id="btnSubmitCorrPm" disabled>✏️ Tambahkan Koreksi ke Paket</button>
      </div>
    </form>
  </div>
</div>

