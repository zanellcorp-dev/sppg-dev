.pm-modal-body{padding:20px 22px;max-height:68vh;overflow-y:auto}
.pm-target-summary{background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;padding:12px 14px}
.pm-target-summary small{display:block;font-size:10px;font-weight:800;letter-spacing:.06em;color:#64748b;margin-bottom:2px}
.pm-target-summary strong{display:block;font-size:14px;color:#0f172a}
.pm-target-meta{display:inline-block;font-size:12px;color:#64748b;margin-top:2px}
.pm-prev-reason{margin-top:6px;font-size:11.5px;color:#94a3b8;border-top:1px dashed #cbd5e1;padding-top:4px}
.pm-notice-softdelete{display:flex;align-items:flex-start;gap:10px;padding:12px 14px;background:#fffbeb;border:1px solid #fde68a;border-radius:12px;margin:14px 0}
.pm-notice-softdelete strong{display:block;font-size:12.5px;color:#92400e}
.pm-notice-softdelete span{display:block;font-size:11.5px;color:#b45309;margin-top:2px;line-height:1.45}
.pm-form-field{margin-top:14px}
.pm-form-field label{display:block;font-size:12.5px;font-weight:700;color:#334155;margin-bottom:6px}
.pm-modal-select, .pm-modal-input{width:100%;height:38px;padding:0 12px;border-radius:9px;border:1px solid #cbd5e1;background:#fff;font-size:13px;color:#1e293b}
.pm-modal-select:focus, .pm-modal-input:focus{outline:none;border-color:#007a5e;box-shadow:0 0 0 3px rgba(0,122,94,.12)}

/* Modal Foot */
.pm-modal-foot{display:flex;align-items:center;justify-content:flex-end;gap:10px;padding:14px 22px;background:#f8fafc;border-top:1px solid #e2e8f0}
.pm-modal-btn{display:inline-flex;align-items:center;gap:6px;padding:8px 14px;border-radius:8px;font-size:12.5px;font-weight:700;border:none;cursor:pointer;transition:.15s}
.pm-modal-btn.secondary{background:#fff;border:1px solid #cbd5e1;color:#475569}
.pm-modal-btn.secondary:hover{background:#f1f5f9}
.pm-modal-btn.danger{background:#dc2626;color:#fff}
.pm-modal-btn.danger:hover{background:#b91c1c}
.pm-modal-btn.success{background:#16a34a;color:#fff}
.pm-modal-btn.success:hover{background:#15803d}
.pm-modal-btn.primary{background:#007a5e;color:#fff}
.pm-modal-btn.primary:hover{background:#00624b}

/* Timeline & Governance in History Modal */
.pm-history-profile-card{padding:14px 16px;border-radius:12px;background:#f8fafc;border:1px solid #e2e8f0;margin-bottom:12px}
.pm-hist-name{font-size:15px;color:#0f243d;display:block}
.pm-hist-tags{display:flex;align-items:center;gap:8px;margin-top:6px;flex-wrap:wrap}
.pm-hist-nik{font-family:monospace;font-size:12px;color:#475569}
.pm-governance-banner{display:flex;align-items:flex-start;gap:10px;padding:10px 14px;background:#f0fdf4;border:1px solid #bbf7d0;border-radius:10px;margin-bottom:16px}
.pm-governance-banner strong{display:block;font-size:12px;color:#166534}
.pm-governance-banner span{display:block;font-size:11.5px;color:#15803d;line-height:1.4;margin-top:2px}
.pm-timeline{position:relative;padding-left:26px;display:flex;flex-direction:column;gap:14px}
.pm-timeline::before{content:"";position:absolute;left:8px;top:6px;bottom:6px;width:2px;background:#e2e8f0}
.pm-timeline-item{position:relative}
.pm-timeline-dot{position:absolute;left:-26px;top:4px;width:18px;height:18px;border-radius:50%;background:#fff;border:3px solid #94a3b8;display:flex;align-items:center;justify-content:center}
.pm-timeline-dot.create{border-color:#10b981;background:#ecfdf5}
.pm-timeline-dot.update{border-color:#3b82f6;background:#eff6ff}
.pm-timeline-dot.deactivate{border-color:#ef4444;background:#fef2f2}
.pm-timeline-dot.reactivate{border-color:#10b981;background:#ecfdf5}
.pm-timeline-card{background:#fff;border:1px solid #e2e8f0;border-radius:11px;padding:12px 14px;box-shadow:0 2px 8px rgba(0,0,0,.03)}
.pm-timeline-header{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:4px}
.pm-timeline-action{font-size:11.5px;font-weight:800;text-transform:uppercase;letter-spacing:.04em}
.pm-timeline-action.create{color:#059669}
.pm-timeline-action.update{color:#2563eb}
.pm-timeline-action.deactivate{color:#dc2626}
.pm-timeline-action.reactivate{color:#059669}
.pm-timeline-date{font-size:11px;color:#64748b}
.pm-timeline-desc{font-size:12.5px;color:#334155;line-height:1.45;margin:0}
.pm-timeline-actor{font-size:11px;color:#94a3b8;margin-top:5px;display:block}
.pm-last-update-tag{display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border-radius:6px;background:#f1f5f9;border:1px solid #cbd5e1;font-size:11.5px;font-weight:700;color:#1e293b}
.pm-period-status-box{padding:10px 12px;border-radius:9px;margin-top:8px;font-size:12px;line-height:1.45}
.pm-period-status-box.success{background:#f0fdf4;border:1px solid #bbf7d0;color:#166534}
.pm-period-status-box.info{background:#f0f9ff;border:1px solid #bae6fd;color:#0369a1}
.pm-period-status-box strong{display:block;font-size:12px;margin-bottom:2px}
.pm-diff-toggle-btn{display:inline-flex;align-items:center;gap:5px;padding:4px 9px;border-radius:6px;background:#f8fafc;border:1px solid #cbd5e1;color:#2563eb;font-size:11.5px;font-weight:700;cursor:pointer;margin-top:8px;transition:.15s}
.pm-diff-toggle-btn:hover{background:#eff6ff;border-color:#93c5fd}
.pm-diff-box{margin-top:8px;padding:10px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;font-size:11.5px}
.pm-diff-table{width:100%;border-collapse:collapse;margin-top:4px}
.pm-diff-table th{text-align:left;padding:5px 8px;font-size:10.5px;font-weight:800;color:#64748b;text-transform:uppercase;border-bottom:1px solid #e2e8f0;background:#f1f5f9}
.pm-diff-table td{padding:5px 8px;border-bottom:1px solid #f1f5f9;font-size:11.5px;vertical-align:middle}
.pm-diff-table td.val-old{color:#dc2626;text-decoration:line-through}
.pm-diff-table td.val-new{color:#15803d;font-weight:700}

/* Monthly Grouping for Audit History Timeline */
.pm-month-card{margin-bottom:14px;border:1px solid #e2e8f0;border-radius:12px;background:#fff;overflow:hidden;box-shadow:0 1px 4px rgba(0,0,0,.03)}
.pm-month-header{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:9px 14px;background:#f8fafc;border-bottom:1px solid #e2e8f0}
.pm-month-title{display:flex;align-items:center;gap:7px;font-size:12.5px;font-weight:800;color:#0f172a}
.pm-month-badge{font-size:11px;font-weight:700;padding:2px 8px;border-radius:10px}
.pm-month-badge.has-changes{background:#e0f2fe;color:#0369a1;border:1px solid #bae6fd}
.pm-month-badge.stable{background:#dcfce7;color:#15803d;border:1px solid #86efac}
.pm-month-badge.register{background:#fef3c7;color:#92400e;border:1px solid #fde68a}
.pm-month-body{padding:12px 14px;display:flex;flex-direction:column;gap:12px}
.pm-month-empty-text{font-size:12px;color:#166534;line-height:1.45}

/* Quick BGN Action Panel inside Modal */
.pm-history-bgn-actions{display:flex;align-items:center;gap:8px;margin-right:auto}

/* Loading & Empty */
.pm-loading-state{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:32px;gap:10px;color:#64748b;font-size:13px}
.pm-spinner{width:26px;height:26px;border:3px solid #e2e8f0;border-top-color:#007a5e;border-radius:50%;animation:pmSpin .65s linear infinite}
.pm-empty-timeline{text-align:center;padding:28px 16px;background:#f8fafc;border-radius:12px;border:1px dashed #cbd5e1}

/* Animations */
@keyframes pmFadeIn{from{opacity:0}to{opacity:1}}
@keyframes pmSlideUp{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
@keyframes pmSpin{to{transform:rotate(360deg)}}

/* Responsive */
@media(max-width:768px){
  .pm-toolbar{flex-direction:column;align-items:stretch}
  .pm-search-wrap{max-width:100%}
  .pm-cat-tabs{overflow-x:auto;padding-bottom:6px}
  .pm-action-group{flex-direction:column;gap:4px}
}
</style>

<!-- ============================================================== -->
<!-- JAVASCRIPT LOGIC PM MANAGEMENT -->
<!-- ============================================================== -->
<script>
(function(){
  var isPreview = <%= previewMode ? 'true' : 'false' %>;
  var kpmId = <%= access.kpm_id %>;
  var token = "<%= portalToken || '' %>";
  var isPosyandu = <%= isPosyandu ? 'true' : 'false' %>;

  // 1. Filter Kategori, Sub-Kelompok, Status & Pencarian Instan
  var searchInput = document.getElementById('pmSearchInput');
  var catTabs = document.querySelectorAll('.pm-tab-btn');
  var statusSelect = document.getElementById('pmStatusSelect');
  var rows = document.querySelectorAll('.pm-row');
  var emptyRow = document.getElementById('pmEmptyRow');
  var clusterBar = document.getElementById('pmPosyanduClusterBar');
  var clusterTitle = document.getElementById('pmClusterCategoryTitle');
  var clusterMetrics = document.getElementById('pmClusterMetrics');
  var clusterSubNav = document.getElementById('pmClusterSubNav');
  var groupHeaderCol = document.getElementById('pmGroupHeaderCol');

  // Read URL params if exists (e.g. ?cat=BALITA or #pm-management-section)
  var urlParams = new URLSearchParams(window.location.search);
  var initialCat = urlParams.get('cat') ? urlParams.get('cat').toUpperCase() : 'ALL';

  var currentCat = initialCat;
  var currentSubCat = 'ALL';
  var currentStatus = 'ACTIVE'; // default aktif saja agar rapi
  var currentQuery = '';

  var posyanduClusters = {
    BALITA: {
      title: 'Kelompok Balita · 100% Standar Porsi Kecil',
      headerLabel: 'Tahapan Usia Balita',
      subgroups: [
        { key: 'ALL', label: 'Semua Balita' },
        { key: '0-5', label: '0–5 Bulan (Bayi)' },
        { key: '6-23', label: '6–23 Bulan (Baduta)' },
        { key: '24-59', label: '24–59 Bulan (Balita)' }
      ]
    },
    BUMIL: {
      title: 'Kelompok Ibu Hamil (Bumil) · 100% Standar Porsi Besar',
      headerLabel: 'Usia Kehamilan / Trimester',
      subgroups: [
        { key: 'ALL', label: 'Semua Bumil' },
        { key: 'trimester 1', label: 'Trimester 1 (1–12 Minggu)' },
        { key: 'trimester 2', label: 'Trimester 2 (13–27 Minggu)' },
        { key: 'trimester 3', label: 'Trimester 3 (28–40 Minggu)' }
      ]
    },
    BUSUI: {
      title: 'Kelompok Ibu Menyusui (Busui) · 100% Standar Porsi Besar',
      headerLabel: 'Usia Bayi yang Disusui',
      subgroups: [
        { key: 'ALL', label: 'Semua Busui' },
        { key: '0–6', label: 'Bayi 0–6 Bulan (ASI Eksklusif)' },
        { key: '7–12', label: 'Bayi 7–12 Bulan' },
        { key: '13–24', label: 'Bayi 13–24 Bulan' }
      ]
    }
  };

  function updateClusterBar(){
    if(!isPosyandu || !clusterBar) return;

    if(currentCat === 'ALL'){
      if(clusterTitle) clusterTitle.textContent = 'Seluruh Penerima Manfaat Posyandu Terpadu';
      if(groupHeaderCol) groupHeaderCol.textContent = 'Sub-Kelompok';

      var bCount = 0, bumilCount = 0, busuiCount = 0;
      rows.forEach(function(r){
        var c = r.getAttribute('data-cat');
        var act = r.getAttribute('data-status') === 'ACTIVE';
        if(currentStatus === 'ACTIVE' && !act) return;
        if(c === 'BALITA') bCount++;
        else if(c === 'BUMIL') bumilCount++;
        else if(c === 'BUSUI') busuiCount++;
      });

      if(clusterMetrics){
        clusterMetrics.innerHTML = 
          '<span class="pm-cluster-badge" style="background:#f1f5f9;color:#334155;border-color:#cbd5e1;font-weight:700">Total: ' + (bCount + bumilCount + busuiCount) + ' PM</span>' +
          '<span class="pm-cluster-badge" style="background:#ecfdf5;color:#065f46;border-color:#a7f3d0;font-weight:700">Porsi Kecil: ' + bCount + '</span>' +
          '<span class="pm-cluster-badge amber" style="font-weight:700">Porsi Besar: ' + (bumilCount + busuiCount) + '</span>';
      }

      if(clusterSubNav){
        clusterSubNav.innerHTML = '';
        clusterSubNav.style.display = 'none';
      }
      return;
    }

    var cfg = posyanduClusters[currentCat];
    if(!cfg) return;

    if(clusterTitle) clusterTitle.textContent = cfg.title;
    if(groupHeaderCol) groupHeaderCol.textContent = 'Sub-Kelompok';
    if(clusterSubNav) clusterSubNav.style.display = 'flex';

    var lCount = 0, pCount = 0, totalInCat = 0;
    var subCounts = {};
    cfg.subgroups.forEach(function(sg){ subCounts[sg.key] = 0; });

    rows.forEach(function(r){
      var rCat = r.getAttribute('data-cat') || '';
      if(rCat !== currentCat) return;
      var act = r.getAttribute('data-status') === 'ACTIVE';
      if(currentStatus === 'ACTIVE' && !act) return;
      totalInCat++;
      var g = r.getAttribute('data-gender');
      if(g === 'L') lCount++;
      else if(g === 'P') pCount++;
      var sc = (r.getAttribute('data-subcat') || '').toLowerCase();
      cfg.subgroups.forEach(function(sg){
        if(sg.key === 'ALL') subCounts['ALL']++;
        else if(sc.indexOf(sg.key.toLowerCase()) !== -1) subCounts[sg.key]++;
      });
    });

    if(clusterMetrics){
      if(currentCat === 'BALITA'){
        clusterMetrics.innerHTML = 
          '<span class="pm-cluster-badge">Porsi Kecil: ' + totalInCat + '</span>' +
          '<span class="pm-cluster-badge blue">Laki-laki (L): ' + lCount + '</span>' +
          '<span class="pm-cluster-badge amber">Perempuan (P): ' + pCount + '</span>';
      } else {
        clusterMetrics.innerHTML = 
          '<span class="pm-cluster-badge">Porsi Besar: ' + totalInCat + '</span>' +
          '<span class="pm-cluster-badge amber">Perempuan (P): ' + pCount + '</span>';
      }
    }

    if(clusterSubNav){
      var navHtml = '<button type="button" class="pm-subcat-btn" style="background:#f1f5f9;color:#475569" onclick="window.setPmCategory(\'ALL\')">← Kembali ke Semua</button>';
      cfg.subgroups.forEach(function(sg){
        var isAct = currentSubCat === sg.key;
        var cnt = subCounts[sg.key] !== undefined ? subCounts[sg.key] : 0;
        navHtml += '<button type="button" class="pm-subcat-btn ' + (isAct ? 'active' : '') + '" data-sub="' + sg.key + '">' +
                     '<span>' + sg.label + '</span>' +
                     '<span class="pm-subcat-count">' + cnt + '</span>' +
                   '</button>';
      });
      clusterSubNav.innerHTML = navHtml;

      clusterSubNav.querySelectorAll('.pm-subcat-btn').forEach(function(btn){
        btn.addEventListener('click', function(){
          currentSubCat = btn.getAttribute('data-sub') || 'ALL';
          clusterSubNav.querySelectorAll('.pm-subcat-btn').forEach(function(b){ b.classList.remove('active'); });
          btn.classList.add('active');
          applyFilters();
        });
      });
    }
  }

  function applyFilters(){
    var visibleCount = 0;
    rows.forEach(function(row){
      var rowCat = (row.getAttribute('data-cat') || '').toUpperCase();
      var rowSubCat = (row.getAttribute('data-subcat') || '').toLowerCase();
      var rowStatus = row.getAttribute('data-status') || '';
      var rowSearch = (row.getAttribute('data-search') || '').toLowerCase();

      var matchCat = (currentCat === 'ALL') || (rowCat === currentCat);
      var matchSubCat = true;
      if (currentCat !== 'ALL' && currentSubCat !== 'ALL') {
        matchSubCat = (rowSubCat.indexOf(currentSubCat.toLowerCase()) !== -1) ||
                      (currentSubCat === '0-5' && (rowSubCat.indexOf('0–5') !== -1 || rowSubCat.indexOf('bayi') !== -1)) ||
                      (currentSubCat === '6-23' && (rowSubCat.indexOf('6–23') !== -1 || rowSubCat.indexOf('baduta') !== -1)) ||
                      (currentSubCat === '24-59' && (rowSubCat.indexOf('24–59') !== -1 || rowSubCat.indexOf('balita') !== -1));
      }

      var matchStatus = (currentStatus === 'ALL') || 
                        (currentStatus === 'ACTIVE' && rowStatus === 'ACTIVE') || 
                        (currentStatus === 'PENDING' && rowStatus === 'PENDING') || 
                        (currentStatus === 'INACTIVE' && rowStatus === 'INACTIVE');
      var matchQuery = !currentQuery || (rowSearch.indexOf(currentQuery) !== -1);

      if(matchCat && matchSubCat && matchStatus && matchQuery){
        row.style.display = '';
        visibleCount++;
        var idxCell = row.querySelector('.pm-row-index');
        if(idxCell) idxCell.textContent = visibleCount;
      } else {
        row.style.display = 'none';
      }
    });

    if(emptyRow){
      emptyRow.style.display = visibleCount === 0 ? '' : 'none';
    }
  }

  // Handler Tab Kategori
  function setCategory(cat){
    if (window.PMGrouper) {
      window.PMGrouper.filter(cat, 'ALL');
      return;
    }
    currentCat = (cat || 'ALL').toUpperCase();
    currentSubCat = 'ALL';

    catTabs.forEach(function(t){
      var btnCat = (t.getAttribute('data-cat') || '').toUpperCase();
      if(btnCat === currentCat){
        t.classList.add('active');
      } else {
        t.classList.remove('active');
      }
    });

    updateClusterBar();
    applyFilters();
  }
  window.setPmCategory = setCategory;

  // Event listener tab kategori di toolbar
  catTabs.forEach(function(tab){
    tab.addEventListener('click', function(e){
      e.preventDefault();
      var cat = tab.getAttribute('data-cat') || 'ALL';
      setCategory(cat);
    });
  });

  // Event listener search input
  if(searchInput){
    searchInput.addEventListener('input', function(){
      currentQuery = (searchInput.value || '').toLowerCase().trim();
      applyFilters();
    });
  }

  // Event listener status filter
  if(statusSelect){
    statusSelect.addEventListener('change', function(){
      currentStatus = statusSelect.value || 'ALL';
      updateClusterBar();
      applyFilters();
    });
  }

  // Inisialisasi awal
  if(initialCat !== 'ALL'){
    setCategory(initialCat);
    var sec = document.getElementById('pm-management-section');
    if(sec){
      setTimeout(function(){
        sec.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }, 120);
    }
  } else {
    updateClusterBar();
    applyFilters();
  }

  // 2. Handler Modal Soft Delete (Hapus / Nonaktifkan)
  var deactModal = document.getElementById('pmDeactivateModal');
  var deactForm = document.getElementById('pmDeactivateForm');
  var deactTargetName = document.getElementById('deactTargetName');
  var deactTargetMeta = document.getElementById('deactTargetMeta');
  var deactModalTitle = document.getElementById('deactModalTitle');
  var deactModalSubtitle = document.getElementById('deactModalSubtitle');
  var deactSubmitBtnText = document.getElementById('deactSubmitBtnText');
  var deactReasonSelect = document.getElementById('deactReasonSelect');
  var deactCustomField = document.getElementById('deactCustomField');
  var deactCustomNote = document.getElementById('deactCustomNote');

  window.openDeactivateModal = function(id, name, nik, cat, isAdmin){
    if(deactTargetName) deactTargetName.textContent = name || '-';
    if(deactTargetMeta) deactTargetMeta.textContent = 'NIK: ' + (nik || '-') + ' · Kategori: ' + (cat || '').replace(/_/g, ' ');
    if(deactReasonSelect) deactReasonSelect.value = '';
    if(deactCustomField) deactCustomField.style.display = 'none';
    if(deactCustomNote) deactCustomNote.value = '';

    if(isAdmin){
      if(deactModalTitle) deactModalTitle.textContent = 'Nonaktifkan Penerima Manfaat (Otorisasi Kepala BGN)';
      if(deactModalSubtitle) deactModalSubtitle.textContent = 'Menonaktifkan data secara langsung dan mencatatnya ke arsip riwayat resmi.';
      if(deactSubmitBtnText) deactSubmitBtnText.textContent = 'Nonaktifkan & Simpan ke Arsip';
      deactForm.action = '/portal/kpm/preview/' + kpmId + '/pm/' + id + '/status';
    } else {
      if(deactModalTitle) deactModalTitle.textContent = 'Ajukan Penonaktifan ke Kepala BGN';
      if(deactModalSubtitle) deactModalSubtitle.textContent = 'Data akan dicatat di riwayat dan menunggu keputusan resmi Kepala / Admin BGN.';
      if(deactSubmitBtnText) deactSubmitBtnText.textContent = 'Kirim Permohonan ke Kepala BGN';
      deactForm.action = '/portal/kpm/' + token + '/pm/' + id + '/status';
    }

    if(deactModal) deactModal.style.display = 'flex';
  };

  window.closeDeactivateModal = function(){
    if(deactModal) deactModal.style.display = 'none';
  };

  if(deactReasonSelect){
    deactReasonSelect.addEventListener('change', function(){
      if(deactCustomField){
        deactCustomField.style.display = (deactReasonSelect.value === 'Lainnya') ? 'block' : 'none';
      }
    });
  }

  if(deactForm){
    deactForm.addEventListener('submit', function(e){
      if(deactReasonSelect.value === 'Lainnya' && deactCustomNote && deactCustomNote.value.trim()){
        deactReasonSelect.options[deactReasonSelect.selectedIndex].value = 'Lainnya: ' + deactCustomNote.value.trim();
      }
    });
  }

  // 3. Handler Modal Otorisasi BGN: Setujui
  var approveModal = document.getElementById('bgnApproveModal');
  var approveForm = document.getElementById('bgnApproveForm');
  var approveTargetName = document.getElementById('approveTargetName');
  var approveTargetReason = document.getElementById('approveTargetReason');

  window.openBgnApproveModal = function(id, name, reason){
    if(approveTargetName) approveTargetName.textContent = name || '-';
    if(approveTargetReason) approveTargetReason.textContent = reason ? ('Alasan dari Kader: ' + reason) : 'Alasan dari Kader: Tidak dicantumkan';
    if(approveForm) approveForm.action = '/portal/kpm/preview/' + kpmId + '/pm/' + id + '/status';
    if(approveModal) approveModal.style.display = 'flex';
  };

  window.closeBgnApproveModal = function(){
    if(approveModal) approveModal.style.display = 'none';
  };

  // 4. Handler Modal Otorisasi BGN: Batalkan / Tolak
  var rejectModal = document.getElementById('bgnRejectModal');
  var rejectForm = document.getElementById('bgnRejectForm');
  var rejectTargetName = document.getElementById('rejectTargetName');
  var rejectTargetReason = document.getElementById('rejectTargetReason');

  window.openBgnRejectModal = function(id, name, reason){
    if(rejectTargetName) rejectTargetName.textContent = name || '-';
    if(rejectTargetReason) rejectTargetReason.textContent = reason ? ('Alasan pengajuan sebelumnya: ' + reason) : 'Alasan sebelumnya: Tidak dicantumkan';
    if(rejectForm) rejectForm.action = '/portal/kpm/preview/' + kpmId + '/pm/' + id + '/status';
    if(rejectModal) rejectModal.style.display = 'flex';
  };

  window.closeBgnRejectModal = function(){
    if(rejectModal) rejectModal.style.display = 'none';
  };

  // 5. Handler Modal Reactivate / Pulihkan Data
  var reactModal = document.getElementById('pmReactivateModal');
  var reactForm = document.getElementById('pmReactivateForm');
  var reactTargetName = document.getElementById('reactTargetName');
  var reactTargetMeta = document.getElementById('reactTargetMeta');
  var reactTargetPrevReason = document.getElementById('reactTargetPrevReason');

  window.openReactivateModal = function(id, name, nik, prevReason){
    if(reactTargetName) reactTargetName.textContent = name || '-';
    if(reactTargetMeta) reactTargetMeta.textContent = 'NIK: ' + (nik || '-');
    if(reactTargetPrevReason){
      reactTargetPrevReason.textContent = prevReason ? ('Alasan nonaktif: ' + prevReason) : 'Alasan nonaktif sebelumnya: Tidak tercatat';
    }

    if(reactForm) reactForm.action = '/portal/kpm/preview/' + kpmId + '/pm/' + id + '/status';
    if(reactModal) reactModal.style.display = 'flex';
  };

  window.closeReactivateModal = function(){
    if(reactModal) reactModal.style.display = 'none';
  };

  // 6. Handler Modal History Rekam Jejak
  var histModal = document.getElementById('pmHistoryModal');
  var histProfileName = document.getElementById('histProfileName');
  var histProfileNik = document.getElementById('histProfileNik');
  var histProfileCat = document.getElementById('histProfileCat');
  var histProfileSubgroup = document.getElementById('histProfileSubgroup');
  var histProfileStatus = document.getElementById('histProfileStatus');
  var histLastUpdateBadge = document.getElementById('histLastUpdateBadge');
  var histGovernanceBanner = document.getElementById('histGovernanceBanner');
  var histLoading = document.getElementById('pmHistoryLoading');
  var histTimeline = document.getElementById('pmHistoryTimeline');
  var histEmpty = document.getElementById('pmHistoryEmpty');
  var histFoot = document.getElementById('pmHistoryModalFoot');

  function fmtIdDate(dtStr){
    if(!dtStr) return '-';
    var d = new Date(dtStr);
    if(isNaN(d.getTime())) return dtStr;
    return d.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
  }

  function fmtShortDate(dtStr){
    if(!dtStr) return '-';
    var d = new Date(dtStr);
    if(isNaN(d.getTime())) return dtStr;
    return d.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
  }

  function getDayBefore(dtStr){
    if(!dtStr) return '';
    var d = new Date(dtStr);
    d.setDate(d.getDate() - 1);
    return d.toISOString().slice(0, 10);
  }

  window.togglePmDiff = function(diffId){
    var el = document.getElementById(diffId);
    if(el){
      el.style.display = el.style.display === 'none' ? 'block' : 'none';
    }
  };

  // Centralized action handler for all PM table buttons (Anti-Bentrok)
  window.handlePmAction = function(btn, event){
    if(event){
      if(typeof event.stopPropagation === 'function') event.stopPropagation();
    }
    if(!btn) return;

    var action = btn.getAttribute('data-action');
    var id = btn.getAttribute('data-pm-id');
    var name = btn.getAttribute('data-pm-name') || '';
    var nik = btn.getAttribute('data-pm-nik') || '-';
    var cat = btn.getAttribute('data-pm-cat') || '';
    var reason = btn.getAttribute('data-pm-reason') || '';
    var isAdmin = btn.getAttribute('data-is-admin') === 'true';
    var isAct = btn.getAttribute('data-pm-act') === '1';
    var status = btn.getAttribute('data-pm-status') || '';
    var subgroup = btn.getAttribute('data-pm-subgroup') || '';

    if(action === 'history'){
      openHistoryModal(id, name, nik, cat, isAct, status, subgroup);
    } else if(action === 'deactivate'){
      openDeactivateModal(id, name, nik, cat, isAdmin);
    } else if(action === 'reactivate'){
      openReactivateModal(id, name, nik, reason);
    } else if(action === 'bgn-approve'){
      openBgnApproveModal(id, name, reason);
    } else if(action === 'bgn-reject'){
      openBgnRejectModal(id, name, reason);
    }
  };

  // Delegated click listener on document for maximum resilience
  document.addEventListener('click', function(e){
    var btn = e.target && e.target.closest ? e.target.closest('.pm-btn[data-action]') : null;
    if(btn){
      window.handlePmAction(btn, e);
    }
  });

  window.openHistoryModal = function(id, name, nik, cat, isAct, approvalStatus, subGroup){
    if(histProfileName) histProfileName.textContent = name || '-';
    if(histProfileNik) histProfileNik.textContent = 'NIK: ' + (nik || '-');
    if(histProfileCat) histProfileCat.textContent = (cat || '').replace(/_/g, ' ');
    if(histProfileSubgroup) histProfileSubgroup.textContent = subGroup || '-';
    if(histLastUpdateBadge) histLastUpdateBadge.textContent = '📅 Memuat update terakhir...';
    
    if(histProfileStatus){
      if(approvalStatus === 'MENUNGGU_VERIFIKASI_BGN'){
        histProfileStatus.className = 'pm-badge-pending';
        histProfileStatus.innerHTML = '<span class="pm-dot-amber"></span> Menunggu Otorisasi BGN';
      } else if(isAct){
        histProfileStatus.className = 'pm-badge-active';
        histProfileStatus.innerHTML = '<span class="pm-dot-green"></span> Aktif';
      } else {
        histProfileStatus.className = 'pm-badge-inactive';
        histProfileStatus.innerHTML = '<span class="pm-dot-gray"></span> Nonaktif (Arsip)';
      }
    }

    if(histTimeline) { histTimeline.innerHTML = ''; histTimeline.style.display = 'none'; }
    if(histEmpty) histEmpty.style.display = 'none';
    if(histLoading) histLoading.style.display = 'flex';
    if(histModal) histModal.style.display = 'flex';

    if(histFoot){
      histFoot.innerHTML = '<button type="button" class="pm-modal-btn primary" onclick="closeHistoryModal()">Tutup</button>';
    }

    var historyUrl = (isPreview || !token) ? 
      ('/portal/kpm/preview/' + kpmId + '/pm/' + id + '/history') : 
      ('/portal/kpm/' + token + '/pm/' + id + '/history');

    fetch(historyUrl)
      .then(function(res){
        if(!res.ok) throw new Error('Data tidak ditemukan pada ruang privat KPM ini.');
        return res.json();
      })
      .then(function(data){
        if(histLoading) histLoading.style.display = 'none';
        var historyList = (data && data.history) ? data.history : [];
        var pmData = data.pm || {};
        var isBgnAdmin = !!data.isBgnAdmin;

        if(pmData.class_group && histProfileSubgroup){
          histProfileSubgroup.textContent = pmData.class_group;
        }

        // Tentukan Tanggal Update Terakhir
        var latestUpdate = pmData.updated_at || pmData.created_at;
        if(historyList.length){
          var newestHist = historyList[0];
          latestUpdate = newestHist.effective_from || newestHist.created_at || latestUpdate;
        }
        if(histLastUpdateBadge){
          histLastUpdateBadge.textContent = '📅 Update Terakhir: ' + fmtIdDate(latestUpdate);
        }

        // Banner Hak Akses & Integritas Rekam Jejak
        if(histGovernanceBanner){
          if(isBgnAdmin){
            histGovernanceBanner.style.background = '#f0fdf4';
            histGovernanceBanner.style.borderColor = '#86efac';
            histGovernanceBanner.innerHTML = 
              '<span style="font-size:18px">👑</span>' +
              '<div>' +
                '<strong style="color:#15803d;font-size:12.5px">Kendali Penuh Kepala / Admin BGN</strong>' +
                '<span style="display:block;color:#166534;font-size:11.5px;margin-top:2px;line-height:1.45">' +
                  'Anda memiliki hak wewenang penuh atas riwayat ini (pengesahan permohonan, pembatalan, pemulihan data). Data riwayat dilindungi oleh sistem audit BGN dan tidak dapat dimanipulasi.' +
                '</span>' +
              '</div>';
          } else {
            histGovernanceBanner.style.background = '#fffbeb';
            histGovernanceBanner.style.borderColor = '#fde68a';
            histGovernanceBanner.innerHTML = 
              '<span style="font-size:18px">🔒</span>' +
              '<div>' +
                '<strong style="color:#92400e;font-size:12.5px">Catatan Dilindungi · Tidak Dapat Dihapus oleh Pengguna Umum</strong>' +
                '<span style="display:block;color:#b45309;font-size:11.5px;margin-top:2px;line-height:1.45">' +
                  'Riwayat perubahan data ini tersimpan permanen dan <strong>tidak dapat dihapus</strong> oleh pengguna umum / kader. Seluruh kendali pengesahan dan pemulihan berada di bawah otoritas <strong>Kepala BGN</strong>.' +
                '</span>' +
              '</div>';
          }
        }

        // 1. Helper Format Bulan & Tanggal
        function getYM(dateStr){
          if(!dateStr) return '';
          var d = new Date(dateStr);
          if(isNaN(d.getTime())) return '';
          var y = d.getFullYear();
          var m = String(d.getMonth() + 1).padStart(2, '0');
          return y + '-' + m;
        }

        function getMonthName(ym){
          if(!ym) return '-';
          var parts = ym.split('-');
          var y = parseInt(parts[0], 10);
          var m = parseInt(parts[1], 10) - 1;
          var d = new Date(y, m, 1);
          return d.toLocaleDateString('id-ID', { month: 'long', year: 'numeric' });
        }

        var regDate = pmData.created_at ? new Date(pmData.created_at).toISOString().slice(0, 10) : '';
        var regYM = getYM(regDate);

        // Kumpulkan semua record perubahan dan urutkan dari terbaru ke terlama
        var allEvents = historyList.slice().sort(function(a,b){
          var da = new Date(a.effective_from || a.created_at || 0).getTime();
          var db = new Date(b.effective_from || b.created_at || 0).getTime();
          return db - da;
        });

        // Tentukan batas atas bulan (bulan saat ini atau bulan update terakhir)
        var latestDateStr = new Date().toISOString().slice(0, 10);
        if(allEvents.length){
          var newestEventDate = allEvents[0].effective_from || allEvents[0].created_at;
          if(newestEventDate && String(newestEventDate).slice(0, 10) > latestDateStr){
            latestDateStr = String(newestEventDate).slice(0, 10);
          }
        }
        var topYM = getYM(latestDateStr);

        // Bangun rentang bulan dari bulan terkini mundur ke bulan pendaftaran
        var monthsList = [];
        if(topYM){
          var curY = parseInt(topYM.split('-')[0], 10);
          var curM = parseInt(topYM.split('-')[1], 10) - 1;
          
          var targetY = curY;
          var targetM = curM;
          if(regYM){
            targetY = parseInt(regYM.split('-')[0], 10);
            targetM = parseInt(regYM.split('-')[1], 10) - 1;
          } else {
            targetM = curM - 3;
            if(targetM < 0){ targetM += 12; targetY--; }
          }

          var countSafety = 0;
          while(countSafety < 12){
            countSafety++;
            var ymStr = curY + '-' + String(curM + 1).padStart(2, '0');
            monthsList.push(ymStr);
            if(curY === targetY && curM === targetM) break;
            if(curY < targetY || (curY === targetY && curM < targetM)) break;
            curM--;
            if(curM < 0){ curM = 11; curY--; }
          }
        }

        // Kelompokkan event ke dalam bulan masing-masing
        var eventsByMonth = {};
        allEvents.forEach(function(ev){
          var evYM = getYM(ev.effective_from || ev.created_at);
          if(!eventsByMonth[evYM]) eventsByMonth[evYM] = [];
          eventsByMonth[evYM].push(ev);
          if(monthsList.indexOf(evYM) === -1){
            monthsList.push(evYM);
          }
        });

        // Urutkan daftar bulan dari terbaru ke terlama
        monthsList.sort(function(a,b){ return b.localeCompare(a); });

        var html = '';

        // Kasus Khusus: Jika sedang menunggu otorisasi penonaktifan dari BGN
        if(pmData.approval_status === 'MENUNGGU_VERIFIKASI_BGN'){
          html += '<div class="pm-month-card" style="border:1.5px solid #f59e0b;background:#fffdfa">' +
                    '<div class="pm-month-header" style="background:#fef3c7;border-bottom:1px solid #fde68a">' +
                      '<div class="pm-month-title" style="color:#92400e">' +
                        '<span style="font-size:16px">⏳</span>' +
                        '<span>Permohonan Penonaktifan Sedang Menunggu Otorisasi BGN</span>' +
                      '</div>' +
                      '<span class="pm-month-badge" style="background:#fef3c7;color:#92400e;border:1px solid #fde68a">Menunggu Otorisasi BGN</span>' +
                    '</div>' +
                    '<div class="pm-month-body">' +
                      '<div class="pm-period-status-box" style="background:#fffbeb;border:1px solid #fde68a;color:#92400e">' +
                        '<strong>Diajukan oleh Kader pada: ' + fmtIdDate(pmData.deactivated_at || new Date()) + '</strong>' +
                        '<span><strong>Alasan yang diajukan:</strong> ' + (pmData.deactivation_reason || 'Diajukan penonaktifan.') + '</span>' +
                        '<span style="display:block;margin-top:4px;font-size:11.5px;color:#b45309">Catatan ini memerlukan pengesahan resmi dari Kepala BGN sebelum data resmi dinonaktifkan.</span>' +
                      '</div>' +
                    '</div>' +
                  '</div>';
        }

        // Kasus jika belum ada catatan perubahan sejak pendaftaran pertama (Data Stabil Murni)
        if(!allEvents.length && pmData.approval_status !== 'MENUNGGU_VERIFIKASI_BGN'){
          html += '<div class="pm-month-card" style="border:1px solid #86efac">' +
                    '<div class="pm-month-header" style="background:#f0fdf4;border-bottom:1px solid #bbf7d0">' +
                      '<div class="pm-month-title" style="color:#166534">' +
                        '<span style="font-size:16px">📂</span>' +
                        '<span>Bulan ' + getMonthName(topYM) + ' (Status Berjalan)</span>' +
                      '</div>' +
                      '<span class="pm-month-badge stable">✅ Data Stabil (0 Perubahan)</span>' +
                    '</div>' +
                    '<div class="pm-month-body">' +
                      '<div class="pm-period-status-box success">' +
                        '<strong>✅ Sejak tanggal pendaftaran (' + fmtIdDate(regDate) + ') hingga saat ini, tidak ada perubahan data apa pun.</strong>' +
                        '<span>Penerima manfaat aktif menerima paket pemenuhan gizi secara normal sesuai data pendaftaran awal tanpa pernah ada mutasi atau kendala.</span>' +
                      '</div>' +
                      '<span class="pm-timeline-actor">Dicatat oleh Sistem Master PM · Ruang ' + (pmData.kpm_name || 'KPM') + '</span>' +
                    '</div>' +
                  '</div>';
        } else {
          // Render setiap bulan secara terstruktur
          monthsList.forEach(function(ym){
            var monthName = getMonthName(ym);
            var mEvents = eventsByMonth[ym] || [];
            var count = mEvents.length;
            var isRegMonth = (ym === regYM);

            html += '<div class="pm-month-card">' +
                      '<div class="pm-month-header">' +
                        '<div class="pm-month-title">' +
                          '<span style="font-size:16px">📂</span>' +
                          '<span>Bulan ' + monthName + '</span>' +
                        '</div>';

            if(count > 0){
              html += '<span class="pm-month-badge has-changes">⚡ ' + count + ' Perubahan Tercatat</span>';
            } else if(isRegMonth){
              html += '<span class="pm-month-badge register">Pendaftaran Pertama</span>';
            } else {
              html += '<span class="pm-month-badge stable">✅ Data Stabil (0 Perubahan)</span>';
            }

            html +=   '</div>' +
                      '<div class="pm-month-body">';

            if(count > 0){
              // Tampilkan setiap perubahan pada bulan ini berurutan per tanggal
              mEvents.forEach(function(h, idx){
                var curEff = h.effective_from ? String(h.effective_from).slice(0, 10) : String(h.created_at).slice(0, 10);
                var actType = h.action || 'UPDATE';
                var actTitle = actType === 'CREATE' ? 'Pendaftaran Pertama' :
                               actType === 'DEACTIVATE' ? 'Penonaktifan Data' :
                               actType === 'REACTIVATE' ? 'Pemulihan Data (Aktif Kembali)' : 'Pembaruan Data PM';
                var dotCls = actType.toLowerCase();

                // Perbandingan data sebelum vs sesudah
                var bData = {};
                var aData = {};
                try{ if(h.before_data) bData = typeof h.before_data === 'string' ? JSON.parse(h.before_data) : h.before_data; }catch(e){}
                try{ if(h.after_data) aData = typeof h.after_data === 'string' ? JSON.parse(h.after_data) : h.after_data; }catch(e){}

                var diffRows = [];
                if(bData.full_name && aData.full_name && bData.full_name !== aData.full_name){
                  diffRows.push({ label: 'Nama Lengkap', oldVal: bData.full_name, newVal: aData.full_name });
                }
                if(bData.category && aData.category && bData.category !== aData.category){
                  diffRows.push({ label: 'Kategori PM', oldVal: (bData.category||'').replace(/_/g, ' '), newVal: (aData.category||'').replace(/_/g, ' ') });
                }
                if(bData.class_group && aData.class_group && bData.class_group !== aData.class_group){
                  diffRows.push({ label: 'Sub-Kelompok', oldVal: bData.class_group, newVal: aData.class_group });
                }
                if(bData.phone && aData.phone && bData.phone !== aData.phone){
                  diffRows.push({ label: 'No. HP / WA', oldVal: bData.phone, newVal: aData.phone });
                }
                if(bData.active !== undefined && aData.active !== undefined && bData.active !== aData.active){
                  diffRows.push({ label: 'Status Distribusi', oldVal: bData.active ? 'Aktif' : 'Nonaktif', newVal: aData.active ? 'Aktif' : 'Nonaktif' });
                }

                var diffId = 'pmDiffBox_' + (h.id || (ym + '_' + idx));

                html += '<div class="pm-timeline-item">' +
                          '<div class="pm-timeline-dot ' + dotCls + '"></div>' +
                          '<div class="pm-timeline-card">' +
                            '<div class="pm-timeline-header">' +
                              '<span class="pm-timeline-action ' + dotCls + '">' + actTitle + '</span>' +
                              '<span class="pm-timeline-date">📅 ' + fmtIdDate(curEff) + '</span>' +
                            '</div>' +
                            '<div class="pm-period-status-box info" style="margin-top:6px;margin-bottom:6px">' +
                              '<strong>Tanggal Perubahan: ' + fmtIdDate(curEff) + '</strong>' +
                              '<span><strong>Alasan Petugas:</strong> ' + (h.reason || 'Perubahan data diterapkan ke sistem.') + '</span>' +
                            '</div>' +
                            (h.actor_name ? '<span class="pm-timeline-actor">Dicatat oleh: ' + h.actor_name + '</span>' : '<span class="pm-timeline-actor">Dicatat oleh: Petugas KPM</span>');

                if(diffRows.length){
                  html += '<button type="button" class="pm-diff-toggle-btn" onclick="togglePmDiff(\'' + diffId + '\')">' +
                            '<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>' +
                            '<span>Lihat Detail Perubahan (' + diffRows.length + ' Atribut)</span>' +
                          '</button>' +
                          '<div id="' + diffId + '" class="pm-diff-box" style="display:none">' +
                            '<table class="pm-diff-table">' +
                              '<thead><tr><th>Atribut</th><th>Sebelumnya</th><th>Diperbarui Menjadi</th></tr></thead>' +
                              '<tbody>';
                  diffRows.forEach(function(dr){
                    html += '<tr>' +
                              '<td><strong>' + dr.label + '</strong></td>' +
                              '<td class="val-old">' + dr.oldVal + '</td>' +
                              '<td class="val-new">' + dr.newVal + '</td>' +
                            '</tr>';
                  });
                  html +=     '</tbody>' +
                            '</table>' +
                          '</div>';
                }

                html +=   '</div>' +
                        '</div>';
              });
            } else {
              // 0 perubahan di bulan ini
              html += '<div class="pm-period-status-box success">' +
                        '<strong>✅ Sepanjang bulan ini tidak ada perubahan data apa pun.</strong>' +
                        '<span>Penerima manfaat aktif menerima paket gizi secara konsisten dan data berjalan stabil tanpa ada mutasi.</span>' +
                      '</div>';
            }

            // Jika ini bulan pendaftaran awal, tampilkan event pendaftaran di bawahnya
            if(isRegMonth && regDate){
              html += '<div class="pm-timeline-item" style="margin-top:4px">' +
                        '<div class="pm-timeline-dot create"></div>' +
                        '<div class="pm-timeline-card" style="background:#f8fafc;border-color:#cbd5e1">' +
                          '<div class="pm-timeline-header">' +
                            '<span class="pm-timeline-action create">Pendaftaran Awal</span>' +
                            '<span class="pm-timeline-date">📅 ' + fmtIdDate(regDate) + '</span>' +
                          '</div>' +
                          '<p class="pm-timeline-desc">Terdaftar pertama kali di Master KPM: <strong>' + (pmData.kpm_name || 'Posyandu Melati 01') + '</strong></p>' +
                        '</div>' +
                      '</div>';
            }

            html +=   '</div>' +
                    '</div>'; // end pm-month-card
          });
        }

        if(histTimeline){
          histTimeline.innerHTML = html;
          histTimeline.style.display = 'flex';
        }

        // Quick Otorisasi Buttons di Footer Modal jika Admin/Kepala BGN
        if(isBgnAdmin && histFoot){
          var footHtml = '<div class="pm-history-bgn-actions">';
          if(pmData.approval_status === 'MENUNGGU_VERIFIKASI_BGN'){
            footHtml += '<button type="button" class="pm-modal-btn success" onclick="closeHistoryModal();openBgnApproveModal(' + pmData.id + ', \'' + (pmData.full_name || '').replace(/'/g, "\\'") + '\', \'' + (pmData.deactivation_reason || '').replace(/'/g, "\\'") + '\')">✔ Sahkan & Setujui</button>';
            footHtml += '<button type="button" class="pm-modal-btn danger" onclick="closeHistoryModal();openBgnRejectModal(' + pmData.id + ', \'' + (pmData.full_name || '').replace(/'/g, "\\'") + '\', \'' + (pmData.deactivation_reason || '').replace(/'/g, "\\'") + '\')">✖ Batalkan Permohonan</button>';
          } else if(!pmData.active){
            footHtml += '<button type="button" class="pm-modal-btn success" onclick="closeHistoryModal();openReactivateModal(' + pmData.id + ', \'' + (pmData.full_name || '').replace(/'/g, "\\'") + '\', \'' + (pmData.nik || '') + '\', \'' + (pmData.deactivation_reason || '').replace(/'/g, "\\'") + '\')">↺ Pulihkan Data ke Aktif</button>';
          }
          footHtml += '</div>';
          footHtml += '<button type="button" class="pm-modal-btn primary" onclick="closeHistoryModal()">Tutup</button>';
          histFoot.innerHTML = footHtml;
        }
      })
      .catch(function(err){
        if(histLoading) histLoading.style.display = 'none';
        if(histEmpty){
          histEmpty.innerHTML = 
            '<div style="text-align:center;padding:24px 16px">' +
              '<svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="#ef4444" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom:8px"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>' +
              '<strong style="display:block;color:#b91c1c;font-size:13.5px;margin-bottom:4px">Gagal Memuat Riwayat</strong>' +
              '<span style="display:block;color:#64748b;font-size:12px;margin-bottom:14px;max-width:380px;margin-left:auto;margin-right:auto">' + (err.message || 'Koneksi ke server terputus atau data tidak ditemukan.') + '</span>' +
              '<button type="button" class="pm-modal-btn secondary" style="display:inline-flex;margin:0 auto" onclick="openHistoryModal(' + id + ', \'' + (name||'').replace(/'/g, "\\'") + '\', \'' + (nik||'').replace(/'/g, "\\'") + '\', \'' + (cat||'') + '\', ' + (isAct?1:0) + ', \'' + (approvalStatus||'') + '\', \'' + (subGroup||'').replace(/'/g, "\\'") + '\')">🔄 Coba Lagi</button>' +
            '</div>';
          histEmpty.style.display = 'block';
        }
      });
  };

  window.closeHistoryModal = function(){
    if(histModal) histModal.style.display = 'none';
  };

  // Close modals on Esc key or click backdrop
  window.addEventListener('keydown', function(e){
    if(e.key === 'Escape'){
      closeDeactivateModal();
      closeBgnApproveModal();
      closeBgnRejectModal();
      closeReactivateModal();
      closeHistoryModal();
    }
  });

  [deactModal, approveModal, rejectModal, reactModal, histModal].forEach(function(modal){
    if(modal){
      modal.addEventListener('click', function(e){
        if(e.target === modal){
          modal.style.display = 'none';
        }
      });
    }
  });
})();
</script>
