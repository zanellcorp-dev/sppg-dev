        </div>

        <input type="hidden" id="corrTargetPmId">
        <input type="hidden" id="corrTargetOriginalCat">
        <input type="hidden" id="corrTargetOriginalClass">

        <div class="pm-selected-preview" id="corrSelectedPreview" style="display:none"></div>

        <div id="corrFormFields" style="display:none;margin-top:14px">
          <div class="pm-form-field">
            <label for="corrFormFullName">Nama Lengkap Setelah Koreksi <span style="color:#ef4444">*</span></label>
            <input type="text" id="corrFormFullName" class="pm-modal-input">
