<%- include('../partials/header') %>
<section class="panel"><div class="panel-head"><div><span class="panel-kicker">AKSES CEPAT</span><h2>Dashboard Link / Tautan</h2><p class="muted">Akses cepat ke sistem dan layanan yang digunakan SPPG.</p></div><a class="primary-btn" href="/quick-links/new"><i data-lucide="plus"></i>Tambah Link</a></div><div class="quick-grid"><% rows.forEach(r=>{ %><article class="quick-card"><a class="quick-card-main" href="<%= r.url %>" target="_blank" rel="noopener noreferrer"><span class="quick-icon"><i data-lucide="<%= r.icon||'external-link' %>"></i></span><div><strong><%= r.title %></strong><p><%= r.description||'Buka tautan' %></p></div></a><div class="quick-card-tools"><a href="/quick-links/<%= r.id %>/edit">Edit</a><i data-lucide="arrow-up-right"></i></div></article><% }) %><% if(!rows.length){ %><div class="empty-state"><i data-lucide="link"></i><strong>Belum ada tautan</strong><span>Tambahkan link yang sering digunakan.</span></div><% } %></div></section>
<%- include('../partials/footer') %>