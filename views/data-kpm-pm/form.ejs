<%- include('../partials/header') %>
<div class="kpm-head"><div><div class="eyebrow">DATA KPM PM</div><h2 style="margin:0">Ajukan Data KPM PM</h2><p class="sub">Data masuk sebagai usulan. Master PM operasional tidak berubah saat pengajuan.</p></div></div>
<form method="post" action="/data-kpm-pm" class="card"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="grid" style="grid-template-columns:2fr 1fr;gap:14px"><div class="field"><label>KPM *</label><select class="select" name="kpm_id" required><option value="">Pilih KPM</option><% kpms.forEach(k=>{ %><option value="<%= k.id %>"><%= k.code %> — <%= k.name %> (<%= k.type==='POSYANDU'?'Posyandu':'Satuan Pendidikan' %>)</option><% }) %></select></div><div class="field"><label>Berlaku mulai *</label><input class="input" type="date" name="effective_from" value="<%= new Date().toISOString().slice(0,10) %>" required></div></div>
<p class="help">Untuk pengajuan besar, tahap berikutnya dapat menggunakan template Excel. Form ini dipakai untuk perubahan kecil/entry manual.</p><div style="overflow:auto"><table class="table"><thead><tr><th>Nama *</th><th>NIK</th><th>NISN</th><th>Gender *</th><th>Kelas/Kelompok</th><th>Kategori *</th></tr></thead><tbody id="pmRows"><tr><td><input class="input" name="full_name" required></td><td><input class="input" name="nik"></td><td><input class="input" name="nisn"></td><td><select class="select" name="gender" required><option value="">-</option><option>L</option><option>P</option></select></td><td><input class="input" name="class_group"></td><td><select class="select" name="category" required><option value="">-</option><option value="PESERTA_DIDIK">Peserta Didik</option><option value="PENDIDIK">Pendidik</option><option value="TENAGA_KEPENDIDIKAN">Tendik</option><option value="BALITA">Balita</option><option value="BUMIL">Bumil</option><option value="BUSUI">Busui</option></select></td></tr></tbody></table></div><div class="actions" style="margin-top:16px"><button type="button" class="btn gray" onclick="addRow()">＋ Tambah Baris</button><button class="btn" type="submit">Ajukan untuk Review</button><a class="btn gray" href="/data-kpm-pm">Batal</a></div></form>
<script>function addRow(){const t=document.querySelector('#pmRows');const r=t.querySelector('tr').cloneNode(true);r.querySelectorAll('input').forEach(x=>x.value='');r.querySelectorAll('select').forEach(x=>x.selectedIndex=0);t.appendChild(r)}</script>
<%- include('../partials/footer') %>
