/* ============================================================== */
/* UNIFIED STATUS WIDGET (Mobile & Desktop Friendly - 1 Container)*/
/* ============================================================== */
.pm-status-unified-widget {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  background: #ffffff;
  border-top: 1px solid #edf2f7;
  border-bottom: 1px solid #edf2f7;
  margin: 0;
  padding: 0;
}
.pm-unified-segment {
  display: flex;
  align-items: center;
  gap: 12px;
