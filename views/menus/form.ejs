<%- include('../partials/header') %>
<section class="panel form-panel">
  <div class="panel-head"><div><span class="panel-kicker">OPERASIONAL SPPG</span><h2><%= row?'Edit Menu Harian':'Tambah Menu' %></h2><p class="muted"><%= row?'Perubahan hanya berlaku pada tanggal ini.':'Buat menu baru sekaligus menetapkannya pada tanggal operasional.' %></p></div><a class="outline-btn" href="/menus?date=<%= effectiveDate %>">Kembali</a></div>
  <form method="post" enctype="multipart/form-data" action="<%= row?'/menus/'+row.id+'/update':'/menus' %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-grid">
      <div class="field"><label>Tanggal Menu *</label><input class="input" type="date" name="menu_date" value="<%= effectiveDate %>" <%= row?'readonly':'' %> required><small class="form-help"><%= row?'Tanggal penetapan menu tidak diubah dari halaman edit.':'Bisa memilih tanggal yang sudah lewat, hari ini, maupun tanggal yang akan datang.' %></small></div>
      <div class="field"><label>Kode Menu</label><input class="input" name="menu_code" value="<%= row?.menu_code||'Otomatis saat disimpan' %>" readonly><small class="form-help">Format otomatis: <strong>MNU-DDMMNN</strong>. Contoh tanggal 10 September, menu ke-02 = <strong>MNU-100902</strong>. Nomor urut dihitung dari menu pada tanggal yang dipilih.</small></div>
      <div class="field"><label>Nama Menu *</label><input class="input" required name="menu_name" value="<%= row?.menu_name||'' %>" placeholder="Contoh: Nasi Putih"></div>
      <div class="field"><label>Nama Komponen</label><input class="input" name="component_name" value="<%= row?.component_name||'' %>" placeholder="Contoh: Nasi, lauk, sayur, buah"></div>
      <div class="field"><label>Jenis KPM *</label><select class="select" name="kpm_type"><option value="SATUAN_PENDIDIKAN" <%= row?.kpm_type==='SATUAN_PENDIDIKAN'?'selected':'' %>>Satuan Pendidikan</option><option value="POSYANDU" <%= row?.kpm_type==='POSYANDU'?'selected':'' %>>Posyandu</option></select></div>
      <div class="field full"><label>Nilai Gizi Porsi Kecil</label><div class="inline-5"><input class="input" type="number" min="0" step="0.01" name="energy_small" placeholder="Energi (kkal)" value="<%= row?.energy_small??'' %>"><input class="input" type="number" min="0" step="0.01" name="protein_small" placeholder="Protein (g)" value="<%= row?.protein_small??'' %>"><input class="input" type="number" min="0" step="0.01" name="fat_small" placeholder="Lemak (g)" value="<%= row?.fat_small??'' %>"><input class="input" type="number" min="0" step="0.01" name="carb_small" placeholder="Karbohidrat (g)" value="<%= row?.carb_small??'' %>"><input class="input" type="number" min="0" step="0.01" name="fiber_small" placeholder="Serat (g)" value="<%= row?.fiber_small??'' %>"></div></div>
      <div class="field full"><label>Nilai Gizi Porsi Besar</label><div class="inline-5"><input class="input" type="number" min="0" step="0.01" name="energy_large" placeholder="Energi (kkal)" value="<%= row?.energy_large??'' %>"><input class="input" type="number" min="0" step="0.01" name="protein_large" placeholder="Protein (g)" value="<%= row?.protein_large??'' %>"><input class="input" type="number" min="0" step="0.01" name="fat_large" placeholder="Lemak (g)" value="<%= row?.fat_large??'' %>"><input class="input" type="number" min="0" step="0.01" name="carb_large" placeholder="Karbohidrat (g)" value="<%= row?.carb_large??'' %>"><input class="input" type="number" min="0" step="0.01" name="fiber_large" placeholder="Serat (g)" value="<%= row?.fiber_large??'' %>"></div></div>
      <div class="field"><label>Foto Menu Porsi Kecil</label><input class="input" type="file" name="photo_small" accept=".jpg,.jpeg,.png"><% if(row?.photo_small_path){ %><a class="photo-preview-link" href="/uploads/<%= String(row.photo_small_path).split(/[\\/]/).pop() %>" target="_blank"><img class="menu-photo-preview" src="/uploads/<%= String(row.photo_small_path).split(/[\\/]/).pop() %>" alt="Foto menu porsi kecil"></a><% } %><small class="form-help">Opsional. Foto biasanya diunggah setelah makanan matang. <%= row?.photo_small_path?'Foto tersimpan; pilih file baru hanya jika ingin mengganti.':'Belum ada foto. Menu tetap dapat disimpan tanpa foto.' %></small></div>
      <div class="field"><label>Foto Menu Porsi Besar</label><input class="input" type="file" name="photo_large" accept=".jpg,.jpeg,.png"><% if(row?.photo_large_path){ %><a class="photo-preview-link" href="/uploads/<%= String(row.photo_large_path).split(/[\\/]/).pop() %>" target="_blank"><img class="menu-photo-preview" src="/uploads/<%= String(row.photo_large_path).split(/[\\/]/).pop() %>" alt="Foto menu porsi besar"></a><% } %><small class="form-help">Opsional. Foto biasanya diunggah setelah makanan matang. <%= row?.photo_large_path?'Foto tersimpan; pilih file baru hanya jika ingin mengganti.':'Belum ada foto. Menu tetap dapat disimpan tanpa foto.' %></small></div>
    </div>
    <div class="form-actions"><button class="primary-btn" type="submit"><i data-lucide="save"></i><%= row?'Simpan Perubahan':'Simpan Menu' %></button></div>
  </form>
</section>
<%- include('../partials/footer') %>
