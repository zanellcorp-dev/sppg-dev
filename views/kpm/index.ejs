<%- include('../partials/header') %>
<div class="kpm-head">
  <div>
    <div class="eyebrow">OPERASIONAL SPPG</div>
    <h2 style="margin:0">Master KPM</h2>
    <p class="sub">Data penerima manfaat berlaku berdasarkan tanggal. Jika tidak ada perubahan, data otomatis tetap berlaku tanpa perlu diperbarui setiap hari.</p>
  </div>
  <div style="display:flex;gap:8px;flex-wrap:wrap"><a class="btn gray" href="/kpm/template.xlsx">↓ Template Excel KPM PM</a><a class="btn gray" href="/kpm/export.xlsx?date=<%= date %>&type=<%= encodeURIComponent(type) %>">↓ Export Excel</a><a class="btn secondary" href="/kpm/import?date=<%= date %>">↑ Import Excel</a><a class="btn" href="/kpm/new?date=<%= date %>">＋ Tambah KPM</a></div>
</div>
<div class="grid kpm-summary">
  <div class="card"><div class="label">Satuan Pendidikan</div><div class="metric"><%= summary.school %></div><div class="sub">KPM aktif</div></div>
  <div class="card"><div class="label">Posyandu</div><div class="metric"><%= summary.pos %></div><div class="sub">KPM aktif</div></div>
  <div class="card"><div class="label">Total PM pada tanggal terpilih</div><div class="metric"><%= summary.pm.toLocaleString('id-ID') %></div><div class="sub"><%= summary.small.toLocaleString('id-ID') %> kecil · <%= summary.large.toLocaleString('id-ID') %> besar</div></div>
</div>
<form class="card kpm-filter" method="get" action="/kpm">
  <div class="field"><label>Tanggal Data</label><input class="input" type="date" name="date" value="<%= date %>"></div>
  <div class="field"><label>Jenis KPM</label><select class="select" name="type"><option value="">Semua Jenis</option><option value="SATUAN_PENDIDIKAN" <%= type==='SATUAN_PENDIDIKAN'?'selected':'' %>>Satuan Pendidikan</option><option value="POSYANDU" <%= type==='POSYANDU'?'selected':'' %>>Posyandu</option></select></div>
  <div class="field field-grow"><label>Pencarian</label><input class="input" name="q" value="<%= q %>" placeholder="Nama KPM atau kode KPM"></div>
  <button class="btn" type="submit">Terapkan Filter</button>
</form>
<% if(!type || type==='SATUAN_PENDIDIKAN'){ %>
<div class="kpm-section-title"><div><h3>Satuan Pendidikan</h3><span><%= rows.filter(r=>r.type==='SATUAN_PENDIDIKAN').length %> KPM pada hasil filter</span></div></div>
<div class="kpm-cards">
<% rows.filter(r=>r.type==='SATUAN_PENDIDIKAN').forEach(r=>{ %>
  <article class="kpm-card">
    <div class="kpm-card-top"><div><span class="kpm-type school">Satuan Pendidikan</span><h3><%= r.name %></h3><div class="kpm-code"><%= r.code %> · <%= r.education_level||'-' %></div><div class="kpm-card-meta">Kelengkapan data <strong><%= r.completeness %>%</strong><% if(r.period_reason){ %> · <%= r.period_reason %><% } %></div></div><span class="status <%= r.display_status==='AKTIF'?'success':r.display_status==='NONAKTIF_SEMENTARA'?'warning':'muted' %>"><%= r.display_status==='NONAKTIF_SEMENTARA'?'Nonaktif Sementara':r.display_status==='NONAKTIF'?'Nonaktif':'Aktif' %></span></div>
    <div class="kpm-count-grid">
      <button type="button" class="kpm-count-item is-interactive" onclick="openKpmGroupModal(<%= r.id %>, '<%= r.name.replace(/'/g, "\\'") %>', '<%= r.code %>', 'SATUAN_PENDIDIKAN', 'PORSI_KECIL')" title="Klik untuk membuka Kartu Modal Siswa Porsi Kecil"><span>Porsi Kecil ↗</span><strong><%= r.totals.small %></strong><small>L <%= r.small_male||0 %> · P <%= r.small_female||0 %></small></button>
      <button type="button" class="kpm-count-item is-interactive" onclick="openKpmGroupModal(<%= r.id %>, '<%= r.name.replace(/'/g, "\\'") %>', '<%= r.code %>', 'SATUAN_PENDIDIKAN', 'PORSI_BESAR')" title="Klik untuk membuka Kartu Modal Siswa Porsi Besar"><span>Porsi Besar ↗</span><strong><%= r.totals.large %></strong><small>PD L <%= r.large_male||0 %> · P <%= r.large_female||0 %></small></button>
      <button type="button" class="kpm-count-item is-interactive" onclick="openKpmGroupModal(<%= r.id %>, '<%= r.name.replace(/'/g, "\\'") %>', '<%= r.code %>', 'SATUAN_PENDIDIKAN', 'PENDIDIK')" title="Klik untuk membuka Kartu Modal Pendidik"><span>Pendidik ↗</span><strong><%= (Number(r.teacher_male)||0)+(Number(r.teacher_female)||0) %></strong><small>L <%= r.teacher_male||0 %> · P <%= r.teacher_female||0 %></small></button>
      <button type="button" class="kpm-count-item is-interactive" onclick="openKpmGroupModal(<%= r.id %>, '<%= r.name.replace(/'/g, "\\'") %>', '<%= r.code %>', 'SATUAN_PENDIDIKAN', 'TENAGA_KEPENDIDIKAN')" title="Klik untuk membuka Kartu Modal Tendik"><span>Tendik ↗</span><strong><%= (Number(r.staff_male)||0)+(Number(r.staff_female)||0) %></strong><small>L <%= r.staff_male||0 %> · P <%= r.staff_female||0 %></small></button>
    </div>
    <div class="kpm-total"><span>Total PM</span><strong><%= r.totals.total.toLocaleString('id-ID') %></strong></div>
    <div class="kpm-card-actions"><a class="btn" href="/portal/kpm/preview/<%= r.id %>">Dashboard KPM</a><a class="btn gray" href="/kpm/<%= r.id %>?date=<%= date %>">Detail KPM</a><a class="btn secondary" href="/kpm/<%= r.id %>/edit?date=<%= date %>">✏️ Edit</a></div>
  </article>
<% }) %>
</div>
<% } %>
<% if(!type || type==='POSYANDU'){ %>
<div class="kpm-section-title" style="margin-top:28px"><div><h3>Posyandu</h3><span><%= rows.filter(r=>r.type==='POSYANDU').length %> KPM pada hasil filter</span></div></div>
<div class="kpm-cards">
<% rows.filter(r=>r.type==='POSYANDU').forEach(r=>{ %>
  <article class="kpm-card">
    <div class="kpm-card-top"><div><span class="kpm-type posyandu">Posyandu</span><h3><%= r.name %></h3><div class="kpm-code"><%= r.code %></div><div class="kpm-card-meta">Kelengkapan data <strong><%= r.completeness %>%</strong><% if(r.period_reason){ %> · <%= r.period_reason %><% } %></div></div><span class="status <%= r.display_status==='AKTIF'?'success':r.display_status==='NONAKTIF_SEMENTARA'?'warning':'muted' %>"><%= r.display_status==='NONAKTIF_SEMENTARA'?'Nonaktif Sementara':r.display_status==='NONAKTIF'?'Nonaktif':'Aktif' %></span></div>
    <div class="kpm-count-grid">
      <button type="button" class="kpm-count-item is-interactive" onclick="openKpmGroupModal(<%= r.id %>, '<%= r.name.replace(/'/g, "\\'") %>', '<%= r.code %>', 'POSYANDU', 'BALITA')" title="Klik untuk membuka Modal Khusus Kelompok Balita (<%= r.totals.balita %> Anak)"><span>Balita ↗</span><strong><%= r.totals.balita %></strong><small>L <%= r.balita_male||0 %> · P <%= r.balita_female||0 %></small></button>
      <button type="button" class="kpm-count-item is-interactive" onclick="openKpmGroupModal(<%= r.id %>, '<%= r.name.replace(/'/g, "\\'") %>', '<%= r.code %>', 'POSYANDU', 'BUMIL')" title="Klik untuk membuka Modal Khusus Kelompok Bumil (<%= r.bumil||0 %> Orang)"><span>Bumil ↗</span><strong><%= r.bumil||0 %></strong><small>P · Porsi Besar</small></button>
      <button type="button" class="kpm-count-item is-interactive" onclick="openKpmGroupModal(<%= r.id %>, '<%= r.name.replace(/'/g, "\\'") %>', '<%= r.code %>', 'POSYANDU', 'BUSUI')" title="Klik untuk membuka Modal Khusus Kelompok Busui (<%= r.busui||0 %> Orang)"><span>Busui ↗</span><strong><%= r.busui||0 %></strong><small>P · Porsi Besar</small></button>
      <button type="button" class="kpm-count-item is-interactive" onclick="openKpmGroupModal(<%= r.id %>, '<%= r.name.replace(/'/g, "\\'") %>', '<%= r.code %>', 'POSYANDU', 'LARGE_PORTION')" title="Klik untuk membuka Modal Khusus Porsi Besar (<%= r.totals.large %> Porsi)"><span>Porsi Besar ↗</span><strong><%= r.totals.large %></strong><small>Bumil + Busui</small></button>
    </div>
    <div class="kpm-total"><span>Total PM</span><strong><%= r.totals.total.toLocaleString('id-ID') %></strong></div>
    <div class="kpm-card-actions"><a class="btn" href="/portal/kpm/preview/<%= r.id %>">Dashboard KPM</a><a class="btn gray" href="/kpm/<%= r.id %>?date=<%= date %>">Detail KPM</a><a class="btn secondary" href="/kpm/<%= r.id %>/edit?date=<%= date %>">✏️ Edit</a></div>
  </article>
<% }) %>
</div>
<% } %>
<% if(!rows.length){ %><div class="empty card">Tidak ada KPM yang sesuai dengan filter tanggal, jenis, atau pencarian.</div><% } %>

<!-- ============================================================== -->
<!-- JENDELA KARTU MODAL KHUSUS PENGELOMPOKAN DATA PM               -->
<!-- ============================================================== -->
<div class="kpm-group-modal" id="kpmGroupModal" role="dialog" aria-modal="true" aria-labelledby="modalGroupTitle">
  <div class="kpm-group-dialog">
    <div class="kpm-group-dialog-head">
      <div>
        <div class="eyebrow" id="modalGroupEyebrow">KELOMPOK PENERIMA MANFAAT</div>
        <h3 id="modalGroupTitle">Memuat Kelompok...</h3>
        <p id="modalGroupMeta">-</p>
      </div>
      <button type="button" class="kpm-group-close" onclick="closeKpmGroupModal()" aria-label="Tutup Modal">&times;</button>
    </div>

    <div class="kpm-group-dialog-body" id="modalGroupBody">
      <!-- Info Strip & Metrik Porsi Gizi -->
      <div class="kpm-group-info-strip">
        <div>
          <span style="font-size:11px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:.05em">Standar Gizi:</span>
          <strong id="modalPortionBadge" style="font-size:13px;color:#007a5e;margin-left:6px">Porsi Kecil 100%</strong>
        </div>
        <div style="display:flex;align-items:center;gap:8px" id="modalGroupMetrics">
          <span class="pm-show-badge" id="modalTotalBadge">Total: 0</span>
          <span class="pm-show-badge" id="modalGenderBadge">L: 0 · P: 0</span>
        </div>
      </div>

      <!-- Tab Filter Sub-Kelompok (Usia / Trimester / Masa ASI) -->
      <div class="kpm-group-tabs" id="modalSubNav">
        <!-- Diisi dinamis via JS -->
      </div>

      <!-- Bar Pencarian Cepat di dalam Modal -->
      <div class="kpm-group-search-row">
        <input type="search" class="kpm-group-search-input" id="modalSearchInput" placeholder="Cari nama penerima manfaat atau NIK dalam kelompok ini..." autocomplete="off">
      </div>

      <!-- Tabel Eksklusif Hanya Kelompok Terkait -->
      <div class="table-wrap" style="max-height:360px;overflow-y:auto;border:1px solid #edf2f7;border-radius:10px;background:#fff">
        <table class="table" style="margin:0">
          <thead>
            <tr>
              <th style="width:45px">No</th>
              <th>Nama Penerima Manfaat</th>
              <th>NIK</th>
              <th style="width:55px">L/P</th>
              <th id="modalColHeaderSubgroup">Sub-Kelompok</th>
              <th style="width:110px">Porsi Gizi</th>
              <th style="width:80px">Aksi</th>
            </tr>
          </thead>
          <tbody id="modalTableBody">
            <!-- Diisi dinamis via JS -->
          </tbody>
        </table>
      </div>
    </div>

    <div class="kpm-group-dialog-foot">
      <a class="btn secondary" id="modalDashboardLink" href="#">Buka di Dashboard KPM ↗</a>
      <button type="button" class="btn" onclick="closeKpmGroupModal()">Tutup</button>
    </div>
  </div>
</div>

<script>
(function(){
  var modal = document.getElementById('kpmGroupModal');
  var eyebrowEl = document.getElementById('modalGroupEyebrow');
  var titleEl = document.getElementById('modalGroupTitle');
  var metaEl = document.getElementById('modalGroupMeta');
  var portionBadge = document.getElementById('modalPortionBadge');
  var totalBadge = document.getElementById('modalTotalBadge');
  var genderBadge = document.getElementById('modalGenderBadge');
  var subNavEl = document.getElementById('modalSubNav');
  var colHeaderEl = document.getElementById('modalColHeaderSubgroup');
  var tableBody = document.getElementById('modalTableBody');
  var searchInput = document.getElementById('modalSearchInput');
  var dashboardLink = document.getElementById('modalDashboardLink');

  var currentKpmId = null;
  var currentCategory = 'BALITA';
  var currentSubGroup = 'ALL';
  var allPmData = [];
  var filteredPmData = [];

  var posyanduConfigs = {
    BALITA: {
      label: 'Balita',
      title: 'Kelompok Anak Balita',
      portionText: 'Porsi Kecil 100% (Menu Nutrisi Balita & Baduta)',
      portionBadgeClass: 'info',
      colHeader: 'Tahapan Usia Balita',
      subgroups: [
        { key: 'ALL', label: 'Semua Balita' },
        { key: '0-5', label: '0–5 Bulan (Bayi)' },
        { key: '6-23', label: '6–23 Bulan (Baduta)' },
        { key: '24-59', label: '24–59 Bulan (Balita)' }
      ]
    },
    BUMIL: {
      label: 'Bumil',
      title: 'Kelompok Ibu Hamil (Bumil)',
      portionText: 'Porsi Besar 100% (Kebutuhan Nutrisi Ibu Hamil)',
      portionBadgeClass: 'warning',
      colHeader: 'Usia Kehamilan / Trimester',
      subgroups: [
        { key: 'ALL', label: 'Semua Bumil' },
        { key: 'trimester 1', label: 'Trimester 1 (1–12 Minggu)' },
        { key: 'trimester 2', label: 'Trimester 2 (13–27 Minggu)' },
        { key: 'trimester 3', label: 'Trimester 3 (28–40 Minggu)' }
      ]
    },
    BUSUI: {
      label: 'Busui',
      title: 'Kelompok Ibu Menyusui (Busui)',
      portionText: 'Porsi Besar 100% (Kebutuhan Nutrisi Ibu Menyusui)',
      portionBadgeClass: 'warning',
      colHeader: 'Usia Bayi yang Disusui',
      subgroups: [
        { key: 'ALL', label: 'Semua Busui' },
        { key: '0–6', label: 'Bayi 0–6 Bulan (ASI Eksklusif)' },
        { key: '7–12', label: 'Bayi 7–12 Bulan' },
        { key: '13–24', label: 'Bayi 13–24 Bulan' }
      ]
    },
    LARGE_PORTION: {
      label: 'Porsi Besar',
      title: 'Kelompok Porsi Besar (Bumil + Busui)',
      portionText: 'Porsi Besar 100% (Gabungan Bumil & Busui)',
      portionBadgeClass: 'warning',
      colHeader: 'Kategori & Keterangan',
      subgroups: [
        { key: 'ALL', label: 'Semua Porsi Besar' },
        { key: 'BUMIL', label: 'Ibu Hamil' },
        { key: 'BUSUI', label: 'Ibu Menyusui' }
      ]
    },
    PORSI_KECIL: {
      label: 'Porsi Kecil',
      title: 'Kelompok Peserta Didik Porsi Kecil (Kelas 1–3)',
      portionText: 'Porsi Kecil 100% (Peserta Didik Tingkat Awal)',
      portionBadgeClass: 'info',
      colHeader: 'Tingkat Kelas',
      subgroups: [
        { key: 'ALL', label: 'Semua Porsi Kecil' },
        { key: 'kelas 1', label: 'Kelas 1' },
        { key: 'kelas 2', label: 'Kelas 2' },
        { key: 'kelas 3', label: 'Kelas 3' }
      ]
    },
    PORSI_BESAR: {
      label: 'Porsi Besar',
      title: 'Kelompok Peserta Didik Porsi Besar (Kelas 4–6 / Lanjutan)',
      portionText: 'Porsi Besar 100% (Peserta Didik Tingkat Lanjutan)',
      portionBadgeClass: 'warning',
      colHeader: 'Tingkat Kelas',
      subgroups: [
        { key: 'ALL', label: 'Semua Porsi Besar' },
        { key: 'kelas 4', label: 'Kelas 4' },
        { key: 'kelas 5', label: 'Kelas 5' },
        { key: 'kelas 6', label: 'Kelas 6' }
      ]
    },
    PENDIDIK: {
      label: 'Pendidik',
      title: 'Kelompok Pendidik (Guru)',
      portionText: 'Porsi Pendidik',
      portionBadgeClass: 'muted',
      colHeader: 'Jabatan / Tugas',
      subgroups: [
        { key: 'ALL', label: 'Semua Pendidik' }
      ]
    },
    TENAGA_KEPENDIDIKAN: {
      label: 'Tendik',
      title: 'Kelompok Tenaga Kependidikan',
      portionText: 'Porsi Tendik',
      portionBadgeClass: 'muted',
      colHeader: 'Tugas / Administrasi',
      subgroups: [
        { key: 'ALL', label: 'Semua Tendik' }
      ]
    }
  };

  window.openKpmGroupModal = function(kpmId, kpmName, kpmCode, kpmType, category){
    currentKpmId = kpmId;
    currentCategory = category || 'BALITA';
    currentSubGroup = 'ALL';
    if(searchInput) searchInput.value = '';

    var cfg = posyanduConfigs[currentCategory] || posyanduConfigs.BALITA;

    eyebrowEl.textContent = 'KELOMPOK PENERIMA MANFAAT · ' + (kpmType === 'POSYANDU' ? 'POSYANDU' : 'SATUAN PENDIDIKAN');
    titleEl.textContent = cfg.title + ' — ' + kpmName;
    metaEl.textContent = 'Kode KPM: ' + kpmCode + ' · Data terisolasi khusus ruang privat KPM ini.';
    portionBadge.textContent = cfg.portionText;
    if(colHeaderEl) colHeaderEl.textContent = cfg.colHeader;

    dashboardLink.href = '/portal/kpm/preview/' + kpmId + '?cat=' + encodeURIComponent(currentCategory) + '#pm-management-section';

    tableBody.innerHTML = '<tr><td colspan="7" style="text-align:center;padding:34px;color:#64748b"><div style="display:inline-block;margin-bottom:6px">⏳</div><br>Memuat data khusus ' + cfg.label + '...</td></tr>';
    modal.classList.add('active');

    // Fetch data khusus KPM dari endpoint API
    fetch('/api/kpm/' + kpmId + '/pm-group')
      .then(function(res){ return res.json(); })
      .then(function(json){
        if(!json.success){ throw new Error(json.error || 'Gagal memuat'); }
        var raw = json.data || [];

        // Filter murni hanya kategori yang diklik
        if(currentCategory === 'BALITA'){
          allPmData = raw.filter(function(x){ return x.category === 'BALITA'; });
        } else if(currentCategory === 'BUMIL'){
          allPmData = raw.filter(function(x){ return x.category === 'BUMIL'; });
        } else if(currentCategory === 'BUSUI'){
          allPmData = raw.filter(function(x){ return x.category === 'BUSUI'; });
        } else if(currentCategory === 'LARGE_PORTION'){
          allPmData = raw.filter(function(x){ return x.category === 'BUMIL' || x.category === 'BUSUI'; });
        } else if(currentCategory === 'PORSI_KECIL'){
          allPmData = raw.filter(function(x){ return x.category === 'PESERTA_DIDIK' && /^(1|2|3)(\D|$)/i.test(x.class_group||''); });
        } else if(currentCategory === 'PORSI_BESAR'){
          allPmData = raw.filter(function(x){ return x.category === 'PESERTA_DIDIK' && !/^(1|2|3)(\D|$)/i.test(x.class_group||''); });
        } else if(currentCategory === 'PENDIDIK'){
          allPmData = raw.filter(function(x){ return x.category === 'PENDIDIK'; });
        } else if(currentCategory === 'TENAGA_KEPENDIDIKAN'){
          allPmData = raw.filter(function(x){ return x.category === 'TENAGA_KEPENDIDIKAN'; });
        } else {
          allPmData = raw;
        }

        renderSubGroupTabs();
        renderTableRows();
      })
      .catch(function(err){
        tableBody.innerHTML = '<tr><td colspan="7" style="text-align:center;padding:30px;color:#b91c1c">Gagal memuat data: ' + err.message + '</td></tr>';
      });
  };

  function renderSubGroupTabs(){
    var cfg = posyanduConfigs[currentCategory] || posyanduConfigs.BALITA;
    var subCounts = { ALL: allPmData.length };
    cfg.subgroups.forEach(function(sg){
      if(sg.key !== 'ALL'){
        subCounts[sg.key] = allPmData.filter(function(p){
          var cls = (p.class_group || '').toLowerCase().replace(/–/g, '-');
          var cat = (p.category || '').toUpperCase();
          var sk = String(sg.key).toLowerCase().replace(/–/g, '-');
          if(currentCategory === 'LARGE_PORTION'){
            return cat === sg.key;
          }
          return cls.indexOf(sk) !== -1;
        }).length;
      }
    });

    var tabsHtml = '';
    cfg.subgroups.forEach(function(sg){
      var isAct = currentSubGroup === sg.key;
      var count = subCounts[sg.key] !== undefined ? subCounts[sg.key] : 0;
      tabsHtml += '<button type="button" class="kpm-group-tab-btn ' + (isAct ? 'active' : '') + '" data-sub="' + sg.key + '">' +
                    '<span>' + sg.label + '</span>' +
                    '<span class="badge-num">' + count + '</span>' +
                  '</button>';
    });
    subNavEl.innerHTML = tabsHtml;

    subNavEl.querySelectorAll('.kpm-group-tab-btn').forEach(function(btn){
      btn.addEventListener('click', function(){
        currentSubGroup = btn.getAttribute('data-sub') || 'ALL';
        subNavEl.querySelectorAll('.kpm-group-tab-btn').forEach(function(b){ b.classList.remove('active'); });
        btn.classList.add('active');
        renderTableRows();
      });
    });

    // Update metrik strip
    var maleCnt = allPmData.filter(function(x){ return x.gender === 'L'; }).length;
    var femCnt = allPmData.filter(function(x){ return x.gender === 'P'; }).length;
    totalBadge.textContent = 'Total: ' + allPmData.length + ' Orang';
    genderBadge.textContent = 'L: ' + maleCnt + ' · P: ' + femCnt;
  }

  function renderTableRows(){
    var q = (searchInput && searchInput.value || '').toLowerCase().trim();
    var list = allPmData.filter(function(p){
      var matchSub = true;
      if(currentSubGroup !== 'ALL'){
        var cls = (p.class_group || '').toLowerCase().replace(/–/g, '-');
        var cat = (p.category || '').toUpperCase();
        var sk = String(currentSubGroup).toLowerCase().replace(/–/g, '-');
        if(currentCategory === 'LARGE_PORTION'){
          matchSub = (cat === currentSubGroup);
        } else {
          matchSub = (cls.indexOf(sk) !== -1);
        }
      }
      if(!matchSub) return false;

      if(q){
        var name = (p.full_name || '').toLowerCase();
        var nik = (p.nik || '').toLowerCase();
        return name.indexOf(q) !== -1 || nik.indexOf(q) !== -1;
      }
      return true;
    });

    if(!list.length){
      tableBody.innerHTML = '<tr><td colspan="7" style="text-align:center;padding:32px;color:#64748b"><strong style="display:block;margin-bottom:4px">Tidak ada data penerima manfaat pada kelompok ini.</strong><small>Silakan pilih sub-kelompok lain atau sesuaikan pencarian.</small></td></tr>';
      return;
    }

    var html = '';
    list.forEach(function(p, i){
      var isSmall = (p.category === 'BALITA' || (p.category === 'PESERTA_DIDIK' && /^(1|2|3)(\D|$)/i.test(p.class_group||'')));
      var porsiBadge = isSmall 
        ? '<span class="status info">Porsi Kecil</span>' 
        : '<span class="status warning">Porsi Besar</span>';

      html += '<tr>' +
                '<td style="text-align:center;color:#64748b;font-weight:600">' + (i + 1) + '</td>' +
                '<td><strong>' + (p.full_name || '-') + '</strong></td>' +
                '<td><span style="font-family:monospace;font-size:12px;color:#475569">' + (p.nik || '-') + '</span></td>' +
                '<td style="text-align:center"><strong>' + (p.gender || '-') + '</strong></td>' +
                '<td><strong style="color:#035388;font-size:12.5px">' + (p.class_group || '-') + '</strong></td>' +
                '<td>' + porsiBadge + '</td>' +
                '<td><a class="btn secondary" style="padding:4px 8px;font-size:11px" href="/pm/' + p.id + '/edit" target="_blank">✏️ Edit</a></td>' +
              '</tr>';
    });
    tableBody.innerHTML = html;
  }

  if(searchInput){
    searchInput.addEventListener('input', function(){
      renderTableRows();
    });
  }

  window.closeKpmGroupModal = function(){
    modal.classList.remove('active');
  };

  // Tutup dengan tombol Escape atau klik luar dialog
  window.addEventListener('keydown', function(e){
    if(e.key === 'Escape' && modal.classList.contains('active')){
      closeKpmGroupModal();
    }
  });

  modal.addEventListener('click', function(e){
    if(e.target === modal){
      closeKpmGroupModal();
    }
  });
})();
</script>

