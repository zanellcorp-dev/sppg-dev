      </div>
      <div class="pm-modal-foot">
        <button type="button" class="pm-modal-btn secondary" onclick="closeBgnRejectModal()">Tutup</button>
        <button type="submit" class="pm-modal-btn danger">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          <span>Batalkan Permohonan (Tetap Aktif)</span>
        </button>
      </div>
    </form>
  </div>
</div>

<!-- ============================================================== -->
<!-- MODAL 4: PULIHKAN DARI ARSIP (RESTORE - KHUSUS KEPALA BGN) -->
<!-- ============================================================== -->
<div id="pmReactivateModal" class="pm-modal-backdrop" style="display:none" role="dialog" aria-modal="true">
  <div class="pm-modal-card">
    <div class="pm-modal-head success">
      <div class="pm-modal-icon-wrap success">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
      </div>
      <div>
        <h3>Otorisasi Kepala BGN · Pulihkan Data Penerima Manfaat</h3>
        <p>Memulihkan status penerima manfaat dari arsip kembali menjadi Aktif.</p>
      </div>
      <button type="button" class="pm-modal-close" onclick="closeReactivateModal()" aria-label="Tutup">&times;</button>
    </div>

    <form id="pmReactivateForm" method="post" action="">
      <input type="hidden" name="decision" value="RESTORE">
      <input type="hidden" name="active" value="1">
      <input type="hidden" name="reason" value="Dipulihkan kembali oleh Kepala BGN">

      <div class="pm-modal-body">
        <div class="pm-target-summary">
          <small>PENERIMA MANFAAT YANG DIPULIHKAN</small>
          <strong id="reactTargetName">-</strong>
          <span id="reactTargetMeta" class="pm-target-meta">NIK: -</span>
          <div id="reactTargetPrevReason" class="pm-prev-reason">Alasan nonaktif sebelumnya: -</div>
        </div>

        <p style="font-size:13px;color:#475569;margin-top:14px;line-height:1.5">
          Sebagai Kepala / Admin BGN, Anda memiliki hak istimewa untuk memulihkan penerima manfaat ini ke daftar distribusi aktif. Tindakan pemulihan ini akan dicatat ke riwayat audit.
        </p>
      </div>

      <div class="pm-modal-foot">
        <button type="button" class="pm-modal-btn secondary" onclick="closeReactivateModal()">Batal</button>
        <button type="submit" class="pm-modal-btn success">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
          <span>Pulihkan ke Aktif</span>
        </button>
      </div>
    </form>
  </div>
</div>

