        <div id="catChangeFormFields" style="display:none;margin-top:14px;border-top:1px solid #e2e8f0;padding-top:14px">
          <input type="hidden" id="catchange_pm_id">
          
          <div class="pm-target-summary" style="margin-bottom:12px">
            <small>PENERIMA MANFAAT TERPILIH</small>
            <strong id="catchange_target_name">-</strong>
            <span id="catchange_target_meta" style="color:#64748b;font-size:12px">-</span>
          </div>

          <div class="pm-form-grid-2">
            <div class="pm-form-field">
              <label>Kategori Asal (Saat Ini)</label>
              <input type="text" id="catchange_origin_cat" class="pm-modal-input" readonly style="background:#f1f5f9;cursor:not-allowed">
            </div>
            <div class="pm-form-field">
              <label>Kategori Baru (Tujuan) <span style="color:#d92d20">*</span></label>
              <select id="catchange_target_cat" class="pm-modal-select" required onchange="updateCatChangeSubgroups()">
