          <div class="pm-form-grid-2">
            <div class="pm-form-field">
              <label for="corrFormNik">NIK Setelah Koreksi</label>
              <input type="text" id="corrFormNik" class="pm-modal-input" maxlength="16">
            </div>
            <div class="pm-form-field">
              <label>Jenis Kelamin</label>
              <div class="pm-radio-pills" style="margin-top:4px">
                <label class="pm-radio-pill"><input type="radio" name="corr_gender" value="P"> <span>Perempuan</span></label>
