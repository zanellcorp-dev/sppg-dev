<%- include('../partials/header') %><form method="post" action="<%= pm?'/pm/'+pm.id:'/kpm/'+kpm.id+'/pm' %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% if(pm){ %><input type="hidden" name="_method" value="PUT"><% } %><div class="card"><h2>👨‍🎓 <%= pm?'Edit':'Tambah' %> Penerima Manfaat</h2><p class="sub">PM = Penerima Manfaat (orang). KPM: <strong><%= kpm.name %></strong>.</p><div class="form-grid"><div class="field"><label>Nama Lengkap *</label><input required class="input" name="full_name" value="<%= pm?.full_name||'' %>"></div><div class="field"><label>Kategori *</label><select required class="select" name="category"><% pmCategories.forEach(x=>{ %><option value="<%= x %>" <%= pm?.category===x?'selected':'' %>><%= x.replaceAll('_',' ') %></option><% }) %></select></div><div class="field"><label>NIK</label><input maxlength="16" class="input" name="nik" value="<%= pm?.nik||'' %>"></div><div class="field"><label>NISN</label><input class="input" name="nisn" value="<%= pm?.nisn||'' %>"></div><div class="field"><label>Nomor Identitas Lain</label><input class="input" name="identity_number" value="<%= pm?.identity_number||'' %>"></div><div class="field"><label>Jenis Kelamin</label><select class="select" name="gender"><option value="">Pilih</option><option value="L" <%= pm?.gender==='L'?'selected':'' %>>Laki-laki</option><option value="P" <%= pm?.gender==='P'?'selected':'' %>>Perempuan</option></select></div><div class="field"><label>Kelas/Kelompok</label><select class="select" name="class_group"><option value="">Pilih</option><% (rules?.classes||[]).forEach(x=>{ %><option <%= pm?.class_group===x?'selected':'' %>><%= x %></option><% }) %></select><div class="help"><%= rules?'Klasifikasi menyesuaikan jenjang KPM.':'Pilih kategori sesuai KPM.' %></div></div><div class="field"><label>Tanggal Lahir</label><input type="date" class="input" name="birth_date" value="<%= pm?.birth_date?new Date(pm.birth_date).toISOString().slice(0,10):'' %>"></div><div class="field"><label>No. HP/WhatsApp</label><input class="input" name="phone" value="<%= pm?.phone||'' %>"></div></div></div><button class="btn" style="margin-top:16px">💾 Simpan PM</button> <a class="btn gray" href="/kpm/<%= kpm.id %>">Batal</a></form><%- include('../partials/footer') %>
