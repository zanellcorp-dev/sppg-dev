<%- include('../partials/header') %>
<section class="panel">
  <div class="panel-head"><div><span class="panel-kicker">OPERASIONAL SPPG</span><h2>Salin Menu</h2><p class="muted">Gunakan menu dari tanggal sebelumnya tanpa membuat ulang. Data disalin sebagai penetapan menu pada tanggal tujuan.</p></div><a class="outline-btn" href="/menus?date=<%= target %>">Kembali</a></div>
  <form method="get" action="/menus/copy" class="copy-date-form"><div class="field"><label>Tanggal Sumber</label><select class="select" name="source"><% dateOptions.forEach(d=>{ %><option value="<%= d %>" <%= d===source?'selected':'' %>><%= new Date(d+'T00:00:00').toLocaleDateString('id-ID',{day:'2-digit',month:'long',year:'numeric'}) %></option><% }) %></select></div><div class="field"><label>Tanggal Tujuan</label><input class="input" type="date" name="target" value="<%= target %>" required></div><button class="outline-btn" type="submit">Tampilkan Menu</button></form>
  <form method="post" action="/menus/copy"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="source" value="<%= source %>"><input type="hidden" name="target" value="<%= target %>">
    <div class="copy-head"><div><h3>Menu <%= new Date(source+'T00:00:00').toLocaleDateString('id-ID',{day:'numeric',month:'long',year:'numeric'}) %></h3><span class="muted">Pilih menu yang ingin disalin ke <strong><%= new Date(target+'T00:00:00').toLocaleDateString('id-ID',{day:'numeric',month:'long',year:'numeric'}) %></strong>.</span></div><label class="select-all"><input type="checkbox" id="check-all"> Pilih semua</label></div>
    <% if(rows.length){ %><div class="copy-list"><% rows.forEach(r=>{ %><label class="copy-item"><input class="menu-check" type="checkbox" name="menu_ids" value="<%= r.id %>"><div><strong><%= r.menu_name %></strong><span><%= r.menu_code %> · <%= r.kpm_type==='SATUAN_PENDIDIKAN'?'Satuan Pendidikan':'Posyandu' %></span><small><%= r.component_name||'Komponen belum diisi' %></small></div></label><% }) %></div><div class="form-actions"><button class="primary-btn" type="submit"><i data-lucide="copy"></i>Salin Menu Terpilih</button></div><% }else{ %><div class="empty-state compact"><i data-lucide="calendar-x"></i><strong>Tidak ada menu pada tanggal sumber.</strong><span>Pilih tanggal lain yang sudah memiliki menu.</span></div><% } %>
  </form>
</section>
<%- include('../partials/footer') %>
