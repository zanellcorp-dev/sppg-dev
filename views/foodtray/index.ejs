<%- include('../partials/header') %>
<section class="dashboard-grid two-col"><section class="panel"><div class="panel-head"><div><span class="panel-kicker">LABEL FOODTRAY</span><h2>Preview Label</h2></div><a class="primary-btn" href="#upload-template"><i data-lucide="upload"></i>Upload Template</a></div><div class="foodtray-preview"><div class="foodtray-label"><div class="foodtray-logo">BGN</div><strong>SPPG SUBANG PUSAKAJAYA KEBONDANAS</strong><small>Informasi Menu &amp; Gizi</small><div class="foodtray-lines"><span>Energi</span><b>—</b><span>Protein</span><b>—</b><span>Lemak</span><b>—</b><span>Karbohidrat</span><b>—</b></div><em>Dilarang membawa pulang makanan MBG</em></div></div></section><section class="panel"><div class="panel-head"><div><span class="panel-kicker">TEMPLATE</span><h2>Template Label Foodtray</h2></div></div><p><%= template.description||'Template label foodtray belum memiliki deskripsi.' %></p>
<% if(template.template_path){ %>
<div class="foodtray-file"><i data-lucide="file-check-2"></i><div><strong><%= template.template_name||'Template tersimpan' %></strong><small>Template aktif yang digunakan SPPG.</small></div></div>
<div class="action-stack"><a class="primary-btn" href="/foodtray/download"><i data-lucide="download"></i>Download Template</a><a class="outline-btn" href="#upload-template"><i data-lucide="refresh-cw"></i>Ganti Template</a></div>
<% }else{ %>
<div class="empty-state compact"><i data-lucide="file-up"></i><strong>Belum ada template</strong><span>Upload template label foodtray agar file dapat disimpan dan digunakan kembali.</span></div>
<% } %>
<hr><div id="upload-template" class="foodtray-upload"><span class="panel-kicker">UPLOAD TEMPLATE</span><form method="post" action="/foodtray/upload" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="field"><label for="template_file">File Template Label</label><input id="template_file" type="file" name="template_file" accept=".pdf,.jpg,.jpeg,.png,.xlsx,.docx" required><div class="help">Format: PDF, JPG, PNG, XLSX, atau DOCX · Maksimal <%= process?.env?.MAX_UPLOAD_MB||5 %> MB.</div></div><button class="primary-btn" type="submit"><i data-lucide="upload"></i>Simpan Template</button></form></div><hr><span class="panel-kicker">PANDUAN</span><p class="muted"><%= template.guide_text %></p></section></div>
<%- include('../partials/footer') %>
