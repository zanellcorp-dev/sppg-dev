<%- include('../partials/header') %><div class="grid"><div class="card"><div class="icon">👥</div><div class="metric"><%= summary.total %></div><div class="label">Total Staf</div></div><div class="card"><div class="icon">🟢</div><div class="metric"><%= summary.active %></div><div class="label">Aktif</div></div><div class="card"><div class="icon">🚪</div><div class="metric"><%= summary.left %></div><div class="label">Nonaktif/Keluar</div></div><div class="card"><a class="btn" href="/staff/new">＋ Tambah Staf</a></div></div><div class="section">Data Staf</div><div class="toolbar"><form class="search"><input class="input" name="q" value="<%= q %>" placeholder="🔍 Nama, NIK, KPJ, jabatan..."><select class="select" name="status"><option value="">Semua Status</option><% statuses.forEach(s=>{ %><option value="<%= s %>" <%= status===s?'selected':'' %>><%= s.replaceAll('_',' ') %></option><% }) %></select><button class="btn gray">Filter</button></form></div><div class="table-wrap"><table class="table"><tr><th>Nama</th><th>NIK</th><th>KPJ BPJSTK</th><th>Jabatan</th><th>Masuk</th><th>Status</th><th>Aksi</th></tr><% rows.forEach(r=>{ %><tr><td><strong><%= r.name %></strong></td><td><%= r.nik %></td><td><%= r.kpj_bpjstk||'-' %></td><td><%= r.position %></td><td><%= r.tanggal_masuk_bekerja?new Date(r.tanggal_masuk_bekerja).toLocaleDateString('id-ID'): '-' %></td><td><span class="badge <%= r.status==='AKTIF'?'green':r.status==='MENINGGAL_DUNIA'?'red':'yellow' %>"><%= r.status.replaceAll('_',' ') %></span></td><td><a class="btn gray" href="/staff/<%= r.id %>">Detail</a> <a class="btn secondary" href="/staff/<%= r.id %>/edit">✏️</a></td></tr><% }) %></table></div><%- include('../partials/footer') %>
