<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Ajukan Perubahan PM · <%= access.kpm_name %></title><link rel="stylesheet" href="/public/style.css?v=1.8.36.4"><style>.edit-wrap{max-width:760px;margin:0 auto;padding:28px 16px}.edit-card{background:#fff;border:1px solid #dfe7ee;border-radius:16px;padding:24px;box-shadow:0 8px 28px rgba(15,35,55,.07)}.edit-card h1{margin:0 0 6px}.edit-card p{color:#6b7d90}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.full{grid-column:1/-1}.field span{display:block;font-size:12px;font-weight:700;color:#52677d;margin-bottom:6px}.input{width:100%;box-sizing:border-box}.actions{display:flex;justify-content:flex-end;gap:10px;margin-top:20px}@media(max-width:600px){.form-grid{grid-template-columns:1fr}.full{grid-column:auto}.edit-wrap{padding:14px 10px}.edit-card{padding:18px}}</style></head><body><main class="edit-wrap"><div class="edit-card"><div class="eyebrow">PORTAL KPM · AJUKAN PERUBAHAN</div><h1><%= pm.full_name %></h1><p><%= access.kpm_name %> · <%= access.kpm_code %></p><div class="notice">Perubahan ini <strong>tidak langsung mengubah Master PM</strong>. Data akan dikirim ke SPPG untuk diverifikasi.</div><form method="post" action="/portal/kpm/<%= portalToken %>/pm/<%= pm.id %>/edit"><input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>"><input type="hidden" name="edit_signature" value="<%= editSignature %>"><div class="form-grid"><label class="field"><span>Nama Lengkap</span><input class="input" name="full_name" value="<%= pm.full_name %>" maxlength="180" required></label><label class="field"><span>NIK</span><input class="input" name="nik" value="<%= pm.nik||'' %>" maxlength="16"></label><label class="field"><span>NISN</span><input class="input" name="nisn" value="<%= pm.nisn||'' %>" maxlength="20"></label><label class="field"><span>Jenis Kelamin</span><select class="input" name="gender" required><option value="">Pilih</option><option value="L" <%= pm.gender==='L'?'selected':'' %>>L</option><option value="P" <%= pm.gender==='P'?'selected':'' %>>P</option></select></label><label class="field"><span>Kategori</span><select class="input" name="category" required><% const cats=access.kpm_type==='POSYANDU'?[['BALITA','Balita'],['BUMIL','Bumil'],['BUSUI','Busui']]:[['PESERTA_DIDIK','Peserta Didik'],['PENDIDIK','Pendidik'],['TENAGA_KEPENDIDIKAN','Tenaga Kependidikan']];cats.forEach(c=>{ %><option value="<%= c[0] %>" <%= pm.category===c[0]?'selected':'' %>><%= c[1] %></option><% }) %></select></label><% if(access.kpm_type!=='POSYANDU'){ %><label class="field"><span>Kelas / Kelompok</span><input class="input" name="class_group" value="<%= pm.class_group||'' %>" maxlength="80"></label><% } %></div><div class="actions"><a class="outline-btn" href="/portal/kpm/<%= portalToken %>">Batal</a><button class="primary-btn" type="submit">Kirim Perubahan</button></div></form></div></main></body></html>
