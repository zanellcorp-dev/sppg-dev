<!-- MODAL 6: DETAIL RINCIAN PAKET PENGAJUAN (VIEWER)               -->
<!-- ============================================================== -->
<div id="modalPackageDetail" class="pm-modal-backdrop" style="display:none" role="dialog" aria-modal="true">
  <div class="pm-modal-card pm-modal-card-lg">
    <div class="pm-modal-head neutral">
      <div class="pm-modal-icon-wrap neutral">📦</div>
      <div>
        <h3 style="margin:0;font-size:16px" id="modalDetailTitle">Rincian Paket Pembaruan Data</h3>
        <p style="margin:3px 0 0;font-size:12.5px;color:#64748b" id="modalDetailSubtitle">Daftar item perubahan data penerima manfaat.</p>
      </div>
      <button type="button" class="pm-modal-close" onclick="closeModal('modalPackageDetail')">&times;</button>
    </div>
    <div class="pm-modal-body">
      <div id="detailLoadingState" style="text-align:center;padding:24px;color:#64748b">
        <div class="pm-spinner" style="margin:0 auto 8px"></div>
        <span>Memuat rincian paket...</span>
      </div>
      <div id="detailContentState" style="display:none">
        <div class="pm-target-summary" style="margin-bottom:14px">
          <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:8px">
            <div>
              <small>INFORMASI PAKET</small>
              <strong id="detailPackageCode">-</strong>
              <span id="detailPackageStatus" class="pm-hc-badge draft">-</span>
            </div>
            <div style="text-align:right">
              <span id="detailEffectiveDate" style="font-size:12px;color:#64748b;display:block">Tanggal Berlaku: -</span>
              <span id="detailSubmitDate" style="font-size:11.5px;color:#94a3b8;display:block">Diajukan: -</span>
            </div>
          </div>
          <div id="detailReviewNoteBox" style="margin-top:8px;padding-top:8px;border-top:1px dashed #cbd5e1;font-size:12.5px">
            <strong>Catatan Ka. SPPG:</strong> <span id="detailReviewNoteText">-</span>
          </div>
        </div>

        <div class="kpm-table-wrap">
          <table class="kpm-table pm-table">
            <thead>
              <tr>
                <th style="width:36px;text-align:center">No</th>
                <th style="width:120px">Jenis</th>
                <th>Nama PM & NIK</th>
                <th>Kategori & Kelompok</th>
                <th>Keterangan / Alasan</th>
