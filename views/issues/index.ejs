<%- include('../partials/header') %>
<section class="panel"><div class="panel-head"><div><span class="panel-kicker">MONITORING</span><h2>Kendala Operasional</h2><p class="muted">Lifecycle: BARU → DITINDAKLANJUTI → MENUNGGU → SELESAI. Kendala tidak otomatis mengubah status pekerjaan.</p></div><a class="primary-btn" href="/issues/new">+ Laporkan Kendala</a></div>
<form class="filter-bar" method="get"><select name="status"><option value="">Semua status</option><% issueStatuses.forEach(x=>{ %><option value="<%= x %>" <%= status===x?'selected':'' %>><%= x.replaceAll('_',' ') %></option><% }) %></select><select name="team"><option value="">Semua tim</option><% operationalTeams.forEach(x=>{ %><option value="<%= x %>" <%= team===x?'selected':'' %>><%= x %></option><% }) %></select><button class="outline-btn">Filter</button></form>
<div class="table-wrap"><table><thead><tr><th>Tanggal</th><th>Tim</th><th>Kendala</th><th>Prioritas</th><th>Status</th><th>PIC</th><th>Tindak lanjut</th></tr></thead><tbody>
<% rows.forEach(r=>{ %><tr><td><%= String(r.work_date).slice(0,10) %></td><td><%= r.team %></td><td><strong><%= r.category.replaceAll('_',' ') %></strong><br><small><%= r.description %></small></td><td><span class="badge <%= r.priority==='KRITIS'?'red':r.priority==='PENTING'?'yellow':'green' %>"><%= r.priority %></span></td><td><%= r.status.replaceAll('_',' ') %></td><td><%= r.pic_name||'—' %></td><td><form method="post" action="/issues/<%= r.id %>/status" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="status"><% issueStatuses.forEach(x=>{ %><option value="<%= x %>" <%= r.status===x?'selected':'' %>><%= x.replaceAll('_',' ') %></option><% }) %></select><select name="pic_user_id"><option value="">PIC</option><% users.forEach(u=>{ %><option value="<%= u.id %>" <%= Number(r.pic_user_id)===Number(u.id)?'selected':'' %>><%= u.name %></option><% }) %></select><input name="resolution_note" placeholder="Catatan" value="<%= r.resolution_note||'' %>"><button class="outline-btn" type="submit">Simpan</button></form></td></tr><% }) %><% if(!rows.length){ %><tr><td colspan="7">Belum ada kendala dengan filter ini.</td></tr><% } %></tbody></table></div></section>
<%- include('../partials/footer') %>
