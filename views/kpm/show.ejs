<%- include('../partials/header') %>
<div class="card" style="margin-bottom:12px"><div class="actions"><a class="btn" href="/portal/kpm/preview/<%= kpm.id %>">Buka Dashboard KPM</a><form method="post" action="/kpm/<%= kpm.id %>/portal-token"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn gray" type="submit">Buat Link Akses KPM</button></form></div><p class="sub" style="margin:8px 0 0">Dashboard Preview menggunakan tampilan yang sama dengan portal yang dibuka KPM. Link akses privat digunakan untuk KPM.</p></div>
<div class="actions"><a class="btn secondary" href="/kpm/<%= kpm.id %>/edit?date=<%= date %>">✏️ Edit KPM</a><a class="btn" href="/kpm/<%= kpm.id %>/pm/new">＋ Tambah PM Detail</a><a class="btn gray" href="/kpm">← Kembali</a></div>
<div class="card" style="margin-top:16px"><h3 style="margin-top:0">Status KPM</h3><form method="post" action="/kpm/<%= kpm.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-grid"><div class="field"><label>Status *</label><select class="select" name="status" id="kpm-status"><option value="AKTIF" <%= (kpm.kpm_status||'AKTIF')==='AKTIF'?'selected':'' %>>Aktif</option><option value="NONAKTIF_SEMENTARA" <%= kpm.kpm_status==='NONAKTIF_SEMENTARA'?'selected':'' %>>Nonaktif Sementara</option><option value="NONAKTIF" <%= kpm.kpm_status==='NONAKTIF'?'selected':'' %>>Nonaktif</option></select></div><div class="field"><label>Mulai *</label><input class="input" type="date" name="start_date" value="<%= kpm.status_start||date %>" required></div><div class="field"><label>Selesai</label><input class="input" type="date" name="end_date" value="<%= kpm.status_end||'' %>"><div class="help">Untuk nonaktif sementara, isi jika sudah diketahui.</div></div><div class="field"><label>Alasan <span style="color:#b42318">*</span></label><select class="select" name="reason"><option value="">Pilih alasan</option><option <%= kpm.status_reason==='Libur'?'selected':'' %>>Libur</option><option <%= kpm.status_reason==='Hari Libur Nasional'?'selected':'' %>>Hari Libur Nasional</option><option <%= kpm.status_reason==='Kegiatan Sekolah'?'selected':'' %>>Kegiatan Sekolah</option><option <%= kpm.status_reason==='Posyandu Tidak Melaksanakan Kegiatan'?'selected':'' %>>Posyandu Tidak Melaksanakan Kegiatan</option><option <%= kpm.status_reason==='Penyesuaian Jadwal'?'selected':'' %>>Penyesuaian Jadwal</option><option <%= kpm.status_reason==='Kondisi Khusus'?'selected':'' %>>Kondisi Khusus</option><option <%= kpm.status_reason==='Lainnya'?'selected':'' %>>Lainnya</option></select></div><div class="field full"><label>Keterangan</label><textarea class="textarea" name="note" placeholder="Jelaskan alasan/status jika diperlukan"><%= kpm.status_note||'' %></textarea></div></div><div class="actions" style="margin-top:14px"><button class="btn" type="submit">Simpan Status & Rekam</button></div></form></div>
<div class="card" style="margin-top:16px"><div class="kpm-form-head"><div><span class="kpm-type <%= kpm.type==='POSYANDU'?'posyandu':'school' %>"><%= kpm.type==='POSYANDU'?'Posyandu':'Satuan Pendidikan' %></span><h2 style="margin:8px 0 3px"><%= kpm.name %></h2><div class="kpm-code"><%= kpm.code %> · <%= kpm.education_level||'Posyandu' %></div></div><form method="get" action="/kpm/<%= kpm.id %>"><div class="field-inline"><label>Tanggal Data</label><input class="input" type="date" name="date" value="<%= date %>" onchange="this.form.submit()"></div></form></div></div>
<div class="grid-2" style="margin-top:16px"><div class="card"><h3>Identitas KPM</h3><div class="rowline"><span>Alamat</span><strong><%= kpm.address %></strong></div><% if(kpm.type==='SATUAN_PENDIDIKAN'){ %><div class="rowline"><span>NPSN</span><strong><%= kpm.npsn||'-' %></strong></div><div class="rowline"><span>Kepala Satuan</span><strong><%= kpm.head_name||'-' %></strong></div><div class="rowline"><span>PIC MBG</span><strong><%= kpm.pic_name||'-' %></strong></div><% }else{ %><div class="rowline"><span>Kader Posyandu</span><strong><%= kpm.cadre_name||'-' %></strong></div><% } %><div class="rowline"><span>Koordinat</span><strong><%= kpm.latitude&&kpm.longitude?kpm.latitude+', '+kpm.longitude:'Belum ada' %></strong></div></div>
<div class="card"><h3>Rekap PM · <%= date %></h3><% if(kpm.type==='POSYANDU'){ %><div class="rowline"><span>Balita</span><strong><%= totals.balita %> <small>(L <%= countData?.balita_male||0 %> · P <%= countData?.balita_female||0 %>)</small></strong></div><div class="rowline"><span>Bumil</span><strong><%= totals.bumil %> <small>(P)</small></strong></div><div class="rowline"><span>Busui</span><strong><%= totals.busui %> <small>(P)</small></strong></div><% }else{ %><div class="rowline"><span>Porsi Kecil</span><strong><%= totals.small %> <small>(L <%= countData?.small_male||0 %> · P <%= countData?.small_female||0 %>)</small></strong></div><div class="rowline"><span>Porsi Besar</span><strong><%= totals.large %></strong></div><div class="rowline"><span>Pendidik</span><strong><%= totals.teacher %> <small>(L <%= countData?.teacher_male||0 %> · P <%= countData?.teacher_female||0 %>)</small></strong></div><div class="rowline"><span>Tendik</span><strong><%= totals.staff %> <small>(L <%= countData?.staff_male||0 %> · P <%= countData?.staff_female||0 %>)</small></strong></div><% } %><div class="kpm-total" style="margin-top:12px"><span>Total PM</span><strong><%= totals.total %></strong></div></div></div>
<div class="card" style="margin-top:16px"><h3>Riwayat Status KPM</h3><p class="sub">Setiap perubahan status, alasan, periode, dan keterangan disimpan sebagai rekaman.</p><% if(statusHistory&&statusHistory.length){ %><div class="table-wrap"><table class="table"><tr><th>Periode</th><th>Status</th><th>Alasan</th><th>Keterangan</th><th>Oleh</th></tr><% statusHistory.forEach(h=>{ %><tr><td><%= new Date(h.start_date).toLocaleDateString('id-ID') %> – <%= h.end_date?new Date(h.end_date).toLocaleDateString('id-ID'):'Berjalan' %></td><td><%= h.status==='NONAKTIF_SEMENTARA'?'Nonaktif Sementara':h.status==='NONAKTIF'?'Nonaktif':'Aktif' %></td><td><%= h.reason||'-' %></td><td><%= h.note||'-' %></td><td><%= h.username||'-' %></td></tr><% }) %></table></div><% }else{ %><div class="empty">Belum ada riwayat status.</div><% } %></div>
<div class="card" style="margin-top:16px"><h3>Riwayat Data PM</h3><p class="sub">Perubahan jumlah PM tidak menimpa data sebelumnya. Setiap pembaruan berlaku mulai tanggal yang dipilih.</p><% if(countData){ %><div class="rowline"><span>Data yang berlaku pada tanggal ini</span><strong>Mulai <%= new Date(countData.effective_from).toLocaleDateString('id-ID') %></strong></div><% }else{ %><div class="empty">Belum ada data PM untuk tanggal <%= date %>.</div><% } %></div>
<% if(pm.length){ %><div class="section">PM Detail · <%= pm.length %></div><div class="table-wrap"><table class="table"><tr><th>Nama</th><th>NIK</th><th>NISN</th><th>Kategori</th><th>L/P</th><th>Kelas</th><th>Aksi</th></tr><% pm.forEach(p=>{ %><tr><td><%= p.full_name %></td><td><%= p.nik||'-' %></td><td><%= p.nisn||'-' %></td><td><%= p.category.replaceAll('_',' ') %></td><td><%= p.gender||'-' %></td><td><%= p.class_group||'-' %></td><td><a class="btn secondary" href="/pm/<%= p.id %>/edit">✏️ Edit</a></td></tr><% }) %></table></div><% } %>
<%- include('../partials/footer') %>