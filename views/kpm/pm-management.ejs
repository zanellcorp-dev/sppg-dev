<%
  const schoolGroups = [['PENDIDIK','Pendidik'],['TENAGA_KEPENDIDIKAN','Tenaga Kependidikan'],['PESERTA_DIDIK','Peserta Didik']];
  const posyanduGroups = [['BALITA','Balita'],['BUMIL','Bumil'],['BUSUI','Busui']];
  const groups = access.kpm_type === 'POSYANDU' ? posyanduGroups : schoolGroups;
  const isPosyandu = access.kpm_type === 'POSYANDU';
  const totalPm = pm.length;
  const activePmCount = pm.filter(x => Number(x.active) === 1).length;
  const pendingPmCount = pm.filter(x => x.approval_status === 'MENUNGGU_VERIFIKASI_BGN').length;
  const inactivePmCount = totalPm - activePmCount - pendingPmCount;
%>

<section class="kpm-section pm-management-section" id="pm-management-section" aria-label="Manajemen Penerima Manfaat">
  <!-- Header & Keterangan Ruang Privat -->
  <div class="kpm-section-head pm-management-head">
    <div class="pm-head-title-wrap">
      <div class="pm-eyebrow-row">
        <span class="pm-eyebrow-tag">DATA MASTER PENERIMA MANFAAT</span>
        <span class="pm-privacy-pill" title="Data KPM ini berdiri sendiri dan tidak terhubung ke KPM lain">
          <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          Ruang Privat <%= isPosyandu ? 'Posyandu' : 'Satuan Pendidikan' %> · Terisolasi
        </span>
        <% if(previewMode){ %>
          <span class="pm-bgn-badge">
            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            Otorisasi Kepala / Admin BGN Aktif
          </span>
        <% } %>
      </div>
      <h2>Manajemen Penerima Manfaat KPM · <%= access.kpm_name %> <span class="pm-code-tag"><%= access.kpm_code %></span></h2>
      <p>Data operasional ruang privat <%= access.kpm_name %>. Seluruh pencatatan terisolasi secara mandiri. Kader/KPM dapat mengajukan perbaikan atau penonaktifan ke riwayat, dengan keputusan akhir dan pemulihan data diawasi oleh Kepala / Admin BGN.</p>
    </div>
  </div>

  <!-- Toolbar: Pencarian, Tab Kategori & Filter Status -->
  <div class="pm-toolbar">
    <!-- Kolom Kiri: Search Input -->
    <div class="pm-search-wrap">
      <svg class="pm-search-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input type="search" id="pmSearchInput" class="pm-search-input" placeholder="Cari nama lengkap, NIK, NISN..." autocomplete="off">
    </div>

    <!-- Kolom Tengah: Tab Kategori -->
    <div class="pm-cat-tabs" id="pmCatTabs" role="tablist">
      <button type="button" class="pm-tab-btn active" data-cat="ALL" onclick="window.setPmCategory('ALL')">
        <span>Semua</span>
        <span class="pm-tab-badge"><%= totalPm %></span>
      </button>
      <% groups.forEach(([cat, label]) => { 
        const count = pm.filter(x => x.category === cat).length;
      %>
        <button type="button" class="pm-tab-btn" data-cat="<%= cat %>" onclick="window.setPmCategory('<%= cat %>')">
          <span><%= label %></span>
          <span class="pm-tab-badge"><%= count %></span>
        </button>
      <% }) %>
    </div>

    <!-- Kolom Kanan: Filter Status -->
    <div class="pm-status-filter">
      <label for="pmStatusSelect" class="pm-filter-label">Status:</label>
      <select id="pmStatusSelect" class="pm-select-status">
        <option value="ALL">Semua Status (<%= totalPm %>)</option>
        <option value="ACTIVE" selected>Hanya Aktif (<%= activePmCount %>)</option>
        <% if(pendingPmCount > 0){ %>
          <option value="PENDING">Menunggu BGN (<%= pendingPmCount %>)</option>
        <% } %>
        <option value="INACTIVE">Nonaktif / Arsip (<%= inactivePmCount %>)</option>
      </select>
    </div>
  </div>

  <% if(isPosyandu){ %>
    <!-- Posyandu Sub-Grouping Cluster Bar -->
    <div class="pm-posyandu-cluster-bar" id="pmPosyanduClusterBar">
      <div class="pm-cluster-header">
        <div class="pm-cluster-title">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          <span id="pmClusterCategoryTitle">Pengelompokan Penerima Manfaat Posyandu</span>
        </div>
        <div class="pm-cluster-metrics" id="pmClusterMetrics">
          <!-- Metrik porsi dinamis via JS -->
        </div>
      </div>
      <div class="pm-cluster-subnav" id="pmClusterSubNav">
        <!-- Sub-filter pills dinamis via JS -->
      </div>
    </div>
  <% } %>

  <!-- Tabel Penerima Manfaat Terpadu -->
  <div class="kpm-table-wrap pm-table-wrap">
    <table class="kpm-table pm-table" id="pmDataTable">
      <thead>
        <tr>
          <th style="width:48px;text-align:center">No</th>
          <th>Nama Lengkap</th>
          <th>NIK</th>
          <th style="width:60px;text-align:center">L/P</th>
          <th>Kategori</th>
          <th id="pmGroupHeaderCol"><%= !isPosyandu ? 'Kelas / Kelompok' : 'Sub-Kelompok' %></th>
          <th style="width:130px;text-align:center">Status</th>
          <th style="width:240px;text-align:center">Aksi & Tata Kelola</th>
        </tr>
      </thead>
      <tbody id="pmTableBody">
        <% pm.forEach((x, i) => { 
          const isAct = Number(x.active) === 1;
          const isPending = x.approval_status === 'MENUNGGU_VERIFIKASI_BGN';
          let statusCategory = 'INACTIVE';
          if(isPending) statusCategory = 'PENDING';
          else if(isAct) statusCategory = 'ACTIVE';
        %>
          <tr class="pm-row <%= !isAct ? 'is-inactive' : '' %> <%= isPending ? 'is-pending' : '' %>" 
              data-cat="<%= x.category %>" 
              data-subcat="<%= (x.class_group || '').toLowerCase() %>"
              data-gender="<%= x.gender || '' %>"
              data-active="<%= isAct ? '1' : '0' %>"
              data-status="<%= statusCategory %>"
              data-search="<%= [x.full_name, x.nik, x.nisn, x.category, x.class_group].filter(Boolean).join(' ').toLowerCase() %>">
            <td style="text-align:center;font-weight:700;color:#6b7e94" class="pm-row-index"><%= i + 1 %></td>
            <td>
              <div class="pm-name-cell">
                <strong class="pm-fullname"><%= x.full_name %></strong>
                <% if(x.nisn){ %><small class="pm-meta-nisn">NISN: <%= x.nisn %></small><% } %>
              </div>
            </td>
            <td><code class="pm-nik-code"><%= x.nik || '-' %></code></td>
            <td style="text-align:center">
              <span class="pm-gender-badge <%= x.gender === 'P' ? 'female' : 'male' %>"><%= x.gender || '-' %></span>
            </td>
            <td>
              <span class="pm-cat-pill"><%= x.category ? x.category.replaceAll('_', ' ') : '-' %></span>
            </td>
            <td>
              <span class="pm-class-pill <%= isPosyandu ? 'posyandu-subgroup' : '' %>"><%= x.class_group || (isPosyandu ? 'Belum Dikelompokkan' : '-') %></span>
            </td>
            <td style="text-align:center">
              <% if(isPending){ %>
                <span class="pm-badge-pending" title="Permohonan nonaktif sedang menunggu keputusan Kepala BGN">
                  <span class="pm-dot-amber"></span> Menunggu BGN
                </span>
              <% } else if(isAct){ %>
                <span class="pm-badge-active">
                  <span class="pm-dot-green"></span> Aktif
                </span>
              <% } else { %>
                <span class="pm-badge-inactive" title="<%= x.deactivation_reason ? ('Alasan: ' + x.deactivation_reason) : 'Dinonaktifkan di arsip' %>">
                  <span class="pm-dot-gray"></span> Nonaktif
                </span>
              <% } %>
            </td>
            <td style="text-align:center">
              <div class="pm-action-group">
                <!-- 1. Tombol Edit -->
                <% if(previewMode){ %>
                  <a class="pm-btn pm-btn-edit" 
                     href="/pm/<%= x.id %>/edit?redirect=preview" 
                     onclick="event.stopPropagation()" 
                     title="Edit Data Master PM">
                    <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                    <span>Edit</span>
                  </a>
                <% } else if(isAct && !isPending){ %>
                  <a class="pm-btn pm-btn-edit" 
                     href="/portal/kpm/<%= portalToken %>/pm/<%= x.id %>/edit" 
                     onclick="event.stopPropagation()" 
                     title="Ajukan Perubahan Data PM">
                    <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                    <span>Edit</span>
                  </a>
                <% } %>

                <!-- 2. Tombol Aksi Status & Otorisasi BGN -->
                <% if(previewMode){ %>
                  <!-- AKSI OTORISASI INTERNAL KEPALA / ADMIN BGN -->
                  <% if(isPending){ %>
                    <button type="button" class="pm-btn pm-btn-approve" 
                            data-action="bgn-approve"
                            data-pm-id="<%= x.id %>"
                            data-pm-name="<%= (x.full_name || '').replace(/"/g, '&quot;') %>"
                            data-pm-reason="<%= (x.deactivation_reason || '').replace(/"/g, '&quot;') %>"
                            onclick="window.handlePmAction(this, event)"
                            title="Setujui Penonaktifan (Otorisasi Kepala BGN)">
                      <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                      <span>Setujui</span>
                    </button>
                    <button type="button" class="pm-btn pm-btn-reject" 
                            data-action="bgn-reject"
                            data-pm-id="<%= x.id %>"
                            data-pm-name="<%= (x.full_name || '').replace(/"/g, '&quot;') %>"
                            data-pm-reason="<%= (x.deactivation_reason || '').replace(/"/g, '&quot;') %>"
                            onclick="window.handlePmAction(this, event)"
                            title="Tolak / Batalkan Permohonan Hapus (Tetap Aktif)">
                      <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                      <span>Batalkan</span>
                    </button>
                  <% } else if(isAct){ %>
                    <button type="button" class="pm-btn pm-btn-delete" 
                            data-action="deactivate"
                            data-pm-id="<%= x.id %>"
                            data-pm-name="<%= (x.full_name || '').replace(/"/g, '&quot;') %>"
                            data-pm-nik="<%= (x.nik || '-').replace(/"/g, '&quot;') %>"
                            data-pm-cat="<%= x.category %>"
                            data-is-admin="true"
                            onclick="window.handlePmAction(this, event)"
                            title="Nonaktifkan PM langsung ke arsip riwayat">
                      <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                      <span>Hapus</span>
                    </button>
                  <% } else { %>
                    <button type="button" class="pm-btn pm-btn-reactivate" 
                            data-action="reactivate"
                            data-pm-id="<%= x.id %>"
                            data-pm-name="<%= (x.full_name || '').replace(/"/g, '&quot;') %>"
                            data-pm-nik="<%= (x.nik || '-').replace(/"/g, '&quot;') %>"
                            data-pm-reason="<%= (x.deactivation_reason || '').replace(/"/g, '&quot;') %>"
                            onclick="window.handlePmAction(this, event)"
                            title="Pulihkan / Kembalikan Data ke Aktif (Otorisasi Kepala BGN)">
                      <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
                      <span>Pulihkan</span>
                    </button>
                  <% } %>
                <% } else { %>
                  <!-- AKSI PENGGUNA UMUM / KADER PORTAL KPM -->
                  <% if(isPending){ %>
                    <span class="pm-action-locked" title="Permohonan telah terkirim. Menunggu keputusan resmi Kepala / Admin BGN.">
                      <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                      Menunggu BGN
                    </span>
                  <% } else if(isAct){ %>
                    <button type="button" class="pm-btn pm-btn-delete" 
                            data-action="deactivate"
                            data-pm-id="<%= x.id %>"
                            data-pm-name="<%= (x.full_name || '').replace(/"/g, '&quot;') %>"
                            data-pm-nik="<%= (x.nik || '-').replace(/"/g, '&quot;') %>"
                            data-pm-cat="<%= x.category %>"
                            data-is-admin="false"
                            onclick="window.handlePmAction(this, event)"
                            title="Ajukan Penonaktifan PM ke Arsip Riwayat">
                      <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                      <span>Hapus</span>
                    </button>
                  <% } else { %>
                    <span class="pm-action-locked" title="Data berada di arsip riwayat resmi. Hanya Kepala / Admin BGN yang berwenang memulihkan data.">
                      <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                      Arsip BGN
                    </span>
                  <% } %>
                <% } %>

                <!-- 3. Tombol Riwayat Rekam Jejak (Tersambung ke Riwayat BGN) -->
                <button type="button" class="pm-btn pm-btn-history" 
                        data-action="history"
                        data-pm-id="<%= x.id %>"
                        data-pm-name="<%= (x.full_name || '').replace(/"/g, '&quot;') %>"
                        data-pm-nik="<%= (x.nik || '-').replace(/"/g, '&quot;') %>"
                        data-pm-cat="<%= x.category %>"
                        data-pm-act="<%= isAct ? 1 : 0 %>"
                        data-pm-status="<%= x.approval_status || (isAct ? 'AKTIF' : 'NONAKTIF_DISETUJUI') %>"
                        data-pm-subgroup="<%= (x.class_group || '').replace(/"/g, '&quot;') %>"
                        onclick="window.handlePmAction(this, event)"
                        title="Lihat Riwayat & Rekam Jejak Otorisasi BGN">
                  <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                  <span>Riwayat</span>
                </button>
              </div>
            </td>
          </tr>
        <% }) %>
        <tr id="pmEmptyRow" style="display:none">
          <td colspan="<%= !isPosyandu ? 8 : 8 %>" class="kpm-empty pm-empty-box">
            <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="#8fa0b5" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom:8px"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <div><strong>Tidak ada data penerima manfaat yang sesuai pada kategori ini.</strong></div>
            <small style="color:#788b9e">Silakan klik kategori lain atau bersihkan kata kunci pencarian.</small>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</section>

<!-- ============================================================== -->
<!-- MODAL 1: HAPUS / NONAKTIFKAN (SOFT DELETE / PERMOHONAN KE BGN) -->
<!-- ============================================================== -->
<div id="pmDeactivateModal" class="pm-modal-backdrop" style="display:none" role="dialog" aria-modal="true" aria-labelledby="deactModalTitle">
  <div class="pm-modal-card">
    <div class="pm-modal-head danger">
      <div class="pm-modal-icon-wrap danger">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
      </div>
      <div>
        <h3 id="deactModalTitle">Hapus / Nonaktifkan Penerima Manfaat</h3>
        <p id="deactModalSubtitle">Data tersimpan aman di riwayat arsip dan tidak terhapus permanen.</p>
      </div>
      <button type="button" class="pm-modal-close" onclick="closeDeactivateModal()" aria-label="Tutup">&times;</button>
    </div>

    <form id="pmDeactivateForm" method="post" action="">
      <input type="hidden" name="active" value="0">
      <% if(previewMode){ %><input type="hidden" name="decision" value="DIRECT_DEACTIVATE"><% } %>

      <div class="pm-modal-body">
        <div class="pm-target-summary">
          <small>PENERIMA MANFAAT YANG DIPILIH</small>
          <strong id="deactTargetName">-</strong>
          <span id="deactTargetMeta" class="pm-target-meta">NIK: -</span>
        </div>

        <div class="pm-notice-softdelete">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#b45309" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          <div>
            <strong id="deactNoticeHeading">Penerima manfaat ini akan dinonaktifkan dari distribusi harian.</strong>
            <span id="deactNoticeBody">Data historis tetap utuh dan dicatat di riwayat rekam jejak. Sesuai tata kelola, keputusan akhir berada di bawah otorisasi Kepala / Admin BGN.</span>
          </div>
        </div>

        <div class="pm-form-field">
          <label for="deactEffectiveFrom">Tanggal Efektif Perubahan <span style="color:#d92d20">*</span></label>
          <input type="date" id="deactEffectiveFrom" name="effective_from" class="pm-modal-input" value="<%= new Date().toISOString().slice(0,10) %>" required>
          <small style="color:#64748b;font-size:11.5px;margin-top:3px;display:block">Tanggal mulai berlakunya perubahan status ini ke dalam arsip riwayat resmi.</small>
        </div>

        <div class="pm-form-field">
          <label for="deactReasonSelect">Pilih Alasan Penonaktifan <span style="color:#d92d20">*</span></label>
          <select id="deactReasonSelect" name="reason" class="pm-modal-select" required>
            <option value="">— Pilih Alasan Resmi —</option>
            <% if(isPosyandu){ %>
              <option value="Sudah tidak lagi menerima manfaat (Bukan lagi kategori penerima manfaat)">Sudah tidak lagi menerima manfaat (Bukan lagi kategori penerima manfaat)</option>
              <option value="Sedang keluar kota / sementara tidak mengambil manfaat">Sedang keluar kota / sementara tidak mengambil manfaat</option>
              <option value="Melewati Batas Usia Balita (> 2 Tahun / > 5 Tahun)">Melewati Batas Usia Balita (> 2 Tahun / > 5 Tahun)</option>
              <option value="Ibu Sudah Melahirkan / Selesai Masa Menyusui">Ibu Sudah Melahirkan / Selesai Masa Menyusui</option>
              <option value="Pindah Domisili / Pindah Alamat">Pindah Domisili / Pindah Alamat</option>
              <option value="Nonaktif Sementara">Nonaktif Sementara</option>
              <option value="Koreksi / Data Duplikat">Koreksi / Data Duplikat</option>
              <option value="Lainnya">Lainnya</option>
            <% } else { %>
              <option value="Sudah tidak lagi menerima manfaat (Bukan lagi kategori penerima manfaat)">Sudah tidak lagi menerima manfaat (Bukan lagi kategori penerima manfaat)</option>
              <option value="Sedang keluar kota / sementara tidak mengambil manfaat">Sedang keluar kota / sementara tidak mengambil manfaat</option>
              <option value="Lulus Sekolah">Lulus Sekolah</option>
              <option value="Pindah Sekolah / Mutasi">Pindah Sekolah / Mutasi</option>
              <option value="Mengundurkan Diri">Mengundurkan Diri</option>
              <option value="Purna Tugas / Mutasi Guru & Tendik">Purna Tugas / Mutasi Guru & Tendik</option>
              <option value="Nonaktif Sementara">Nonaktif Sementara</option>
              <option value="Koreksi / Data Duplikat">Koreksi / Data Duplikat</option>
              <option value="Lainnya">Lainnya</option>
            <% } %>
          </select>
        </div>

        <div class="pm-form-field">
          <label for="deactCustomNote">Keterangan / Catatan Tambahan Petugas (Opsional)</label>
          <input type="text" id="deactCustomNote" name="custom_note" class="pm-modal-input" placeholder="Contoh: Sedang ke luar kota selama beberapa hari, atau keterangan lainnya...">
        </div>
      </div>

      <div class="pm-modal-foot">
        <button type="button" class="pm-modal-btn secondary" onclick="closeDeactivateModal()">Batal</button>
        <button type="submit" class="pm-modal-btn danger">
