<%- include('../partials/header') %>
<section class="panel form-panel"><div class="panel-head"><div><span class="panel-kicker">KLOTER DISTRIBUSI</span><h2>Edit Kloter <%= cluster.cluster_no %></h2><p class="muted"><%= cluster.distribution_date %> · <%= cluster.kpm_type==='POSYANDU'?'Posyandu':'Satuan Pendidikan' %></p></div><a class="outline-btn" href="/distribution/<%= cluster.id %>">Kembali</a></div><form method="post" action="/distribution/cluster/<%= cluster.id %>/update"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-grid"><div class="field"><label>Nomor Kloter</label><input class="input" value="<%= cluster.cluster_no %>" disabled></div><div class="field"><label>Jenis KPM</label><input class="input" value="<%= cluster.kpm_type==='POSYANDU'?'Posyandu':'Satuan Pendidikan' %>" disabled></div><div class="field"><label>Jalur</label><input class="input" name="route_name" value="<%= cluster.route_name||'' %>"></div><div class="field"><label>Kurir Distribusi</label><select class="select" name="staff_id"><option value="">— Pilih Kurir —</option><% staff.forEach(s=>{ %><option value="<%= s.id %>" <%= Number(cluster.staff_id)===Number(s.id)?'selected':'' %>><%= s.name %></option><% }) %></select></div><div class="field"><label>Kendaraan</label><select class="select" name="vehicle"><option <%= cluster.vehicle==='E 8684 RD'?'selected':'' %>>E 8684 RD</option><option <%= cluster.vehicle==='E 8871 RD'?'selected':'' %>>E 8871 RD</option></select></div><div class="field"><label>Keberangkatan</label><input class="input" type="time" name="departure_time" value="<%= cluster.departure_time||'' %>"></div><div class="field"><label>Kembali ke SPPG</label><input class="input" type="time" name="return_time" value="<%= cluster.return_time||'' %>"></div></div><div class="dist-kpm-section"><div class="dist-kpm-head"><div><span class="dist-kpm-kicker">PENERIMA MANFAAT</span><h3>Daftar KPM dalam Kloter</h3><p>Pilih atau batalkan KPM. Porsi kecil dan besar mengikuti Master KPM pada tanggal distribusi.</p></div><div class="dist-kpm-summary"><b id="selectedCount">0</b><span>KPM terpilih</span><em><span id="selectedSmall">0</span> kecil · <span id="selectedLarge">0</span> besar</em></div></div><div class="dist-kpm-tools"><div class="dist-kpm-search"><i data-lucide="search"></i><input id="kpmSearch" type="search" placeholder="Cari kode atau nama KPM..."></div><span id="visibleKpmCount"></span></div><div class="dist-kpm-grid"><% kpms.filter(k=>k.type===cluster.kpm_type).forEach(k=>{ %><div class="dist-kpm-card" data-kpm-search="<%= (k.code+' '+k.name).toLowerCase() %>"><label class="dist-kpm-check"><input type="checkbox" name="kpm_ids" value="<%= k.id %>" data-small="<%= k.small_portions %>" data-large="<%= k.large_portions %>" <%= k.selected_id?'checked':'' %>><span class="dist-checkmark"></span><span class="dist-kpm-main"><strong><%= k.name %></strong><small><%= k.code %> · <%= k.type==='POSYANDU'?'Posyandu':'Satuan Pendidikan' %></small></span></label><div class="dist-kpm-portions"><span><b><%= k.small_portions %></b><small>Porsi Kecil</small></span><span><b><%= k.large_portions %></b><small>Porsi Besar</small></span><span><b><%= Number(k.small_portions)+Number(k.large_portions) %></b><small>Total PM</small></span></div><div class="dist-kpm-times"><label>Serah Terima<input class="input dist-time-input" type="time" name="handover[<%= k.id %>]" value="<%= k.handover_time||'' %>"></label><label>Pengambilan<input class="input dist-time-input" type="time" name="pickup[<%= k.id %>]" value="<%= k.pickup_time||'' %>"></label></div></div><% }) %></div></div><div class="field"><label>Catatan</label><textarea class="textarea" name="notes"><%= cluster.notes||'' %></textarea></div><button class="primary-btn"><i data-lucide="save"></i>Simpan Perubahan</button></form></section><script>document.addEventListener('DOMContentLoaded',()=>{const boxes=[...document.querySelectorAll('input[name="kpm_ids"]')],cards=[...document.querySelectorAll('.dist-kpm-card')],search=document.getElementById('kpmSearch'),count=document.getElementById('selectedCount'),small=document.getElementById('selectedSmall'),large=document.getElementById('selectedLarge'),visible=document.getElementById('visibleKpmCount');function refresh(){const q=(search.value||'').toLowerCase().trim();let n=0,s=0,l=0,vis=0;cards.forEach(card=>{const show=!q||card.dataset.kpmSearch.includes(q);card.style.display=show?'':'none';if(show)vis++;const b=card.querySelector('input[name="kpm_ids"]');if(b.checked){n++;s+=Number(b.dataset.small||0);l+=Number(b.dataset.large||0)}});count.textContent=n;small.textContent=s;large.textContent=l;visible.textContent=vis+' KPM tersedia'}boxes.forEach(b=>b.addEventListener('change',refresh));search.addEventListener('input',refresh);refresh()});</script><%- include('../partials/footer') %>
