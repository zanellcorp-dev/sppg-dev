<%- include('../partials/header') %><section class="panel"><div class="panel-head"><div><span class="panel-kicker">MONITORING</span><h2>Exception Engine</h2><p class="muted">Daftar kondisi yang membutuhkan perhatian atau tindak lanjut.</p></div><form class="filter-inline"><label>Tanggal<input type="date" name="date" value="<%= date %>"></label><button class="outline-btn">Refresh</button></form></div><div class="operational-card-grid"><% rows.forEach(r=>{ %><article class="operational-task-card"><div class="task-card-head"><div><span class="task-eyebrow"><%= r.severity %> · <%= r.team||'SISTEM' %></span><h3><%= r.title %></h3><small><%= r.detail||'' %></small></div><span class="task-status <%= r.status==='OPEN'?'progress':'done' %>"><%= r.status %></span></div><div class="task-actions"><% if(r.status==='OPEN'){ %><form method="post" action="/exceptions/<%= r.id %>/resolve"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="date" value="<%= date %>"><button class="primary-btn">Tandai Selesai</button></form><% } %></div></article><% }) %><% if(!rows.length){ %><div class="empty-state"><strong>Tidak ada exception.</strong><span>Kondisi operasional untuk tanggal ini tidak memiliki exception yang terdeteksi.</span></div><% } %></div></section><%- include('../partials/footer') %>
