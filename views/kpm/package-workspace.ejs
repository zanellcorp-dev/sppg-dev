        <input type="hidden" id="catChangeTargetPmId">
        <input type="hidden" id="catChangeTargetName">
        <input type="hidden" id="catChangeTargetNik">
        <input type="hidden" id="catChangeTargetGender">
        <input type="hidden" id="catChangeSourceCategory">
        <input type="hidden" id="catChangeSourceClass">

        <div class="pm-selected-preview" id="catChangeSelectedPreview" style="display:none"></div>

        <div id="catChangeFormFields" style="display:none;margin-top:14px">
