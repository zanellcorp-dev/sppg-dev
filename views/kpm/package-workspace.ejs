      <div class="pm-modal-foot">
        <button type="button" class="btn gray" onclick="closeModal('modalCategoryChange')">Batal</button>
        <button type="button" class="btn primary" onclick="window.handleAddCategoryChangeSubmit()" style="background:#047857;color:#fff;border:none;padding:9px 18px;border-radius:8px;font-weight:700;cursor:pointer">
