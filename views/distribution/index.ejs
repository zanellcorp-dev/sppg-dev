<%- include('../partials/header') %>
<section class="module-hero panel dist-hero"><div><span class="panel-kicker">OPERASIONAL SPPG</span><h2>Jadwal Distribusi</h2><p>Jadwal acuan dari menu, proses SPPG, kloter, hingga waktu tiap KPM. Bukan halaman monitoring progres.</p></div><a class="primary-btn" href="/distribution/new?date=<%= date %>"><i data-lucide="plus"></i>Buat / Edit Jadwal</a></section>
<section class="panel dist-filter"><form class="dist-filter-form"><label>Tanggal Distribusi<input type="date" name="date" value="<%= date %>"></label><label>Jenis KPM<select name="type"><option value="">Semua Jenis KPM</option><option value="SATUAN_PENDIDIKAN" <%= filterType==='SATUAN_PENDIDIKAN'?'selected':'' %>>Satuan Pendidikan</option><option value="POSYANDU" <%= filterType==='POSYANDU'?'selected':'' %>>Posyandu</option></select></label><label>Kloter<select name="cluster"><option>Semua Kloter</option><% clusters.forEach(c=>{ %><option value="<%= c.cluster_no %>" <%= Number(filterCluster)===Number(c.cluster_no)?'selected':'' %>>Kloter <%= c.cluster_no %></option><% }) %></select></label><label>Jalur<select name="route"><option>Semua Jalur</option><% [...new Set(clusters.map(c=>c.route_name).filter(Boolean))].forEach(r=>{ %><option value="<%= r %>" <%= filterRoute===r?'selected':'' %>><%= r %></option><% }) %></select></label><label class="dist-search">Cari KPM<input type="search" name="q" value="<%= filterQ %>" placeholder="Nama / kode KPM"></label><button class="outline-btn"><i data-lucide="filter"></i>Tampilkan</button></form></section>
<section class="dashboard-grid four-col dist-stats"><div class="stat-card green"><div class="stat-icon"><i data-lucide="layers"></i></div><div><small>Kloter</small><strong><%= totals.clusters||0 %></strong></div></div><div class="stat-card blue"><div class="stat-icon"><i data-lucide="school"></i></div><div><small>KPM</small><strong><%= totals.kpm_count||0 %></strong></div></div><div class="stat-card purple"><div class="stat-icon"><i data-lucide="package"></i></div><div><small>Porsi Kecil</small><strong><%= totals.small_total||0 %></strong></div></div><div class="stat-card yellow"><div class="stat-icon"><i data-lucide="package-check"></i></div><div><small>Porsi Besar</small><strong><%= totals.large_total||0 %></strong></div></div></section>
<section class="panel dist-section"><div class="panel-head"><div><span class="panel-kicker">1 · MENU</span><h3>Menu tanggal <%= date %></h3></div></div><div class="dist-menu-grid"><div class="dist-menu"><span>Satuan Pendidikan</span><strong><%= schedule?.menu_sp_name || 'Belum ditentukan' %></strong></div><div class="dist-menu"><span>Posyandu</span><strong><%= schedule?.menu_pos_name || 'Belum ditentukan' %></strong></div></div></section>
<section class="panel dist-section"><div class="panel-head"><div><span class="panel-kicker">2 · WAKTU ACUAN SPPG</span><h3>Waktu proses</h3></div></div><div class="dist-process-grid"><div><span>Persiapan</span><b><%= schedule?.prep_start||'—' %> — <%= schedule?.prep_end||'—' %></b></div><div><span>Pengolahan</span><b><%= schedule?.processing_start||'—' %> — <%= schedule?.processing_end||'—' %></b></div><div><span>Pemorsian</span><b><%= schedule?.portioning_start||'—' %> — <%= schedule?.portioning_end||'—' %></b></div><div><span>Pencucian</span><b><%= schedule?.washing_start||'—' %> — <%= schedule?.washing_end||'—' %></b></div></div></section>
<section class="panel dist-section"><div class="panel-head"><div><span class="panel-kicker">3 · KLOTER DISTRIBUSI</span><h3>Kloter tanggal <%= date %></h3></div><% if(schedule){ %><a class="primary-btn" href="/distribution/cluster/new?schedule_id=<%= schedule.id %>"><i data-lucide="plus"></i>Tambah Kloter</a><% } %></div><div class="dist-cluster-grid"><% clusters.forEach(c=>{ %><article class="dist-cluster-card"><div class="dist-cluster-top"><div><span class="badge green">KLOTER <%= c.cluster_no %></span><h4><%= c.kpm_type==='POSYANDU'?'Posyandu':'Satuan Pendidikan' %></h4><p><%= c.route_name||'Jalur belum ditentukan' %></p></div><a class="outline-btn" href="/distribution/<%= c.id %>">Lihat Kloter <i data-lucide="arrow-right"></i></a></div><div class="dist-meta"><span><i data-lucide="truck"></i><b><%= c.vehicle %></b></span><span><i data-lucide="user"></i><%= c.driver_name||'Kurir belum dipilih' %></span></div><div class="dist-total"><div><small>KPM</small><strong><%= c.kpm_count %></strong></div><div><small>Kecil</small><strong><%= c.small_total %></strong></div><div><small>Besar</small><strong><%= c.large_total %></strong></div><div><small>Total PM</small><strong><%= c.pm_total %></strong></div></div><div class="dist-time-row"><span>Keberangkatan <b><%= c.departure_time||'—' %></b></span><span>Kembali SPPG <b><%= c.return_time||'—' %></b></span></div><div class="dist-kpm-card"><div class="dist-kpm-card-head"><strong>Daftar KPM & Porsi</strong><span><%= c.kpm_count %> KPM</span></div><div class="dist-kpm-list"><% (c.kpm_items||[]).forEach((k,i)=>{ %><div class="dist-kpm-row"><div class="dist-kpm-name"><b><%= i+1 %>. <%= k.name %></b><small><%= k.code %></small></div><div class="dist-kpm-portion"><span>Kecil <b><%= k.small_portions %></b></span><span>Besar <b><%= k.large_portions %></b></span></div></div><% }) %></div></div></article><% }) %><% if(!clusters.length){ %><div class="empty-state compact dist-empty"><i data-lucide="truck"></i><strong>Belum ada kloter</strong><span>Buat jadwal tanggal ini lalu tambahkan kloter distribusi.</span></div><% } %></div></section>
<%- include('../partials/footer') %>
