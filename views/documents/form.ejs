<%- include('../partials/header') %>
<section class="panel form-panel"><div class="panel-head"><div><span class="panel-kicker">DOKUMEN & SOP BGN</span><h2><%= row?'Edit Dokumen':'Tambah Dokumen / SOP' %></h2><p class="muted">Simpan dokumen secara terpusat agar mudah ditemukan dan diperbarui.</p></div><a class="outline-btn" href="/documents">Kembali</a></div><form method="post" action="<%= row?'/documents/'+row.id:'/documents' %>" enctype="multipart/form-data"><% if(row){ %><input type="hidden" name="_method" value="PUT"><% } %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-grid"><div class="field"><label>Jenis Dokumen *</label><select class="select" required name="doc_type"><option value="JUKNIS" <%= row?.doc_type==='JUKNIS'?'selected':'' %>>Juknis</option><option value="SURAT_EDARAN" <%= row?.doc_type==='SURAT_EDARAN'?'selected':'' %>>Surat Edaran</option><option value="SOP" <%= row?.doc_type==='SOP'?'selected':'' %>>SOP</option></select></div><div class="field"><label>Judul Dokumen *</label><input class="input" required name="title" value="<%= row?.title||'' %>"></div><div class="field"><label>Nomor Dokumen</label><input class="input" name="document_number" value="<%= row?.document_number||'' %>"></div><div class="field"><label>Tanggal Dokumen</label><input class="input" type="date" name="document_date" value="<%= row?.document_date||'' %>"></div><div class="field full"><label>Deskripsi</label><textarea class="textarea" name="description"><%= row?.description||'' %></textarea></div><div class="field full"><label>File Dokumen <%= row?'(opsional, ganti file jika perlu)':'*' %></label><input class="input" type="file" name="file" accept=".pdf,.jpg,.jpeg,.png" <%= row?'':'required' %>></div></div><button class="primary-btn" type="submit"><i data-lucide="save"></i><%= row?'Simpan Perubahan':'Simpan Dokumen' %></button></form></section><%- include('../partials/footer') %>
