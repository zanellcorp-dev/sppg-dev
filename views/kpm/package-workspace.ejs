  // 7. Dynamic Dropdowns
  function updateNewPmSubgroupOptions() {
    var catSelect = document.getElementById('newPmCategorySelect');
    var subSelect = document.getElementById('newPmSubgroupSelect');
    if (!catSelect || !subSelect) return;
    var cat = catSelect.value;

    if (KPM_TYPE === 'POSYANDU') {
      if (cat === 'BALITA') {
        subSelect.innerHTML = '<option value="0-5 Bulan (Bayi)">0-5 Bulan (Bayi)</option><option value="6-23 Bulan (Baduta)" selected>6-23 Bulan (Baduta)</option><option value="24-59 Bulan (Balita)">24-59 Bulan (Balita)</option>';
      } else if (cat === 'BUMIL') {
        subSelect.innerHTML = '<option value="Trimester 1 (1–12 Minggu)">Trimester 1 (1–12 Minggu)</option><option value="Trimester 2 (13–27 Minggu)" selected>Trimester 2 (13–27 Minggu)</option><option value="Trimester 3 (28–40 Minggu)">Trimester 3 (28–40 Minggu)</option>';
      } else if (cat === 'BUSUI') {
        subSelect.innerHTML = '<option value="Bayi 0–6 Bulan (ASI Eksklusif)" selected>Bayi 0–6 Bulan (ASI Eksklusif)</option><option value="Bayi >6 Bulan (MPASI & Menyusui)">Bayi >6 Bulan (MPASI & Menyusui)</option>';
      }
    } else {
      if (cat === 'PESERTA_DIDIK') {
        subSelect.innerHTML = '<option value="Kelas 1" selected>Kelas 1</option><option value="Kelas 2">Kelas 2</option><option value="Kelas 3">Kelas 3</option><option value="Kelas 4">Kelas 4</option><option value="Kelas 5">Kelas 5</option><option value="Kelas 6">Kelas 6</option>';
      } else {
        subSelect.innerHTML = '<option value="Pendidik/Guru">Pendidik/Guru</option><option value="Tenaga Kependidikan">Tenaga Kependidikan</option>';
      }
    }
  }

  function updateCatChangeSubgroups() {
    var targetCatSelect = document.getElementById('catChangeTargetCat');
    var select = document.getElementById('catChangeTargetSubgroup');
    if (!targetCatSelect || !select) return;
    var targetCat = targetCatSelect.value;

    if (KPM_TYPE === 'POSYANDU') {
      if (targetCat === 'BUSUI') {
        select.innerHTML = '<option value="Bayi 0–6 Bulan (ASI Eksklusif)" selected>Bayi 0–6 Bulan (ASI Eksklusif)</option><option value="Bayi >6 Bulan (MPASI & Menyusui)">Bayi >6 Bulan (MPASI & Menyusui)</option>';
      } else if (targetCat === 'BUMIL') {
        select.innerHTML = '<option value="Trimester 1 (1–12 Minggu)">Trimester 1 (1–12 Minggu)</option><option value="Trimester 2 (13–27 Minggu)" selected>Trimester 2 (13–27 Minggu)</option><option value="Trimester 3 (28–40 Minggu)">Trimester 3 (28–40 Minggu)</option>';
      } else if (targetCat === 'BALITA') {
        select.innerHTML = '<option value="0-5 Bulan (Bayi)">0-5 Bulan (Bayi)</option><option value="6-23 Bulan (Baduta)" selected>6-23 Bulan (Baduta)</option><option value="24-59 Bulan (Balita)">24-59 Bulan (Balita)</option>';
      }
    } else {
      if (targetCat === 'PESERTA_DIDIK') {
        select.innerHTML = '<option value="Kelas 2">Naik ke Kelas 2</option><option value="Kelas 3">Naik ke Kelas 3</option><option value="Kelas 4">Naik ke Kelas 4</option><option value="Kelas 5">Naik ke Kelas 5</option><option value="Kelas 6">Naik ke Kelas 6</option>';
      } else {
