<%- include('../partials/header') %>
<section class="panel"><div class="panel-head"><div><span class="panel-kicker">DOKUMEN & SOP BGN</span><h2>Dashboard Dokumen</h2><p class="muted">Juknis, Surat Edaran, dan SOP yang digunakan SPPG.</p></div><a class="primary-btn" href="/documents/new"><i data-lucide="plus"></i>Tambah Dokumen/SOP</a></div><div class="chip-row"><% ['SEMUA','JUKNIS','SURAT_EDARAN','SOP'].forEach(t=>{ %><a class="filter-chip <%= type===t?'active':'' %>" href="/documents?type=<%= t %>"><%= t==='SURAT_EDARAN'?'Surat Edaran':t==='SEMUA'?'Semua':t %></a><% }) %></div><div class="card-list"><% rows.forEach(r=>{ %><article class="list-card"><div><span class="status-pill info"><%= r.doc_type.replace('_',' ') %></span><h3><%= r.title %></h3><p><%= r.document_number||'Nomor dokumen belum diisi' %> · <%= r.document_date||'-' %></p></div><div class="list-actions"><a class="outline-btn" href="/documents/<%= r.id %>/edit">Edit</a><% if(r.file_path){ %><a class="outline-btn" href="/documents/<%= r.id %>/file">Buka</a><% } %></div></article><% }) %><% if(!rows.length){ %><div class="empty-state"><i data-lucide="files"></i><strong>Belum ada dokumen</strong><span>Tambahkan Juknis, Surat Edaran, atau SOP untuk memulai.</span></div><% } %></div></section>
<%- include('../partials/footer') %>
