<%- include('../partials/header') %><form method="post" action="<%= staff?'/staff/'+staff.id:'/staff' %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% if(staff){ %><input type="hidden" name="_method" value="PUT"><% } %><div class="card"><h2>👤 Informasi Pribadi</h2><p class="sub">Isi sesuai dokumen resmi. Field bertanda * wajib diisi.</p><div class="form-grid"><div class="field"><label>Nama Lengkap *</label><input required class="input" name="name" value="<%= staff?.name||'' %>"></div><div class="field"><label>NIK *</label><input required maxlength="16" class="input" name="nik" value="<%= staff?.nik||'' %>"><div class="help">16 digit sesuai E-KTP.</div></div><div class="field"><label>KPJ BPJSTK</label><input class="input" name="kpj_bpjstk" value="<%= staff?.kpj_bpjstk||'' %>"><div class="help">Nomor kepesertaan BPJS Ketenagakerjaan.</div></div><div class="field"><label>Tanggal Masuk Bekerja</label><input type="date" class="input" name="tanggal_masuk_bekerja" value="<%= staff?.tanggal_masuk_bekerja?new Date(staff.tanggal_masuk_bekerja).toISOString().slice(0,10):'' %>"></div><div class="field"><label>Tempat Lahir</label><input class="input" name="birth_place" value="<%= staff?.birth_place||'' %>"></div><div class="field"><label>Tanggal Lahir</label><input type="date" class="input" name="birth_date" value="<%= staff?.birth_date?new Date(staff.birth_date).toISOString().slice(0,10):'' %>"></div><div class="field"><label>Jenis Kelamin</label><select class="select" name="gender"><option value="">Pilih</option><option value="L" <%= staff?.gender==='L'?'selected':'' %>>Laki-laki</option><option value="P" <%= staff?.gender==='P'?'selected':'' %>>Perempuan</option></select></div><div class="field"><label>Status Kawin</label><select class="select" name="marital_status"><option value="">Pilih</option><% ['Lajang','Menikah','Janda/Duda'].forEach(x=>{ %><option <%= staff?.marital_status===x?'selected':'' %>><%= x %></option><% }) %></select></div><div class="field"><label>Jabatan *</label><select required class="select" name="position"><option value="">Pilih Jabatan</option><% positions.forEach(x=>{ %><option <%= staff?.position===x?'selected':'' %>><%= x %></option><% }) %></select></div><div class="field"><label>Status</label><select class="select" name="status"><% statuses.forEach(x=>{ %><option value="<%= x %>" <%= (staff?.status||'AKTIF')===x?'selected':'' %>><%= x.replaceAll('_',' ') %></option><% }) %></select></div><div class="field"><label>No. HP/WhatsApp</label><input class="input" name="phone" value="<%= staff?.phone||'' %>"></div><div class="field"><label>Email</label><input type="email" class="input" name="email" value="<%= staff?.email||'' %>"></div><div class="field full"><label>Alamat sesuai KTP</label><textarea class="textarea" name="ktp_address"><%= staff?.ktp_address||'' %></textarea></div><div class="field full"><label>Alamat Domisili</label><textarea class="textarea" name="domicile_address"><%= staff?.domicile_address||'' %></textarea></div><% if(staff){ %><div class="field"><label>Tanggal Keluar</label><input type="date" class="input" name="tanggal_keluar" value="<%= staff.tanggal_keluar?new Date(staff.tanggal_keluar).toISOString().slice(0,10):'' %>"></div><div class="field"><label>Alasan/Keterangan Keluar</label><input class="input" name="alasan_keluar" value="<%= staff.alasan_keluar||'' %>"></div><% } %></div></div><div class="card" style="margin-top:16px"><h2>🎓 Pendidikan</h2><div class="form-grid"><% eduLevels.forEach(l=>{let e=edu[l]||{};%><div class="field"><label><%= l %></label><input class="input" name="edu_<%= l %>" value="<%= e.institution||'' %>" placeholder="Nama sekolah/perguruan tinggi"><div class="help">Jurusan: <input class="input" name="major_<%= l %>" value="<%= e.major||'' %>" style="margin-top:4px"> Tahun lulus: <input class="input" name="year_<%= l %>" value="<%= e.graduation_year||'' %>" style="margin-top:4px"></div></div><% }) %></div></div><button class="btn" style="margin-top:16px">💾 Simpan Data Staf</button> <a class="btn gray" href="/staff">Batal</a></form><%- include('../partials/footer') %>
