<%- include('../partials/header') %><section class="panel form-panel"><div class="panel-head"><div><span class="panel-kicker">AKSES CEPAT</span><h2><%= row?'Edit Link':'Tambah Link / Tautan' %></h2></div><a class="outline-btn" href="/quick-links">Kembali</a></div><form method="post" action="<%= row?'/quick-links/'+row.id:'/quick-links' %>"><% if(row){ %><input type="hidden" name="_method" value="PUT"><% } %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-grid"><div class="field"><label>Nama Link *</label><input class="input" required name="title" value="<%= row?.title||'' %>"></div><div class="field"><label>URL / Tautan *</label><input class="input" type="url" required name="url" value="<%= row?.url||'' %>"></div><div class="field"><label>Icon</label><input class="input" name="icon" value="<%= row?.icon||'external-link' %>"></div><div class="field"><label>Urutan</label><input class="input" type="number" name="sort_order" value="<%= row?.sort_order||0 %>"></div><div class="field full"><label>Deskripsi</label><textarea class="textarea" name="description"><%= row?.description||'' %></textarea></div></div><button class="primary-btn"><i data-lucide="save"></i>Simpan</button></form></section><%- include('../partials/footer') %>
