</main>

<!-- Payload Data PM Active & Client Script (Inline Self-Contained) -->
<script id="posyanduPmDataPayload" type="application/json">
<%- JSON.stringify({
  kpmId: access.kpm_id || access.id,
  kpmType: access.kpm_type || access.type || 'POSYANDU',
  activePm: activePmList.map(p => ({
    id: p.id,
    full_name: p.full_name || '',
    nik: p.nik || '',
    gender: p.gender || 'P',
    category: p.category || (isPosyandu ? 'BALITA' : 'PESERTA_DIDIK'),
    class_group: p.class_group || '',
    birth_date: p.birth_date ? String(p.birth_date).slice(0, 10) : ''
  }))
}) %>
</script>
<script>
(function() {
  'use strict';

  var KPM_ID = 0;
  var KPM_TYPE = '<%= isPosyandu ? "POSYANDU" : "SATUAN_PENDIDIKAN" %>';
  var STORAGE_KEY = 'SPPG_PM_PACKAGE_DRAFT_' + (<%= access.kpm_id || access.id %>);
  var ACTIVE_PM_MAP = {};
  var packageDraft = [];
  var memStore = {};

  function safeGet(key) {
    try { return (typeof localStorage !== 'undefined' && localStorage) ? localStorage.getItem(key) : (memStore[key] || null); }
    catch(e) { return memStore[key] || null; }
  }
  function safeSet(key, val) {
    try { if (typeof localStorage !== 'undefined' && localStorage) localStorage.setItem(key, val); }
    catch(e) {}
    memStore[key] = val;
  }
  function safeRemove(key) {
    try { if (typeof localStorage !== 'undefined' && localStorage) localStorage.removeItem(key); }
    catch(e) {}
    delete memStore[key];
  }

  function escapeHtml(str) {
    if (!str) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  // 1. Relokasi Seluruh Modal ke document.body agar tidak terhalang container
  function relocateModalsToBody() {
    var modals = document.querySelectorAll('.pm-modal-backdrop');
    modals.forEach(function(m) {
      if (m.parentNode !== document.body) {
        document.body.appendChild(m);
      }
    });
  }

  // 2. Inisialisasi Data Payload
  function initDataPayload() {
    try {
      var payloadEl = document.getElementById('posyanduPmDataPayload');
      if (payloadEl && payloadEl.textContent) {
        var parsed = JSON.parse(payloadEl.textContent);
        if (parsed.kpmId) {
          KPM_ID = parsed.kpmId;
          STORAGE_KEY = 'SPPG_PM_PACKAGE_DRAFT_' + KPM_ID;
        }
        if (parsed.kpmType) {
          KPM_TYPE = parsed.kpmType;
        }
        if (Array.isArray(parsed.activePm)) {
          parsed.activePm.forEach(function(p) {
            if (p && p.id) {
              ACTIVE_PM_MAP[p.id] = {
                id: p.id,
                full_name: p.full_name || '',
                nik: p.nik || '',
                gender: p.gender || 'P',
                category: p.category || (KPM_TYPE === 'POSYANDU' ? 'BALITA' : 'PESERTA_DIDIK'),
                class_group: p.class_group || '',
                birth_date: p.birth_date ? String(p.birth_date).slice(0, 10) : ''
              };
            }
          });
        }
      }
    } catch (e) {
      console.warn('[Workspace] Gagal membaca data payload PM:', e);
    }
  }

  // 3. Modal Management
  function openModal(id) {
    var el = document.getElementById(id);
    if (!el) return;
    if (el.parentNode !== document.body) {
      document.body.appendChild(el);
    }
    el.style.display = 'flex';
    el.classList.add('active');
    try { document.body.style.overflow = 'hidden'; } catch (e) {}
  }

  function closeModal(id) {
    var el = document.getElementById(id);
    if (el) {
      el.style.display = 'none';
      el.classList.remove('active');
    }
    var openModals = document.querySelectorAll('.pm-modal-backdrop.active, .pm-modal-backdrop[style*="display: flex"]');
    if (!openModals.length) {
      try { document.body.style.overflow = ''; } catch (e) {}
    }
  }

  // 4. Tab Switcher Lembar Kerja vs Riwayat
  function switchPackageTab(tabId) {
    var btnPaket = document.getElementById('tabBtnPaket');
    var btnRiwayat = document.getElementById('tabBtnRiwayat');
    var contentPaket = document.getElementById('tabContentPaket');
    var contentRiwayat = document.getElementById('tabContentRiwayat');

    if (tabId === 'tab-paket') {
      if (btnPaket) btnPaket.classList.add('active');
      if (btnRiwayat) btnRiwayat.classList.remove('active');
      if (contentPaket) contentPaket.classList.add('active');
      if (contentRiwayat) contentRiwayat.classList.remove('active');
    } else {
      if (btnRiwayat) btnRiwayat.classList.add('active');
      if (btnPaket) btnPaket.classList.remove('active');
      if (contentRiwayat) contentRiwayat.classList.add('active');
      if (contentPaket) contentPaket.classList.remove('active');
    }
  }

  // 5. Draft Storage & Perhitungan Proyeksi
  function loadDraft() {
    try {
      var stored = safeGet(STORAGE_KEY);
      if (stored) {
        packageDraft = JSON.parse(stored) || [];
      }
    } catch (e) {
      packageDraft = [];
    }
    renderDraftTable();
    updateMetrics();
  }

  function saveDraft() {
    try {
      safeSet(STORAGE_KEY, JSON.stringify(packageDraft));
    } catch (e) {}
    renderDraftTable();
    updateMetrics();
  }

  function updateMetrics() {
    var draftCount = packageDraft.length;
    var elDraftCount = document.getElementById('metricDraftCount');
    var elDraftDetail = document.getElementById('metricDraftDetail');
    var elTabDraftBadge = document.getElementById('tabDraftBadge');
    var elPill = document.getElementById('draftStatusPill');

    if (elDraftCount) elDraftCount.textContent = draftCount;
    if (elDraftDetail) elDraftDetail.textContent = draftCount + ' item perubahan';
    if (elTabDraftBadge) elTabDraftBadge.textContent = draftCount;

    if (elPill) {
      if (draftCount > 0) {
        elPill.textContent = draftCount + ' Item Siap Diajukan';
        elPill.className = 'pm-draft-status-pill has-items';
      } else {
        elPill.textContent = 'Draft (0 Item)';
        elPill.className = 'pm-draft-status-pill';
      }
    }

    // Mini Counters
    var newCount = packageDraft.filter(function(x) { return x.action_type === 'PM_BARU'; }).length;
    var exitCount = packageDraft.filter(function(x) { return x.action_type === 'PM_KELUAR'; }).length;
    var corrCount = packageDraft.filter(function(x) { return x.action_type === 'KOREKSI'; }).length;
    var catCount = packageDraft.filter(function(x) { return x.action_type === 'PERUBAHAN_KATEGORI'; }).length;

    var elNew = document.getElementById('counterNewPm');
    var elExit = document.getElementById('counterExitPm');
    var elCorr = document.getElementById('counterCorrectionPm');
    var elCat = document.getElementById('counterCategoryPm');

    if (elNew) elNew.textContent = newCount;
    if (elExit) elExit.textContent = exitCount;
    if (elCorr) elCorr.textContent = corrCount;
    if (elCat) elCat.textContent = catCount;

    // Perhitungan Porsi MBG
    var smallDelta = 0;
    var largeDelta = 0;

    packageDraft.forEach(function(item) {
      var isPos = KPM_TYPE === 'POSYANDU';
      if (isPos) {
        if (item.action_type === 'PM_BARU') {
          if (item.category === 'BALITA') smallDelta += 1;
          else if (['BUMIL', 'BUSUI'].includes(item.category)) largeDelta += 1;
        } else if (item.action_type === 'PM_KELUAR') {
          if (item.category === 'BALITA') smallDelta -= 1;
          else if (['BUMIL', 'BUSUI'].includes(item.category)) largeDelta -= 1;
        } else if (item.action_type === 'PERUBAHAN_KATEGORI') {
          var fromCat = item.category;
          var toCat = item.target_category;
          if (fromCat === 'BALITA' && ['BUMIL', 'BUSUI'].includes(toCat)) {
            smallDelta -= 1;
            largeDelta += 1;
          } else if (['BUMIL', 'BUSUI'].includes(fromCat) && toCat === 'BALITA') {
            largeDelta -= 1;
            smallDelta += 1;
          }
        }
      } else {
        if (item.action_type === 'PM_BARU') {
          if (item.category === 'PESERTA_DIDIK') smallDelta += 1;
          else largeDelta += 1;
        } else if (item.action_type === 'PM_KELUAR') {
          if (item.category === 'PESERTA_DIDIK') smallDelta -= 1;
          else largeDelta += 1;
        }
      }
    });

    var elTotal = document.getElementById('impactTotalItems');
    var elSmall = document.getElementById('impactSmallPortion');
    var elLarge = document.getElementById('impactLargePortion');

    if (elTotal) elTotal.textContent = draftCount + ' Item';
    if (elSmall) {
      var sSign = smallDelta > 0 ? '+' : '';
      elSmall.textContent = sSign + smallDelta + ' Porsi';
      elSmall.style.color = smallDelta < 0 ? '#dc2626' : (smallDelta > 0 ? '#16a34a' : '#14532d');
    }
    if (elLarge) {
      var lSign = largeDelta > 0 ? '+' : '';
      elLarge.textContent = lSign + largeDelta + ' Porsi';
      elLarge.style.color = largeDelta < 0 ? '#dc2626' : (largeDelta > 0 ? '#16a34a' : '#14532d');
    }

    var emptyState = document.getElementById('pkgEmptyState');
    var tableWrap = document.getElementById('pkgItemsTableWrap');
    var submissionPanel = document.getElementById('pkgSubmissionPanel');

    if (draftCount === 0) {
      if (emptyState) emptyState.style.display = 'block';
      if (tableWrap) tableWrap.style.display = 'none';
      if (submissionPanel) submissionPanel.style.display = 'none';
    } else {
      if (emptyState) emptyState.style.display = 'none';
      if (tableWrap) tableWrap.style.display = 'block';
      if (submissionPanel) submissionPanel.style.display = 'block';
    }
  }

  function renderDraftTable() {
    var tbody = document.getElementById('pkgItemsTableBody');
    if (!tbody) return;

    if (!packageDraft.length) {
      tbody.innerHTML = '';
      return;
    }

    var html = '';
    packageDraft.forEach(function(item, idx) {
      var badgeHtml = '';
      var descHtml = '';

      if (item.action_type === 'PM_BARU') {
        badgeHtml = '<span class="pm-mut-badge pm-baru">👶 PM Baru</span>';
        descHtml = '<strong style="color:#1d4ed8">Pendaftaran Baru</strong><br><small style="color:#64748b">' + escapeHtml(item.reason || '-') + '</small>';
      } else if (item.action_type === 'PM_KELUAR') {
        badgeHtml = '<span class="pm-mut-badge pm-keluar">🚪 PM Keluar</span>';
        descHtml = '<strong style="color:#be123c">Pengeluaran PM</strong><br><small style="color:#64748b">' + escapeHtml(item.reason || '-') + '</small>';
      } else if (item.action_type === 'KOREKSI') {
        badgeHtml = '<span class="pm-mut-badge koreksi">✏️ Koreksi</span>';
        descHtml = '<strong style="color:#6d28d9">Perbaikan Identitas</strong><br><small style="color:#64748b">' + escapeHtml(item.reason || '-') + '</small>';
      } else if (item.action_type === 'PERUBAHAN_KATEGORI') {
        badgeHtml = '<span class="pm-mut-badge perubahan-kategori">🔄 Alih Kategori</span>';
        descHtml = '<strong style="color:#047857">' + escapeHtml(item.category) + ' → ' + escapeHtml(item.target_category) + '</strong><br><small style="color:#64748b">' + escapeHtml(item.target_class_group || '-') + ' (' + escapeHtml(item.reason || '-') + ')</small>';
      }

      html += '<tr>' +
        '<td style="text-align:center;color:#64748b;font-weight:700">' + (idx + 1) + '</td>' +
        '<td>' + badgeHtml + '</td>' +
        '<td>' +
          '<strong style="color:#0f243d;display:block">' + escapeHtml(item.full_name) + '</strong>' +
          '<small style="color:#64748b;font-family:monospace">' + (item.nik ? ('NIK: ' + escapeHtml(item.nik)) : '-') + ' · ' + (item.gender === 'L' ? 'Laki-laki' : 'Perempuan') + '</small>' +
        '</td>' +
        '<td>' +
          '<span class="pm-cat-pill">' + escapeHtml(item.category) + '</span>' +
          '<small style="display:block;color:#64748b;margin-top:2px">' + escapeHtml(item.class_group || '-') + '</small>' +
        '</td>' +
        '<td>' + descHtml + '</td>' +
        '<td style="text-align:center">' +
          '<button type="button" class="btn gray small" onclick="window.removeDraftItem(' + idx + ')" style="padding:4px 9px;border-radius:6px;border:1px solid #fecaca;background:#fef2f2;color:#b91c1c;font-size:11px;font-weight:700;cursor:pointer">✕ Hapus</button>' +
        '</td>' +
      '</tr>';
    });

    tbody.innerHTML = html;
  }

