<%- include('../partials/header') %>
<section class="module-hero panel"><div><span class="panel-kicker">SISTEM · AKSES</span><h2>Tambah Pengguna</h2><p>Buat akun internal. Password minimal 12 karakter.</p></div><a class="outline-btn" href="/roles">Kembali</a></section>
<form method="post" action="/roles/user" class="card role-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-grid"><div class="field"><label>Nama Lengkap *</label><input class="input" name="name" required></div><div class="field"><label>Username *</label><input class="input" name="username" required autocomplete="username"></div><div class="field"><label>Email</label><input class="input" type="email" name="email" autocomplete="email"></div><div class="field"><label>Role *</label><select class="select" name="role" required><% roles.forEach(r=>{ %><option value="<%= r %>"><%= r %></option><% }) %></select></div><div class="field full"><label>Password *</label><input class="input" type="password" name="password" minlength="12" required autocomplete="new-password"><div class="help">Minimal 12 karakter. Gunakan password unik untuk setiap akun.</div></div></div><button class="btn">Simpan Pengguna</button> <a class="btn gray" href="/roles">Batal</a></form>
<%- include('../partials/footer') %>
