<%- include('../partials/header') %>
<section class="panel form-panel"><div class="panel-head"><div><span class="panel-kicker">KLOTER DISTRIBUSI</span><h2>Tambah Kloter <%= nextCluster %></h2><p class="muted"><%= schedule.distribution_date %> · Atur kendaraan, kurir, jalur, keberangkatan, dan KPM.</p></div><a class="outline-btn" href="/distribution?date=<%= schedule.distribution_date %>">Kembali</a></div><form method="post" action="/distribution/cluster"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="schedule_id" value="<%= schedule.id %>"><div class="form-grid"><div class="field"><label>Nomor Kloter *</label><input class="input" type="number" min="1" name="cluster_no" value="<%= nextCluster %>" required></div><div class="field"><label>Jenis KPM *</label><select class="select" name="kpm_type"><option value="SATUAN_PENDIDIKAN">Satuan Pendidikan</option><option value="POSYANDU">Posyandu</option></select></div><div class="field"><label>Jalur</label><input class="input" name="route_name" placeholder="Contoh: Jalur 1"></div><div class="field"><label>Kurir Distribusi</label><select class="select" name="staff_id"><option value="">— Pilih Kurir —</option><% staff.forEach(s=>{ %><option value="<%= s.id %>"><%= s.name %></option><% }) %></select></div><div class="field"><label>Kendaraan *</label><select class="select" name="vehicle" required><option value="E 8684 RD">E 8684 RD</option><option value="E 8871 RD">E 8871 RD</option></select></div><div class="field"><label>Keberangkatan</label><input class="input" type="time" name="departure_time"></div><div class="field"><label>Kembali ke SPPG</label><input class="input" type="time" name="return_time"></div></div><div class="dist-kpm-section"><div class="dist-kpm-head"><div><span class="dist-kpm-kicker">PENERIMA MANFAAT</span><h3>Pilih KPM untuk Kloter Ini</h3><p>Pilih KPM yang benar-benar masuk ke kloter. Porsi kecil dan besar otomatis mengikuti Master KPM yang berlaku pada tanggal distribusi.</p></div><div class="dist-kpm-summary"><b id="selectedCount">0</b><span>KPM terpilih</span><em><span id="selectedSmall">0</span> kecil · <span id="selectedLarge">0</span> besar</em></div></div><div class="dist-kpm-tools"><div class="dist-kpm-search"><i data-lucide="search"></i><input id="kpmSearch" type="search" placeholder="Cari kode atau nama KPM..."></div><span id="visibleKpmCount"></span></div><div class="dist-kpm-grid"><% kpms.forEach(k=>{ %><div class="dist-kpm-card" data-kpm-type="<%= k.type %>" data-kpm-search="<%= (k.code+' '+k.name).toLowerCase() %>"><label class="dist-kpm-check"><input type="checkbox" name="kpm_ids" value="<%= k.id %>" data-small="<%= k.small_portions %>" data-large="<%= k.large_portions %>"><span class="dist-checkmark"></span><span class="dist-kpm-main"><strong><%= k.name %></strong><small><%= k.code %> · <%= k.type==='POSYANDU'?'Posyandu':'Satuan Pendidikan' %></small></span></label><div class="dist-kpm-portions"><span><b><%= k.small_portions %></b><small>Porsi Kecil</small></span><span><b><%= k.large_portions %></b><small>Porsi Besar</small></span><span><b><%= Number(k.small_portions)+Number(k.large_portions) %></b><small>Total PM</small></span></div><div class="dist-kpm-times"><label>Serah Terima<input class="input dist-time-input" type="time" name="handover[<%= k.id %>]"></label><label>Pengambilan<input class="input dist-time-input" type="time" name="pickup[<%= k.id %>]"></label></div></div><% }) %></div></div><div class="field"><label>Catatan</label><textarea class="textarea" name="notes"></textarea></div><button class="primary-btn"><i data-lucide="save"></i>Simpan Kloter</button></form></section><script>document.addEventListener('DOMContentLoaded',()=>{const boxes=[...document.querySelectorAll('input[name="kpm_ids"]')],cards=[...document.querySelectorAll('.dist-kpm-card')],type=document.querySelector('select[name="kpm_type"]'),search=document.getElementById('kpmSearch'),count=document.getElementById('selectedCount'),small=document.getElementById('selectedSmall'),large=document.getElementById('selectedLarge'),visible=document.getElementById('visibleKpmCount');function refresh(){let q=(search.value||'').toLowerCase().trim(),vis=0,s=0,l=0,n=0;cards.forEach(card=>{const okType=card.dataset.kpmType===type.value,okSearch=!q||card.dataset.kpmSearch.includes(q),show=okType&&okSearch;card.style.display=show?'':'none';if(show)vis++;const box=card.querySelector('input[name="kpm_ids"]');if(!okType)box.checked=false;if(box.checked){n++;s+=Number(box.dataset.small||0);l+=Number(box.dataset.large||0)}});count.textContent=n;small.textContent=s;large.textContent=l;visible.textContent=vis+' KPM tersedia'}boxes.forEach(x=>x.addEventListener('change',refresh));type.addEventListener('change',refresh);search.addEventListener('input',refresh);refresh()});</script><%- include('../partials/footer') %>
