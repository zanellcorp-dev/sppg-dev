/* Timeline & Governance in History Modal */
.pm-history-profile-card{padding:14px 16px;border-radius:12px;background:#f8fafc;border:1px solid #e2e8f0;margin-bottom:12px}
.pm-hist-name{font-size:15px;color:#0f243d;display:block}
