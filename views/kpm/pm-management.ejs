.pm-timeline::before{content:"";position:absolute;left:8px;top:6px;bottom:6px;width:2px;background:#e2e8f0}
.pm-timeline-item{position:relative}
.pm-timeline-dot{position:absolute;left:-26px;top:4px;width:18px;height:18px;border-radius:50%;background:#fff;border:3px solid #94a3b8;display:flex;align-items:center;justify-content:center}
.pm-timeline-dot.create{border-color:#10b981;background:#ecfdf5}
.pm-timeline-dot.update{border-color:#3b82f6;background:#eff6ff}
.pm-timeline-dot.deactivate{border-color:#ef4444;background:#fef2f2}
.pm-timeline-dot.reactivate{border-color:#10b981;background:#ecfdf5}
.pm-timeline-card{background:#fff;border:1px solid #e2e8f0;border-radius:11px;padding:12px 14px;box-shadow:0 2px 8px rgba(0,0,0,.03)}
.pm-timeline-header{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:4px}
.pm-timeline-action{font-size:11.5px;font-weight:800;text-transform:uppercase;letter-spacing:.04em}
.pm-timeline-action.create{color:#059669}
.pm-timeline-action.update{color:#2563eb}
.pm-timeline-action.deactivate{color:#dc2626}
.pm-timeline-action.reactivate{color:#059669}
.pm-timeline-date{font-size:11px;color:#64748b}
.pm-timeline-desc{font-size:12.5px;color:#334155;line-height:1.45;margin:0}
.pm-timeline-actor{font-size:11px;color:#94a3b8;margin-top:5px;display:block}

/* Quick BGN Action Panel inside Modal */
.pm-history-bgn-actions{display:flex;align-items:center;gap:8px;margin-right:auto}

/* Loading & Empty */
.pm-loading-state{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:32px;gap:10px;color:#64748b;font-size:13px}
.pm-spinner{width:26px;height:26px;border:3px solid #e2e8f0;border-top-color:#007a5e;border-radius:50%;animation:pmSpin .65s linear infinite}
.pm-empty-timeline{text-align:center;padding:28px 16px;background:#f8fafc;border-radius:12px;border:1px dashed #cbd5e1}

/* Animations */
@keyframes pmFadeIn{from{opacity:0}to{opacity:1}}
@keyframes pmSlideUp{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
@keyframes pmSpin{to{transform:rotate(360deg)}}

/* Responsive */
@media(max-width:768px){
  .pm-toolbar{flex-direction:column;align-items:stretch}
  .pm-search-wrap{max-width:100%}
  .pm-cat-tabs{overflow-x:auto;padding-bottom:6px}
  .pm-action-group{flex-direction:column;gap:4px}
}
</style>

<!-- ============================================================== -->
<!-- JAVASCRIPT LOGIC PM MANAGEMENT -->
<!-- ============================================================== -->
<script>
(function(){
  var isPreview = <%= previewMode ? 'true' : 'false' %>;
  var kpmId = <%= access.kpm_id %>;
  var token = "<%= portalToken || '' %>";
  var isPosyandu = <%= isPosyandu ? 'true' : 'false' %>;

  // 1. Filter Kategori, Sub-Kelompok, Status & Pencarian Instan
  var searchInput = document.getElementById('pmSearchInput');
  var catTabs = document.querySelectorAll('.pm-tab-btn');
  var statusSelect = document.getElementById('pmStatusSelect');
  var rows = document.querySelectorAll('.pm-row');
  var emptyRow = document.getElementById('pmEmptyRow');
  var clusterBar = document.getElementById('pmPosyanduClusterBar');
  var clusterTitle = document.getElementById('pmClusterCategoryTitle');
  var clusterMetrics = document.getElementById('pmClusterMetrics');
  var clusterSubNav = document.getElementById('pmClusterSubNav');
  var groupHeaderCol = document.getElementById('pmGroupHeaderCol');

  // Read URL params if exists (e.g. ?cat=BALITA or #pm-management-section)
  var urlParams = new URLSearchParams(window.location.search);
  var initialCat = urlParams.get('cat') ? urlParams.get('cat').toUpperCase() : 'ALL';

  var currentCat = initialCat;
  var currentSubCat = 'ALL';
  var currentStatus = 'ACTIVE'; // default aktif saja agar rapi
  var currentQuery = '';

  var posyanduClusters = {
    BALITA: {
      title: 'Kelompok Balita · 100% Standar Porsi Kecil',
      headerLabel: 'Tahapan Usia Balita',
      subgroups: [
        { key: 'ALL', label: 'Semua Balita' },
        { key: '0-5', label: '0–5 Bulan (Bayi)' },
        { key: '6-23', label: '6–23 Bulan (Baduta)' },
        { key: '24-59', label: '24–59 Bulan (Balita)' }
      ]
    },
    BUMIL: {
      title: 'Kelompok Ibu Hamil (Bumil) · 100% Standar Porsi Besar',
      headerLabel: 'Usia Kehamilan / Trimester',
      subgroups: [
        { key: 'ALL', label: 'Semua Bumil' },
        { key: 'trimester 1', label: 'Trimester 1 (1–12 Minggu)' },
        { key: 'trimester 2', label: 'Trimester 2 (13–27 Minggu)' },
        { key: 'trimester 3', label: 'Trimester 3 (28–40 Minggu)' }
      ]
    },
    BUSUI: {
      title: 'Kelompok Ibu Menyusui (Busui) · 100% Standar Porsi Besar',
      headerLabel: 'Usia Bayi yang Disusui',
      subgroups: [
        { key: 'ALL', label: 'Semua Busui' },
        { key: '0–6', label: 'Bayi 0–6 Bulan (ASI Eksklusif)' },
        { key: '7–12', label: 'Bayi 7–12 Bulan' },
        { key: '13–24', label: 'Bayi 13–24 Bulan' }
      ]
    }
  };

  function updateClusterBar(){
    if(!isPosyandu || !clusterBar) return;

    if(currentCat === 'ALL'){
      if(clusterTitle) clusterTitle.textContent = 'Seluruh Penerima Manfaat Posyandu Terpadu';
      if(groupHeaderCol) groupHeaderCol.textContent = 'Sub-Kelompok';

      var bCount = 0, bumilCount = 0, busuiCount = 0;
      rows.forEach(function(r){
        var c = r.getAttribute('data-cat');
        var act = r.getAttribute('data-status') === 'ACTIVE';
        if(currentStatus === 'ACTIVE' && !act) return;
        if(c === 'BALITA') bCount++;
        else if(c === 'BUMIL') bumilCount++;
        else if(c === 'BUSUI') busuiCount++;
      });

      if(clusterMetrics){
        clusterMetrics.innerHTML = 
          '<span class="pm-cluster-badge" style="background:#f1f5f9;color:#334155;border-color:#cbd5e1;font-weight:700">Total: ' + (bCount + bumilCount + busuiCount) + ' PM</span>' +
          '<span class="pm-cluster-badge" style="background:#ecfdf5;color:#065f46;border-color:#a7f3d0;font-weight:700">Porsi Kecil: ' + bCount + '</span>' +
          '<span class="pm-cluster-badge amber" style="font-weight:700">Porsi Besar: ' + (bumilCount + busuiCount) + '</span>';
      }

      if(clusterSubNav){
        clusterSubNav.innerHTML = '';
        clusterSubNav.style.display = 'none';
      }
      return;
    }

    var cfg = posyanduClusters[currentCat];
    if(!cfg) return;

    if(clusterTitle) clusterTitle.textContent = cfg.title;
    if(groupHeaderCol) groupHeaderCol.textContent = 'Sub-Kelompok';
    if(clusterSubNav) clusterSubNav.style.display = 'flex';

    var lCount = 0, pCount = 0, totalInCat = 0;
    var subCounts = {};
    cfg.subgroups.forEach(function(sg){ subCounts[sg.key] = 0; });

    rows.forEach(function(r){
      var rCat = r.getAttribute('data-cat') || '';
      if(rCat !== currentCat) return;
      var act = r.getAttribute('data-status') === 'ACTIVE';
      if(currentStatus === 'ACTIVE' && !act) return;
      totalInCat++;
      var g = r.getAttribute('data-gender');
      if(g === 'L') lCount++;
      else if(g === 'P') pCount++;
      var sc = (r.getAttribute('data-subcat') || '').toLowerCase();
      cfg.subgroups.forEach(function(sg){
        if(sg.key === 'ALL') subCounts['ALL']++;
        else if(sc.indexOf(sg.key.toLowerCase()) !== -1) subCounts[sg.key]++;
      });
    });

    if(clusterMetrics){
      if(currentCat === 'BALITA'){
        clusterMetrics.innerHTML = 
          '<span class="pm-cluster-badge">Porsi Kecil: ' + totalInCat + '</span>' +
          '<span class="pm-cluster-badge blue">Laki-laki (L): ' + lCount + '</span>' +
          '<span class="pm-cluster-badge amber">Perempuan (P): ' + pCount + '</span>';
      } else {
        clusterMetrics.innerHTML = 
          '<span class="pm-cluster-badge">Porsi Besar: ' + totalInCat + '</span>' +
          '<span class="pm-cluster-badge amber">Perempuan (P): ' + pCount + '</span>';
      }
    }

    if(clusterSubNav){
      var navHtml = '<button type="button" class="pm-subcat-btn" style="background:#f1f5f9;color:#475569" onclick="window.setPmCategory(\'ALL\')">← Kembali ke Semua</button>';
      cfg.subgroups.forEach(function(sg){
        var isAct = currentSubCat === sg.key;
        var cnt = subCounts[sg.key] !== undefined ? subCounts[sg.key] : 0;
        navHtml += '<button type="button" class="pm-subcat-btn ' + (isAct ? 'active' : '') + '" data-sub="' + sg.key + '">' +
                     '<span>' + sg.label + '</span>' +
                     '<span class="pm-subcat-count">' + cnt + '</span>' +
                   '</button>';
      });
      clusterSubNav.innerHTML = navHtml;

      clusterSubNav.querySelectorAll('.pm-subcat-btn').forEach(function(btn){
        btn.addEventListener('click', function(){
          currentSubCat = btn.getAttribute('data-sub') || 'ALL';
          clusterSubNav.querySelectorAll('.pm-subcat-btn').forEach(function(b){ b.classList.remove('active'); });
          btn.classList.add('active');
          applyFilters();
        });
      });
    }
  }

  function applyFilters(){
    var visibleCount = 0;
    rows.forEach(function(row){
      var rowCat = (row.getAttribute('data-cat') || '').toUpperCase();
      var rowSubCat = (row.getAttribute('data-subcat') || '').toLowerCase();
      var rowStatus = row.getAttribute('data-status') || '';
      var rowSearch = (row.getAttribute('data-search') || '').toLowerCase();

      var matchCat = (currentCat === 'ALL') || (rowCat === currentCat);
      var matchSubCat = true;
      if (currentCat !== 'ALL' && currentSubCat !== 'ALL') {
        matchSubCat = (rowSubCat.indexOf(currentSubCat.toLowerCase()) !== -1) ||
                      (currentSubCat === '0-5' && (rowSubCat.indexOf('0–5') !== -1 || rowSubCat.indexOf('bayi') !== -1)) ||
                      (currentSubCat === '6-23' && (rowSubCat.indexOf('6–23') !== -1 || rowSubCat.indexOf('baduta') !== -1)) ||
                      (currentSubCat === '24-59' && (rowSubCat.indexOf('24–59') !== -1 || rowSubCat.indexOf('balita') !== -1));
      }

      var matchStatus = (currentStatus === 'ALL') || 
                        (currentStatus === 'ACTIVE' && rowStatus === 'ACTIVE') || 
                        (currentStatus === 'PENDING' && rowStatus === 'PENDING') || 
                        (currentStatus === 'INACTIVE' && rowStatus === 'INACTIVE');
      var matchQuery = !currentQuery || (rowSearch.indexOf(currentQuery) !== -1);

      if(matchCat && matchSubCat && matchStatus && matchQuery){
        row.style.display = '';
        visibleCount++;
        var idxCell = row.querySelector('.pm-row-index');
        if(idxCell) idxCell.textContent = visibleCount;
      } else {
        row.style.display = 'none';
      }
    });

    if(emptyRow){
      emptyRow.style.display = visibleCount === 0 ? '' : 'none';
    }
  }

  // Handler Tab Kategori
  function setCategory(cat){
    if (window.PMGrouper) {
      window.PMGrouper.filter(cat, 'ALL');
      return;
    }
    currentCat = (cat || 'ALL').toUpperCase();
    currentSubCat = 'ALL';

    catTabs.forEach(function(t){
      var btnCat = (t.getAttribute('data-cat') || '').toUpperCase();
      if(btnCat === currentCat){
        t.classList.add('active');
      } else {
        t.classList.remove('active');
      }
    });

    updateClusterBar();
    applyFilters();
  }
  window.setPmCategory = setCategory;

  // Event listener tab kategori di toolbar
  catTabs.forEach(function(tab){
    tab.addEventListener('click', function(e){
      e.preventDefault();
      var cat = tab.getAttribute('data-cat') || 'ALL';
      setCategory(cat);
    });
  });

  // Event listener search input
  if(searchInput){
    searchInput.addEventListener('input', function(){
      currentQuery = (searchInput.value || '').toLowerCase().trim();
      applyFilters();
    });
  }

  // Event listener status filter
  if(statusSelect){
    statusSelect.addEventListener('change', function(){
      currentStatus = statusSelect.value || 'ALL';
      updateClusterBar();
      applyFilters();
    });
  }

  // Inisialisasi awal
  if(initialCat !== 'ALL'){
    setCategory(initialCat);
    var sec = document.getElementById('pm-management-section');
    if(sec){
      setTimeout(function(){
        sec.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }, 120);
    }
  } else {
    updateClusterBar();
    applyFilters();
  }

  // 2. Handler Modal Soft Delete (Hapus / Nonaktifkan)
  var deactModal = document.getElementById('pmDeactivateModal');
  var deactForm = document.getElementById('pmDeactivateForm');
  var deactTargetName = document.getElementById('deactTargetName');
  var deactTargetMeta = document.getElementById('deactTargetMeta');
  var deactModalTitle = document.getElementById('deactModalTitle');
  var deactModalSubtitle = document.getElementById('deactModalSubtitle');
  var deactSubmitBtnText = document.getElementById('deactSubmitBtnText');
  var deactReasonSelect = document.getElementById('deactReasonSelect');
  var deactCustomField = document.getElementById('deactCustomField');
  var deactCustomNote = document.getElementById('deactCustomNote');

  window.openDeactivateModal = function(id, name, nik, cat, isAdmin){
    if(deactTargetName) deactTargetName.textContent = name || '-';
    if(deactTargetMeta) deactTargetMeta.textContent = 'NIK: ' + (nik || '-') + ' · Kategori: ' + (cat || '').replace(/_/g, ' ');
    if(deactReasonSelect) deactReasonSelect.value = '';
    if(deactCustomField) deactCustomField.style.display = 'none';
    if(deactCustomNote) deactCustomNote.value = '';

    if(isAdmin){
      if(deactModalTitle) deactModalTitle.textContent = 'Nonaktifkan Penerima Manfaat (Otorisasi Kepala BGN)';
      if(deactModalSubtitle) deactModalSubtitle.textContent = 'Menonaktifkan data secara langsung dan mencatatnya ke arsip riwayat resmi.';
      if(deactSubmitBtnText) deactSubmitBtnText.textContent = 'Nonaktifkan & Simpan ke Arsip';
      deactForm.action = '/portal/kpm/preview/' + kpmId + '/pm/' + id + '/status';
    } else {
      if(deactModalTitle) deactModalTitle.textContent = 'Ajukan Penonaktifan ke Kepala BGN';
      if(deactModalSubtitle) deactModalSubtitle.textContent = 'Data akan dicatat di riwayat dan menunggu keputusan resmi Kepala / Admin BGN.';
      if(deactSubmitBtnText) deactSubmitBtnText.textContent = 'Kirim Permohonan ke Kepala BGN';
      deactForm.action = '/portal/kpm/' + token + '/pm/' + id + '/status';
    }

    if(deactModal) deactModal.style.display = 'flex';
  };

  window.closeDeactivateModal = function(){
    if(deactModal) deactModal.style.display = 'none';
  };

  if(deactReasonSelect){
    deactReasonSelect.addEventListener('change', function(){
      if(deactCustomField){
        deactCustomField.style.display = (deactReasonSelect.value === 'Lainnya') ? 'block' : 'none';
      }
    });
  }

  if(deactForm){
    deactForm.addEventListener('submit', function(e){
      if(deactReasonSelect.value === 'Lainnya' && deactCustomNote && deactCustomNote.value.trim()){
        deactReasonSelect.options[deactReasonSelect.selectedIndex].value = 'Lainnya: ' + deactCustomNote.value.trim();
      }
    });
  }

  // 3. Handler Modal Otorisasi BGN: Setujui
  var approveModal = document.getElementById('bgnApproveModal');
  var approveForm = document.getElementById('bgnApproveForm');
  var approveTargetName = document.getElementById('approveTargetName');
  var approveTargetReason = document.getElementById('approveTargetReason');

  window.openBgnApproveModal = function(id, name, reason){
    if(approveTargetName) approveTargetName.textContent = name || '-';
    if(approveTargetReason) approveTargetReason.textContent = reason ? ('Alasan dari Kader: ' + reason) : 'Alasan dari Kader: Tidak dicantumkan';
    if(approveForm) approveForm.action = '/portal/kpm/preview/' + kpmId + '/pm/' + id + '/status';
    if(approveModal) approveModal.style.display = 'flex';
  };

  window.closeBgnApproveModal = function(){
    if(approveModal) approveModal.style.display = 'none';
  };

  // 4. Handler Modal Otorisasi BGN: Batalkan / Tolak
  var rejectModal = document.getElementById('bgnRejectModal');
  var rejectForm = document.getElementById('bgnRejectForm');
  var rejectTargetName = document.getElementById('rejectTargetName');
  var rejectTargetReason = document.getElementById('rejectTargetReason');

  window.openBgnRejectModal = function(id, name, reason){
    if(rejectTargetName) rejectTargetName.textContent = name || '-';
    if(rejectTargetReason) rejectTargetReason.textContent = reason ? ('Alasan pengajuan sebelumnya: ' + reason) : 'Alasan sebelumnya: Tidak dicantumkan';
    if(rejectForm) rejectForm.action = '/portal/kpm/preview/' + kpmId + '/pm/' + id + '/status';
    if(rejectModal) rejectModal.style.display = 'flex';
  };

  window.closeBgnRejectModal = function(){
    if(rejectModal) rejectModal.style.display = 'none';
  };

  // 5. Handler Modal Reactivate / Pulihkan Data
  var reactModal = document.getElementById('pmReactivateModal');
  var reactForm = document.getElementById('pmReactivateForm');
  var reactTargetName = document.getElementById('reactTargetName');
  var reactTargetMeta = document.getElementById('reactTargetMeta');
  var reactTargetPrevReason = document.getElementById('reactTargetPrevReason');

  window.openReactivateModal = function(id, name, nik, prevReason){
    if(reactTargetName) reactTargetName.textContent = name || '-';
    if(reactTargetMeta) reactTargetMeta.textContent = 'NIK: ' + (nik || '-');
    if(reactTargetPrevReason){
      reactTargetPrevReason.textContent = prevReason ? ('Alasan nonaktif: ' + prevReason) : 'Alasan nonaktif sebelumnya: Tidak tercatat';
    }

    if(reactForm) reactForm.action = '/portal/kpm/preview/' + kpmId + '/pm/' + id + '/status';
    if(reactModal) reactModal.style.display = 'flex';
  };

  window.closeReactivateModal = function(){
    if(reactModal) reactModal.style.display = 'none';
  };

  // 6. Handler Modal History Rekam Jejak
  var histModal = document.getElementById('pmHistoryModal');
  var histProfileName = document.getElementById('histProfileName');
  var histProfileNik = document.getElementById('histProfileNik');
  var histProfileCat = document.getElementById('histProfileCat');
  var histProfileStatus = document.getElementById('histProfileStatus');
  var histLoading = document.getElementById('pmHistoryLoading');
  var histTimeline = document.getElementById('pmHistoryTimeline');
  var histEmpty = document.getElementById('pmHistoryEmpty');
  var histFoot = document.getElementById('pmHistoryModalFoot');

  window.openHistoryModal = function(id, name, nik, cat, isAct, approvalStatus){
    if(histProfileName) histProfileName.textContent = name || '-';
    if(histProfileNik) histProfileNik.textContent = 'NIK: ' + (nik || '-');
    if(histProfileCat) histProfileCat.textContent = (cat || '').replace(/_/g, ' ');
    if(histProfileStatus){
      if(approvalStatus === 'MENUNGGU_VERIFIKASI_BGN'){
        histProfileStatus.className = 'pm-badge-pending';
        histProfileStatus.innerHTML = '<span class="pm-dot-amber"></span> Menunggu Otorisasi BGN';
      } else if(isAct){
        histProfileStatus.className = 'pm-badge-active';
        histProfileStatus.innerHTML = '<span class="pm-dot-green"></span> Aktif';
      } else {
        histProfileStatus.className = 'pm-badge-inactive';
        histProfileStatus.innerHTML = '<span class="pm-dot-gray"></span> Nonaktif (Arsip)';
      }
    }

    if(histTimeline) { histTimeline.innerHTML = ''; histTimeline.style.display = 'none'; }
    if(histEmpty) histEmpty.style.display = 'none';
    if(histLoading) histLoading.style.display = 'flex';
    if(histModal) histModal.style.display = 'flex';

    // Bersihkan foot actions
    if(histFoot){
      histFoot.innerHTML = '<button type="button" class="pm-modal-btn primary" onclick="closeHistoryModal()">Tutup</button>';
    }

    // Endpoint terisolasi untuk KPM ini
    var historyUrl = isPreview ? 
      ('/portal/kpm/preview/' + kpmId + '/pm/' + id + '/history') : 
      ('/portal/kpm/' + token + '/pm/' + id + '/history');

    fetch(historyUrl)
      .then(function(res){
        if(!res.ok) throw new Error('Data tidak ditemukan pada ruang privat KPM ini.');
        return res.json();
      })
      .then(function(data){
        if(histLoading) histLoading.style.display = 'none';
        var historyList = (data && data.history) ? data.history : [];
        var pmData = data.pm || {};
        var isBgnAdmin = !!data.isBgnAdmin;

        var items = [];

        // 1. Rekam jejak pendaftaran awal
        if(pmData.created_at){
          items.push({
            action: 'CREATE',
            date: new Date(pmData.created_at).toLocaleString('id-ID', { dateStyle:'medium', timeStyle:'short' }),
            title: 'Pendaftaran Pertama (Master PM)',
            desc: 'Penerima manfaat terdaftar pertama kali di ruang privat KPM ' + (pmData.kpm_name || '') + '.',
            actor: 'Sistem Master PM'
          });
        }

        // 2. Rekam jejak dari pm_change_history
        historyList.forEach(function(h){
          var actType = h.action || 'UPDATE';
          var actTitle = actType === 'CREATE' ? 'Pendaftaran Pertama' :
                         actType === 'DEACTIVATE' ? 'Penonaktifan / Pengajuan Hapus' :
                         actType === 'REACTIVATE' ? 'Pengaktifan Kembali / Pemulihan Data' : 'Pembaruan Data Identitas';
          var descText = h.reason ? h.reason : 'Perubahan data berhasil diverifikasi dan diterapkan ke Master PM.';
          
          items.push({
            action: actType,
            date: new Date(h.created_at || h.effective_from).toLocaleString('id-ID', { dateStyle:'medium', timeStyle:'short' }),
            title: actTitle,
            desc: descText,
            actor: h.actor_name ? ('Oleh: ' + h.actor_name) : 'Oleh: Kader KPM'
          });
        });

        // 3. Tambahan status saat ini jika menunggu verifikasi
        if(pmData.approval_status === 'MENUNGGU_VERIFIKASI_BGN' && !items.some(function(x){ return x.desc && x.desc.indexOf('Menunggu Otorisasi') !== -1; })){
          items.push({
            action: 'DEACTIVATE',
            date: pmData.deactivated_at ? new Date(pmData.deactivated_at).toLocaleString('id-ID', { dateStyle:'medium', timeStyle:'short' }) : 'Tercatat',
            title: 'Permohonan Nonaktif dari Kader',
            desc: 'Alasan: ' + (pmData.deactivation_reason || 'Diajukan') + ' · Menunggu Otorisasi Kepala BGN',
            actor: 'Oleh: Kader KPM'
          });
        }

        if(!items.length){
          if(histEmpty) histEmpty.style.display = 'block';
        } else {
          var html = '';
          items.forEach(function(it){
            var cls = (it.action || 'update').toLowerCase();
            html += '<div class="pm-timeline-item">' +
                      '<div class="pm-timeline-dot ' + cls + '"></div>' +
                      '<div class="pm-timeline-card">' +
                        '<div class="pm-timeline-header">' +
                          '<span class="pm-timeline-action ' + cls + '">' + it.title + '</span>' +
                          '<span class="pm-timeline-date">' + it.date + '</span>' +
                        '</div>' +
                        '<p class="pm-timeline-desc">' + it.desc + '</p>' +
                        (it.actor ? '<span class="pm-timeline-actor">' + it.actor + '</span>' : '') +
                      '</div>' +
                    '</div>';
          });

          if(histTimeline){
            histTimeline.innerHTML = html;
            histTimeline.style.display = 'flex';
          }
        }

        // Quick Otorisasi Buttons di Footer Modal jika Admin/Kepala BGN
        if(isBgnAdmin && histFoot){
          var footHtml = '<div class="pm-history-bgn-actions">';
          if(pmData.approval_status === 'MENUNGGU_VERIFIKASI_BGN'){
            footHtml += '<button type="button" class="pm-modal-btn success" onclick="closeHistoryModal();openBgnApproveModal(' + pmData.id + ', \'' + (pmData.full_name || '').replace(/'/g, "\\'") + '\', \'' + (pmData.deactivation_reason || '').replace(/'/g, "\\'") + '\')">✔ Sahkan & Setujui</button>';
            footHtml += '<button type="button" class="pm-modal-btn danger" onclick="closeHistoryModal();openBgnRejectModal(' + pmData.id + ', \'' + (pmData.full_name || '').replace(/'/g, "\\'") + '\', \'' + (pmData.deactivation_reason || '').replace(/'/g, "\\'") + '\')">✖ Batalkan Permohonan</button>';
          } else if(!pmData.active){
            footHtml += '<button type="button" class="pm-modal-btn success" onclick="closeHistoryModal();openReactivateModal(' + pmData.id + ', \'' + (pmData.full_name || '').replace(/'/g, "\\'") + '\', \'' + (pmData.nik || '') + '\', \'' + (pmData.deactivation_reason || '').replace(/'/g, "\\'") + '\')">↺ Pulihkan Data ke Aktif</button>';
          }
          footHtml += '</div>';
          footHtml += '<button type="button" class="pm-modal-btn primary" onclick="closeHistoryModal()">Tutup</button>';
          histFoot.innerHTML = footHtml;
        }
      })
      .catch(function(err){
        if(histLoading) histLoading.style.display = 'none';
        if(histEmpty){
          histEmpty.innerHTML = '<strong style="color:#b91c1c">Gagal memuat histori</strong><small style="color:#64748b">' + err.message + '</small>';
          histEmpty.style.display = 'block';
        }
      });
  };

  window.closeHistoryModal = function(){
    if(histModal) histModal.style.display = 'none';
  };

  // Close modals on Esc key or click backdrop
  window.addEventListener('keydown', function(e){
    if(e.key === 'Escape'){
      closeDeactivateModal();
      closeBgnApproveModal();
      closeBgnRejectModal();
      closeReactivateModal();
      closeHistoryModal();
    }
  });

  [deactModal, approveModal, rejectModal, reactModal, histModal].forEach(function(modal){
    if(modal){
      modal.addEventListener('click', function(e){
        if(e.target === modal){
          modal.style.display = 'none';
        }
      });
    }
  });
})();
</script>
