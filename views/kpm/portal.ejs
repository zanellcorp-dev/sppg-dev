      </a>
    </div>
  </section>

  <!-- Modul Data Master Penerima Manfaat (100% UI/UX Asli & Utuh) -->
  <div id="paneMasterPm" class="posyandu-main-tab-pane active">
    <%- include('pm-management', { access, pm, previewMode, portalToken, schoolGroups, posyanduGroups, csrfToken: typeof csrfToken !== 'undefined' ? csrfToken : '' }) %>
