<%- include('partials/header') %><div class="card"><h2>🕐 Aktivitas Sistem</h2><p class="sub">Riwayat tindakan pengguna pada data utama.</p><div class="table-wrap"><table class="table"><tr><th>Waktu</th><th>Pengguna</th><th>Aksi</th><th>Data</th><th>Keterangan</th></tr><% rows.forEach(r=>{ %><tr><td><%= new Date(r.created_at).toLocaleString('id-ID') %></td><td><%= r.user_name||'-' %></td><td><%= r.action %></td><td><%= r.entity_type %> #<%= r.entity_id||'-' %></td><td><%= r.description||'-' %></td></tr><% }) %></table></div></div><%- include('partials/footer') %>
