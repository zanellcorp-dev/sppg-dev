<%- include('partials/header') %>
<div class="card"><h2>🔎 Hasil Pencarian</h2><p class="sub"><%= q ? 'Menampilkan hasil untuk: ' : 'Masukkan kata kunci pada kolom pencarian di bagian atas.' %><strong><%= q %></strong></p></div>
<% if(q){ %>
<div class="section">Staf · <%= staff.length %></div><div class="table-wrap"><table class="table"><tr><th>Nama</th><th>NIK</th><th>Jabatan</th><th>Status</th><th>Aksi</th></tr><% staff.forEach(r=>{ %><tr><td><strong><%= r.name %></strong></td><td><%= r.nik %></td><td><%= r.position %></td><td><%= r.status.replaceAll('_',' ') %></td><td><a class="btn gray" href="/staff/<%= r.id %>">Detail</a></td></tr><% }) %><% if(!staff.length){ %><tr><td colspan="5" class="empty">Tidak ada staf yang cocok.</td></tr><% } %></table></div>
<div class="section">KPM · <%= kpm.length %></div><div class="table-wrap"><table class="table"><tr><th>Kode</th><th>Nama</th><th>Jenis</th><th>Jenjang</th><th>Aksi</th></tr><% kpm.forEach(r=>{ %><tr><td><strong><%= r.code %></strong></td><td><%= r.name %></td><td><%= r.type==='POSYANDU'?'Posyandu':'Satuan Pendidikan' %></td><td><%= r.education_level||'-' %></td><td><a class="btn gray" href="/kpm/<%= r.id %>">Detail</a></td></tr><% }) %><% if(!kpm.length){ %><tr><td colspan="5" class="empty">Tidak ada KPM yang cocok.</td></tr><% } %></table></div>
<div class="section">Penerima Manfaat · <%= pm.length %></div><div class="table-wrap"><table class="table"><tr><th>Nama</th><th>NIK</th><th>NISN</th><th>Kategori</th><th>KPM</th><th>Aksi</th></tr><% pm.forEach(r=>{ %><tr><td><strong><%= r.full_name %></strong></td><td><%= r.nik||'-' %></td><td><%= r.nisn||'-' %></td><td><%= r.category.replaceAll('_',' ') %></td><td><%= r.kpm_name %></td><td><a class="btn gray" href="/kpm/<%= r.kpm_id %>">KPM</a></td></tr><% }) %><% if(!pm.length){ %><tr><td colspan="6" class="empty">Tidak ada PM yang cocok.</td></tr><% } %></table></div>
<% } %><%- include('partials/footer') %>