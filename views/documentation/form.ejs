<%- include('../partials/header') %>
<section class="panel"><div class="panel-head"><div><span class="panel-kicker">DOKUMENTASI</span><h2>Tambah Dokumentasi <%= module %></h2><p class="muted">File disimpan di persistent storage dan terikat pada tanggal operasional.</p></div></div>
<form method="post" action="/documentation/upload" enctype="multipart/form-data" class="form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="module" value="<%= module %>"><label>Tanggal<input type="date" name="documentation_date" value="<%= date %>" required></label><label>Judul<input name="title" maxlength="255" required></label><label>Deskripsi<textarea name="description" rows="4"></textarea></label><label>File<input type="file" name="file" accept="image/jpeg,image/png,application/pdf,.xlsx,.docx" required></label><div><button class="primary-btn" type="submit">Simpan Dokumentasi</button> <a class="outline-btn" href="/documentation/<%= module.toLowerCase() %>?date=<%= date %>">Batal</a></div></form></section>
<%- include('../partials/footer') %>
