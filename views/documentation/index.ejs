<%- include('../partials/header') %>
<section class="panel"><div class="panel-head"><div><span class="panel-kicker">DOKUMENTASI</span><h2><%= module %></h2><p class="muted">Dokumentasi difilter berdasarkan tanggal. Dokumentasi tersimpan per tanggal dan modul, dengan file tetap di persistent storage.</p></div><form class="filter-inline"><label>Tanggal<input type="date" name="date" value="<%= date %>"></label><button class="outline-btn">Tampilkan</button></form></div><div class="doc-date-banner"><i data-lucide="calendar-days"></i><div><small>TANGGAL DOKUMENTASI</small><strong><%= date %></strong></div></div><div class="empty-state"><i data-lucide="camera"></i><strong>Belum ada dokumentasi</strong><span>Modul <%= module %> sudah disiapkan. Alur pengisian akan mengikuti konsep operasional yang akan ditentukan.</span><div class="task-actions"><a class="primary-btn" href="/documentation/<%= module.toLowerCase() %>/upload?date=<%= date %>">Tambah Dokumentasi</a></div><% if(rows.length){ %><div class="operational-card-grid"><% rows.forEach(r=>{ %><article class="operational-task-card"><h3><%= r.title||r.original_name %></h3><p><%= r.description||'' %></p><small><%= r.created_at %></small><div class="task-actions"><a class="outline-btn" href="/documentation/file/<%= r.id %>">Buka File</a></div></article><% }) %></div><% } else { %><div class="empty-state"><strong>Belum ada dokumentasi</strong><span>Belum ada file untuk modul dan tanggal ini.</span></div><% } %></section>
<%- include('../partials/footer') %>
