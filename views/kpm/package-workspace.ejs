            <input type="date" id="corrFormBirthDate" class="pm-modal-input">
          </div>

          <div class="pm-form-field">
            <label for="corrFormReason">Alasan / Bagian yang Dikoreksi</label>
            <input type="text" id="corrFormReason" class="pm-modal-input" placeholder="Contoh: Perbaikan salah ketik NIK sesuai KTP">
          </div>
        </div>
      </div>
      <div class="pm-modal-foot">
        <button type="button" class="btn gray" onclick="closeModal('modalCorrectionPm')">Batal</button>
        <button type="button" class="btn primary" onclick="window.handleAddCorrectionSubmit()" style="background:#6d28d9;color:#fff;border:none;padding:9px 18px;border-radius:8px;font-weight:700;cursor:pointer">
          ✏️ Simpan Koreksi ke Paket
        </button>
      </div>
    </div>
  </div>

  <!-- Modal 5: Alih Kategori / Naik Kelas -->
  <div id="modalCategoryChange" class="pm-modal-backdrop" role="dialog" aria-modal="true">
    <div class="pm-modal-card">
      <div class="pm-modal-head">
        <div class="pm-modal-icon-wrap" style="background:#ecfdf5;color:#047857">🔄</div>
        <div>
          <h3 style="margin:0;font-size:16px"><%= isPosyandu ? 'Alih Status Kategori' : 'Alih Kategori / Kelas' %></h3>
          <p style="margin:3px 0 0;font-size:12.5px;color:#64748b">Pilih penerima yang status kategori atau kelompoknya berubah.</p>
        </div>
        <button type="button" class="pm-modal-close" onclick="closeModal('modalCategoryChange')">&times;</button>
      </div>
      <div class="pm-modal-body">
        <div class="pm-form-field">
          <label>Cari Nama / NIK Penerima</label>
