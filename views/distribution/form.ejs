<%- include('../partials/header') %><section class="panel form-panel"><div class="panel-head"><div><span class="panel-kicker">OPERASIONAL SPPG</span><h2>Edit Jadwal Distribusi</h2><p class="muted"><%= row.kpm_name %> · <%= row.distribution_date %></p></div><a class="outline-btn" href="/distribution?date=<%= date %>">Kembali</a></div><form method="post" action="/distribution/<%= row.id %>"><input type="hidden" name="_method" value="PUT"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-grid"><div class="field"><label>Porsi Kecil</label><input class="input" type="number" min="0" name="small_portions" value="<%= row.small_portions %>"></div><div class="field"><label>Porsi Besar</label><input class="input" type="number" min="0" name="large_portions" value="<%= row.large_portions %>"></div><div class="field"><label>Jalur</label><input class="input" name="route_name" value="<%= row.route_name||'' %>"></div><div class="field"><label>Kloter</label><input class="input" name="cluster_name" value="<%= row.cluster_name||'' %>"></div><div class="field"><label>Kendaraan</label><input class="input" name="vehicle" value="<%= row.vehicle||'' %>"></div><div class="field"><label>Supir</label><input class="input" name="driver_name" value="<%= row.driver_name||'' %>"></div><div class="field"><label>Status</label><select class="select" name="status"><% ['BELUM','BERJALAN','SELESAI','BERMASALAH'].forEach(x=>{ %><option <%= row.status===x?'selected':'' %>><%= x %></option><% }) %></select></div><div class="field full"><label>Catatan</label><textarea class="textarea" name="notes"><%= row.notes||'' %></textarea></div><% [['prep_start','Jam Persiapan'],['processing_start','Jam Pengolahan'],['portioning_time','Jam Pemorsian'],['departure_time','Jam Keberangkatan'],['handover_time','Jam Serah Terima'],['pickup_time','Jam Pengambilan'],['return_time','Jam Kembali ke SPPG'],['washing_start','Jam Pencucian Mulai'],['washing_end','Jam Pencucian Selesai']].forEach(([key,label])=>{ %><div class="field"><label><%= label %></label><input class="input" type="datetime-local" name="<%= key %>" value="<%= row[key]?new Date(row[key]).toISOString().slice(0,16):'' %>"></div><% }) %></div><button class="primary-btn"><i data-lucide="save"></i>Simpan Perubahan</button></form></section><%- include('../partials/footer') %>
