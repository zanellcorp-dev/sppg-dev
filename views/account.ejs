<%- include('partials/header') %>
<section class="module-hero panel"><div><span class="panel-kicker">AKUN</span><h2>Profil Saya</h2><p>Kelola identitas akun yang sedang digunakan untuk masuk ke SPPG Monitoring.</p></div></section>
<section class="panel account-panel"><div class="account-identity"><div class="account-avatar"><%= (account.name||'A').slice(0,1).toUpperCase() %></div><div><h3><%= account.name %></h3><p><%= account.role %> · @<%= account.username %></p><span class="online-status"><i></i> Online</span></div></div><form method="post" action="/account" class="account-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label><span>Nama</span><input class="input" name="name" value="<%= account.name||'' %>" required></label><label><span>Username</span><input class="input" value="<%= account.username||'' %>" disabled></label><label><span>Email</span><input class="input" type="email" name="email" value="<%= account.email||'' %>"></label><div class="account-actions"><button class="primary-btn" type="submit"><i data-lucide="save"></i> Simpan Profil</button></div></form></section>
<%- include('partials/footer') %>
