<%- include('../partials/header') %>
<section class="panel"><div class="panel-head"><div><span class="panel-kicker">FEEDBACK</span><h2>Feedback Operasional</h2><p class="muted">Masukan dicatat sebagai data tersendiri dan tidak mengubah histori pekerjaan.</p></div></div>
<form method="post" action="/feedback" class="form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Tanggal<input type="date" name="work_date" value="<%= new Date().toISOString().slice(0,10) %>"></label><label>Tim<select name="team" required><% operationalTeams.forEach(x=>{ %><option value="<%= x %>"><%= x %></option><% }) %></select></label><label>Kategori<select name="category"><% feedbackCategories.forEach(x=>{ %><option value="<%= x %>"><%= x %></option><% }) %></select></label><label class="full">Feedback<textarea name="description" rows="4" required placeholder="Tuliskan saran, apresiasi, atau perbaikan yang dibutuhkan."></textarea></label><div class="form-actions"><button class="primary-btn">Kirim Feedback</button></div></form></section>
<section class="panel"><div class="panel-head"><h3>Riwayat Feedback</h3></div><div class="table-wrap"><table><thead><tr><th>Tanggal</th><th>Tim</th><th>Kategori</th><th>Feedback</th><th>Oleh</th><th>Status / Tindak Lanjut</th></tr></thead><tbody><% rows.forEach(r=>{ %><tr><td><%= String(r.work_date).slice(0,10) %></td><td><%= r.team %></td><td><%= r.category %></td><td><%= r.description %></td><td><%= r.created_by_name||'—' %></td><td><span class="badge"><%= r.status||'BARU' %></span><form method="post" action="/feedback/<%= r.id %>/status" class="form-inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="status"><% ['BARU','DITINDAKLANJUTI','MENUNGGU','SELESAI','DITUTUP'].forEach(st=>{ %><option value="<%= st %>" <%= (r.status||'BARU')===st?'selected':'' %>><%= st %></option><% }) %></select><input name="followup_note" placeholder="Catatan" value="<%= r.followup_note||'' %>"><button class="mini-action">Simpan</button></form></td></tr><% }) %><% if(!rows.length){ %><tr><td colspan="6">Belum ada feedback.</td></tr><% } %></tbody></table></div></section>
<%- include('../partials/footer') %>
