<div id="modalCategoryChange" class="pm-modal-backdrop" style="display:none" role="dialog" aria-modal="true">
  <div class="pm-modal-card pm-modal-card-lg">
    <div class="pm-modal-head neutral">
      <div class="pm-modal-icon-wrap neutral">🔄</div>
      <div>
        <h3 style="margin:0;font-size:16px">Perubahan Kategori (Alih Status)</h3>
        <p style="margin:3px 0 0;font-size:12.5px;color:#64748b">Contoh: Ibu Hamil (Bumil) melahirkan beralih status menjadi Ibu Menyusui (Busui).</p>
      </div>
      <button type="button" class="pm-modal-close" onclick="closeModal('modalCategoryChange')">&times;</button>
    </div>
    <form onsubmit="handleAddCategoryChangeSubmit(event)">
      <div class="pm-modal-body">
        <div class="pm-form-field">
          <label>Cari PM yang Beralih Kategori</label>
          <input type="search" id="catChangeSearchInput" class="pm-modal-input" placeholder="Ketik nama atau NIK..." oninput="filterCatChangePmList()">
        </div>

        <div class="pm-db-picker-container" id="catChangePmPickerContainer" style="max-height:160px">
          <% activePmList.forEach(p => { %>
            <label class="pm-db-picker-row" data-id="<%= p.id %>" data-name="<%= p.full_name.toLowerCase() %>" data-nik="<%= (p.nik||'').toLowerCase() %>">
              <input type="radio" name="selected_catchange_pm_id" value="<%= p.id %>" required onchange="onCatChangeSelected(<%= JSON.stringify(p) %>)">
              <div class="pm-db-row-content">
                <strong><%= p.full_name %></strong>
                <small>NIK: <%= p.nik || '-' %> · Kategori Saat Ini: <%= p.category %></small>
              </div>
              <span class="pm-cat-pill"><%= p.category %></span>
