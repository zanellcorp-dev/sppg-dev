              <span id="detailEffectiveDate" style="font-size:12px;color:#64748b;display:block">Tanggal Berlaku: -</span>
              <span id="detailSubmitDate" style="font-size:11.5px;color:#94a3b8;display:block">Diajukan: -</span>
            </div>
          </div>
          <div id="detailReviewNoteBox" style="margin-top:8px;padding-top:8px;border-top:1px dashed #cbd5e1;font-size:12.5px">
